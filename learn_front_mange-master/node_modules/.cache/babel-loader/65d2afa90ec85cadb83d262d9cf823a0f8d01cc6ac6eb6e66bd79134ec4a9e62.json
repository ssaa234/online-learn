{"ast":null,"code":"import { saveApeTask, getApeClassificationList } from '../../../api/api';\nimport { mixin } from '../../../minix';\nexport default {\n  mixins: [mixin],\n  props: {\n    addVisible: {\n      type: Boolean,\n      default: false\n    },\n    flag: {\n      type: String,\n      default: '0'\n    }\n  },\n  data() {\n    return {\n      dialogVisible: false,\n      classificationList: [],\n      showGrade: false,\n      showTextbook: false,\n      gradeOptions: [],\n      form: {\n        name: '',\n        gradeLevel: '',\n        grade: '',\n        textbook: '',\n        classification: '',\n        image: '',\n        taskDescribe: '',\n        state: 0,\n        type: this.flag\n      },\n      rules: {\n        name: [{\n          required: true,\n          message: '请输入课程名称',\n          trigger: 'blur'\n        }],\n        gradeLevel: [{\n          required: true,\n          message: '请选择学段',\n          trigger: 'change'\n        }],\n        classification: [{\n          required: true,\n          message: '请选择所属分类',\n          trigger: 'change'\n        }],\n        image: [{\n          required: true,\n          message: '请上传课程封面',\n          trigger: 'change'\n        }]\n      }\n    };\n  },\n  watch: {\n    addVisible: {\n      handler(val) {\n        this.dialogVisible = val;\n        if (val) {\n          this.getClassificationList();\n          this.resetForm();\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    // 获取分类列表\n    getClassificationList() {\n      getApeClassificationList().then(res => {\n        if (res.code === 1000) {\n          this.classificationList = res.data;\n        }\n      });\n    },\n    // 学段变化\n    onGradeLevelChange(val) {\n      // 重置年级和教材\n      this.form.grade = '';\n      this.form.textbook = '';\n      if (val === '其他') {\n        this.showGrade = false;\n        this.showTextbook = false;\n      } else {\n        this.showGrade = true;\n        this.showTextbook = true;\n        this.setGradeOptions(val);\n      }\n    },\n    // 根据学段设置年级选项\n    setGradeOptions(gradeLevel) {\n      const gradeMap = {\n        '小学': [{\n          value: '一年级',\n          label: '一年级'\n        }, {\n          value: '二年级',\n          label: '二年级'\n        }, {\n          value: '三年级',\n          label: '三年级'\n        }, {\n          value: '四年级',\n          label: '四年级'\n        }, {\n          value: '五年级',\n          label: '五年级'\n        }, {\n          value: '六年级',\n          label: '六年级'\n        }],\n        '初中': [{\n          value: '七年级',\n          label: '七年级'\n        }, {\n          value: '八年级',\n          label: '八年级'\n        }, {\n          value: '九年级',\n          label: '九年级'\n        }],\n        '高中': [{\n          value: '高一',\n          label: '高一'\n        }, {\n          value: '高二',\n          label: '高二'\n        }, {\n          value: '高三',\n          label: '高三'\n        }]\n      };\n      this.gradeOptions = gradeMap[gradeLevel] || [];\n    },\n    // 上传封面\n    beforeImageUpload(file) {\n      const isImage = file.type.startsWith('image/');\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isImage) {\n        this.$message.error('只能上传图片文件!');\n        return false;\n      }\n      if (!isLt2M) {\n        this.$message.error('上传图片大小不能超过 2MB!');\n        return false;\n      }\n      return true;\n    },\n    handleImageSuccess(res) {\n      if (res.code === 1000) {\n        this.form.image = res.data;\n        this.$message.success('上传成功');\n      } else {\n        this.$message.error(res.message);\n      }\n    },\n    // 重置表单\n    resetForm() {\n      this.form = {\n        name: '',\n        gradeLevel: '',\n        grade: '',\n        textbook: '',\n        classification: '',\n        image: '',\n        taskDescribe: '',\n        state: 0,\n        type: this.flag\n      };\n      this.showGrade = false;\n      this.showTextbook = false;\n      this.gradeOptions = [];\n      this.$nextTick(() => {\n        this.$refs.ruleForm && this.$refs.ruleForm.clearValidate();\n      });\n    },\n    // 提交表单\n    submitForm() {\n      this.$refs.ruleForm.validate(valid => {\n        if (valid) {\n          // 如果学段是\"其他\"，清空年级和教材\n          if (this.form.gradeLevel === '其他') {\n            this.form.grade = '';\n            this.form.textbook = '';\n          }\n          saveApeTask(this.form).then(res => {\n            if (res.code === 1000) {\n              this.$message.success('新增成功');\n              this.handleClose();\n              this.$emit('addFalse');\n            } else {\n              this.$message.error(res.message);\n            }\n          });\n        }\n      });\n    },\n    // 关闭弹窗\n    handleClose() {\n      this.dialogVisible = false;\n      this.$emit('addFalse');\n      this.resetForm();\n    }\n  }\n};","map":{"version":3,"names":["saveApeTask","getApeClassificationList","mixin","mixins","props","addVisible","type","Boolean","default","flag","String","data","dialogVisible","classificationList","showGrade","showTextbook","gradeOptions","form","name","gradeLevel","grade","textbook","classification","image","taskDescribe","state","rules","required","message","trigger","watch","handler","val","getClassificationList","resetForm","immediate","methods","then","res","code","onGradeLevelChange","setGradeOptions","gradeMap","value","label","beforeImageUpload","file","isImage","startsWith","isLt2M","size","$message","error","handleImageSuccess","success","$nextTick","$refs","ruleForm","clearValidate","submitForm","validate","valid","handleClose","$emit"],"sources":["src/components/system/task/addTask.vue"],"sourcesContent":["<template>\r\n  <el-dialog\r\n      title=\"新增课程\"\r\n      :visible.sync=\"dialogVisible\"\r\n      width=\"600px\"\r\n      :before-close=\"handleClose\"\r\n  >\r\n    <el-form :model=\"form\" :rules=\"rules\" ref=\"ruleForm\" label-width=\"100px\">\r\n      <el-form-item label=\"课程名称\" prop=\"name\">\r\n        <el-input v-model=\"form.name\" placeholder=\"请输入课程名称\"></el-input>\r\n      </el-form-item>\r\n\r\n      <!-- 学段选择 -->\r\n      <el-form-item label=\"学段\" prop=\"gradeLevel\">\r\n        <el-select v-model=\"form.gradeLevel\" placeholder=\"请选择学段\" @change=\"onGradeLevelChange\" clearable style=\"width: 100%\">\r\n          <el-option label=\"小学\" value=\"小学\"></el-option>\r\n          <el-option label=\"初中\" value=\"初中\"></el-option>\r\n          <el-option label=\"高中\" value=\"高中\"></el-option>\r\n          <el-option label=\"其他\" value=\"其他\"></el-option>\r\n        </el-select>\r\n      </el-form-item>\r\n\r\n      <!-- 年级（学段不为其他时显示） -->\r\n      <el-form-item label=\"年级\" prop=\"grade\" v-if=\"showGrade\">\r\n        <el-select v-model=\"form.grade\" placeholder=\"请选择年级\" clearable style=\"width: 100%\">\r\n          <el-option v-for=\"item in gradeOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\"></el-option>\r\n        </el-select>\r\n      </el-form-item>\r\n\r\n      <!-- 教材（学段不为其他时显示） -->\r\n      <el-form-item label=\"教材\" prop=\"textbook\" v-if=\"showTextbook\">\r\n        <el-input v-model=\"form.textbook\" placeholder=\"请输入教材\"></el-input>\r\n      </el-form-item>\r\n\r\n      <el-form-item label=\"所属分类\" prop=\"classification\">\r\n        <el-select v-model=\"form.classification\" placeholder=\"请选择所属分类\" clearable style=\"width: 100%\">\r\n          <el-option v-for=\"item in classificationList\" :key=\"item.id\" :label=\"item.name\" :value=\"item.name\"></el-option>\r\n        </el-select>\r\n      </el-form-item>\r\n\r\n      <el-form-item label=\"课程封面\" prop=\"image\">\r\n        <el-upload\r\n            class=\"avatar-uploader\"\r\n            :action=\"uploadImageUrl()\"\r\n            :show-file-list=\"false\"\r\n            :before-upload=\"beforeImageUpload\"\r\n            :on-success=\"handleImageSuccess\"\r\n            accept=\"image/*\"\r\n        >\r\n          <img v-if=\"form.image\" :src=\"$store.state.HOST + form.image\" class=\"avatar\">\r\n          <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\r\n        </el-upload>\r\n      </el-form-item>\r\n\r\n      <el-form-item label=\"课程描述\" prop=\"taskDescribe\">\r\n        <el-input type=\"textarea\" :rows=\"4\" v-model=\"form.taskDescribe\" placeholder=\"请输入课程描述\"></el-input>\r\n      </el-form-item>\r\n    </el-form>\r\n\r\n    <span slot=\"footer\" class=\"dialog-footer\">\r\n      <el-button @click=\"handleClose\">取 消</el-button>\r\n      <el-button type=\"primary\" @click=\"submitForm\">确 定</el-button>\r\n    </span>\r\n  </el-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { saveApeTask, getApeClassificationList } from '../../../api/api'\r\nimport { mixin } from '../../../minix'\r\n\r\nexport default {\r\n  mixins: [mixin],\r\n  props: {\r\n    addVisible: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    flag: {\r\n      type: String,\r\n      default: '0'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      dialogVisible: false,\r\n      classificationList: [],\r\n      showGrade: false,\r\n      showTextbook: false,\r\n      gradeOptions: [],\r\n      form: {\r\n        name: '',\r\n        gradeLevel: '',\r\n        grade: '',\r\n        textbook: '',\r\n        classification: '',\r\n        image: '',\r\n        taskDescribe: '',\r\n        state: 0,\r\n        type: this.flag\r\n      },\r\n      rules: {\r\n        name: [\r\n          { required: true, message: '请输入课程名称', trigger: 'blur' }\r\n        ],\r\n        gradeLevel: [\r\n          { required: true, message: '请选择学段', trigger: 'change' }\r\n        ],\r\n        classification: [\r\n          { required: true, message: '请选择所属分类', trigger: 'change' }\r\n        ],\r\n        image: [\r\n          { required: true, message: '请上传课程封面', trigger: 'change' }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  watch: {\r\n    addVisible: {\r\n      handler(val) {\r\n        this.dialogVisible = val\r\n        if (val) {\r\n          this.getClassificationList()\r\n          this.resetForm()\r\n        }\r\n      },\r\n      immediate: true\r\n    }\r\n  },\r\n  methods: {\r\n    // 获取分类列表\r\n    getClassificationList() {\r\n      getApeClassificationList().then(res => {\r\n        if (res.code === 1000) {\r\n          this.classificationList = res.data\r\n        }\r\n      })\r\n    },\r\n\r\n    // 学段变化\r\n    onGradeLevelChange(val) {\r\n      // 重置年级和教材\r\n      this.form.grade = ''\r\n      this.form.textbook = ''\r\n\r\n      if (val === '其他') {\r\n        this.showGrade = false\r\n        this.showTextbook = false\r\n      } else {\r\n        this.showGrade = true\r\n        this.showTextbook = true\r\n        this.setGradeOptions(val)\r\n      }\r\n    },\r\n\r\n    // 根据学段设置年级选项\r\n    setGradeOptions(gradeLevel) {\r\n      const gradeMap = {\r\n        '小学': [\r\n          { value: '一年级', label: '一年级' },\r\n          { value: '二年级', label: '二年级' },\r\n          { value: '三年级', label: '三年级' },\r\n          { value: '四年级', label: '四年级' },\r\n          { value: '五年级', label: '五年级' },\r\n          { value: '六年级', label: '六年级' }\r\n        ],\r\n        '初中': [\r\n          { value: '七年级', label: '七年级' },\r\n          { value: '八年级', label: '八年级' },\r\n          { value: '九年级', label: '九年级' }\r\n        ],\r\n        '高中': [\r\n          { value: '高一', label: '高一' },\r\n          { value: '高二', label: '高二' },\r\n          { value: '高三', label: '高三' }\r\n        ]\r\n      }\r\n      this.gradeOptions = gradeMap[gradeLevel] || []\r\n    },\r\n\r\n    // 上传封面\r\n    beforeImageUpload(file) {\r\n      const isImage = file.type.startsWith('image/')\r\n      const isLt2M = file.size / 1024 / 1024 < 2\r\n\r\n      if (!isImage) {\r\n        this.$message.error('只能上传图片文件!')\r\n        return false\r\n      }\r\n      if (!isLt2M) {\r\n        this.$message.error('上传图片大小不能超过 2MB!')\r\n        return false\r\n      }\r\n      return true\r\n    },\r\n\r\n    handleImageSuccess(res) {\r\n      if (res.code === 1000) {\r\n        this.form.image = res.data\r\n        this.$message.success('上传成功')\r\n      } else {\r\n        this.$message.error(res.message)\r\n      }\r\n    },\r\n\r\n    // 重置表单\r\n    resetForm() {\r\n      this.form = {\r\n        name: '',\r\n        gradeLevel: '',\r\n        grade: '',\r\n        textbook: '',\r\n        classification: '',\r\n        image: '',\r\n        taskDescribe: '',\r\n        state: 0,\r\n        type: this.flag\r\n      }\r\n      this.showGrade = false\r\n      this.showTextbook = false\r\n      this.gradeOptions = []\r\n      this.$nextTick(() => {\r\n        this.$refs.ruleForm && this.$refs.ruleForm.clearValidate()\r\n      })\r\n    },\r\n\r\n    // 提交表单\r\n    submitForm() {\r\n      this.$refs.ruleForm.validate((valid) => {\r\n        if (valid) {\r\n          // 如果学段是\"其他\"，清空年级和教材\r\n          if (this.form.gradeLevel === '其他') {\r\n            this.form.grade = ''\r\n            this.form.textbook = ''\r\n          }\r\n\r\n          saveApeTask(this.form).then(res => {\r\n            if (res.code === 1000) {\r\n              this.$message.success('新增成功')\r\n              this.handleClose()\r\n              this.$emit('addFalse')\r\n            } else {\r\n              this.$message.error(res.message)\r\n            }\r\n          })\r\n        }\r\n      })\r\n    },\r\n\r\n    // 关闭弹窗\r\n    handleClose() {\r\n      this.dialogVisible = false\r\n      this.$emit('addFalse')\r\n      this.resetForm()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.avatar-uploader {\r\n  border: 1px dashed #d9d9d9;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n  width: 178px;\r\n  height: 178px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.avatar-uploader:hover {\r\n  border-color: #409EFF;\r\n}\r\n\r\n.avatar-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n  width: 178px;\r\n  height: 178px;\r\n  line-height: 178px;\r\n  text-align: center;\r\n}\r\n\r\n.avatar {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n</style>"],"mappings":"AAmEA,SAAAA,WAAA,EAAAC,wBAAA;AACA,SAAAC,KAAA;AAEA;EACAC,MAAA,GAAAD,KAAA;EACAE,KAAA;IACAC,UAAA;MACAC,IAAA,EAAAC,OAAA;MACAC,OAAA;IACA;IACAC,IAAA;MACAH,IAAA,EAAAI,MAAA;MACAF,OAAA;IACA;EACA;EACAG,KAAA;IACA;MACAC,aAAA;MACAC,kBAAA;MACAC,SAAA;MACAC,YAAA;MACAC,YAAA;MACAC,IAAA;QACAC,IAAA;QACAC,UAAA;QACAC,KAAA;QACAC,QAAA;QACAC,cAAA;QACAC,KAAA;QACAC,YAAA;QACAC,KAAA;QACAnB,IAAA,OAAAG;MACA;MACAiB,KAAA;QACAR,IAAA,GACA;UAAAS,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAV,UAAA,GACA;UAAAQ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAP,cAAA,GACA;UAAAK,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAN,KAAA,GACA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;IACA;EACA;EACAC,KAAA;IACAzB,UAAA;MACA0B,QAAAC,GAAA;QACA,KAAApB,aAAA,GAAAoB,GAAA;QACA,IAAAA,GAAA;UACA,KAAAC,qBAAA;UACA,KAAAC,SAAA;QACA;MACA;MACAC,SAAA;IACA;EACA;EACAC,OAAA;IACA;IACAH,sBAAA;MACAhC,wBAAA,GAAAoC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAA1B,kBAAA,GAAAyB,GAAA,CAAA3B,IAAA;QACA;MACA;IACA;IAEA;IACA6B,mBAAAR,GAAA;MACA;MACA,KAAAf,IAAA,CAAAG,KAAA;MACA,KAAAH,IAAA,CAAAI,QAAA;MAEA,IAAAW,GAAA;QACA,KAAAlB,SAAA;QACA,KAAAC,YAAA;MACA;QACA,KAAAD,SAAA;QACA,KAAAC,YAAA;QACA,KAAA0B,eAAA,CAAAT,GAAA;MACA;IACA;IAEA;IACAS,gBAAAtB,UAAA;MACA,MAAAuB,QAAA;QACA,OACA;UAAAC,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,EACA;QACA,OACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,EACA;QACA,OACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA,GACA;UAAAD,KAAA;UAAAC,KAAA;QAAA;MAEA;MACA,KAAA5B,YAAA,GAAA0B,QAAA,CAAAvB,UAAA;IACA;IAEA;IACA0B,kBAAAC,IAAA;MACA,MAAAC,OAAA,GAAAD,IAAA,CAAAxC,IAAA,CAAA0C,UAAA;MACA,MAAAC,MAAA,GAAAH,IAAA,CAAAI,IAAA;MAEA,KAAAH,OAAA;QACA,KAAAI,QAAA,CAAAC,KAAA;QACA;MACA;MACA,KAAAH,MAAA;QACA,KAAAE,QAAA,CAAAC,KAAA;QACA;MACA