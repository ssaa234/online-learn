{"ast":null,"code":"import { getApeArticleById } from '../../../api/api';\nexport default {\n  data() {\n    return {\n      user: {},\n      articleId: \"\",\n      article: {\n        title: '',\n        createBy: '',\n        createTime: '',\n        articleDesc: '',\n        content: ''\n      }\n    };\n  },\n  methods: {\n    getApeArticleById() {\n      const id = this.$route.query.id;\n      console.log('获取笔记详情，ID:', id);\n      if (!id) {\n        this.$message.error('笔记ID不存在');\n        return;\n      }\n      getApeArticleById({\n        id: id\n      }).then(res => {\n        console.log('返回数据:', res);\n        if (res.code == 1000) {\n          this.article = res.data;\n        } else {\n          this.$message.error(res.message || '获取笔记详情失败');\n        }\n      }).catch(err => {\n        console.error('获取笔记详情错误:', err);\n        this.$message.error('获取笔记详情失败，请稍后重试');\n      });\n    }\n  },\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\") || '{}');\n    this.getApeArticleById();\n  }\n};","map":{"version":3,"names":["getApeArticleById","data","user","articleId","article","title","createBy","createTime","articleDesc","content","methods","id","$route","query","console","log","$message","error","then","res","code","message","catch","err","mounted","window","scrollTo","top","behavior","JSON","parse","localStorage","getItem"],"sources":["src/views/system/article/articleInfo.vue"],"sourcesContent":["<template>\r\n  <div className=\"articleInfo\">\r\n    <div className=\"articleInfo-content\">\r\n      <div className=\"articleInfo-title\">\r\n        <div className=\"articleInfo-title1\">{{ ar ticle.title }}</div>\r\n        <div className=\"articleInfo-title2\">{{ ar ticle.createBy }} - {{ article.createTime }}</div>\r\n      </div>\r\n      <div className=\"articleInfo-desc\">\r\n        <div className=\"articleInfo-desc1\">\r\n          <span style=\"font-weight:bold\">摘要：</span>{{ ar ticle.articleDesc }}\r\n        </div>\r\n        <div className=\"articleInfo-desc2\">\r\n          <span style=\"font-weight:bold\">正文：</span>\r\n          <div v-html=\"article.content\"></div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeArticleById} from '../../../api/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: {},\r\n      articleId: \"\",\r\n      article: {\r\n        title: '',\r\n        createBy: '',\r\n        createTime: '',\r\n        articleDesc: '',\r\n        content: ''\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    getApeArticleById() {\r\n      const id = this.$route.query.id\r\n      console.log('获取笔记详情，ID:', id)\r\n\r\n      if (!id) {\r\n        this.$message.error('笔记ID不存在')\r\n        return\r\n      }\r\n\r\n      getApeArticleById({id: id}).then(res => {\r\n        console.log('返回数据:', res)\r\n        if (res.code == 1000) {\r\n          this.article = res.data\r\n        } else {\r\n          this.$message.error(res.message || '获取笔记详情失败')\r\n        }\r\n      }).catch(err => {\r\n        console.error('获取笔记详情错误:', err)\r\n        this.$message.error('获取笔记详情失败，请稍后重试')\r\n      })\r\n    }\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\") || '{}')\r\n    this.getApeArticleById()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../../assets/css/articleInfo.css\");\r\n\r\n::v-deep img {\r\n  max-width: 100% !important;\r\n}\r\n</style>"],"mappings":"AAqBA,SAAAA,iBAAA;AAEA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,SAAA;MACAC,OAAA;QACAC,KAAA;QACAC,QAAA;QACAC,UAAA;QACAC,WAAA;QACAC,OAAA;MACA;IACA;EACA;EACAC,OAAA;IACAV,kBAAA;MACA,MAAAW,EAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAF,EAAA;MACAG,OAAA,CAAAC,GAAA,eAAAJ,EAAA;MAEA,KAAAA,EAAA;QACA,KAAAK,QAAA,CAAAC,KAAA;QACA;MACA;MAEAjB,iBAAA;QAAAW,EA