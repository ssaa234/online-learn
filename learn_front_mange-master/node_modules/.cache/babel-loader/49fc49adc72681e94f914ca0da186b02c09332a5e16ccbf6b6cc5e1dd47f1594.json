{"ast":null,"code":"import { mixin } from \"../../../minix\";\nimport { saveUser } from '../../../api/api';\nexport default {\n  mixins: [mixin],\n  data() {\n    return {\n      formLabelWidth: '80px',\n      school: [],\n      major: [],\n      form: {\n        userName: \"\",\n        loginAccount: \"\",\n        email: \"\",\n        tel: \"\",\n        sex: \"\",\n        password: \"\",\n        status: \"0\",\n        userType: 2,\n        country: \"\",\n        age: \"\",\n        birth: \"\",\n        remark: \"\"\n      },\n      rules: {\n        userName: [{\n          required: true,\n          message: '请输入学生昵称',\n          trigger: 'blur'\n        }],\n        loginAccount: [{\n          required: true,\n          message: '请输入登陆账号',\n          trigger: 'blur'\n        }],\n        password: [{\n          required: true,\n          message: '请输入登陆密码',\n          trigger: 'blur'\n        }],\n        tel: [{\n          required: true,\n          message: '请输入联系电话',\n          trigger: 'blur'\n        }],\n        email: [{\n          required: true,\n          message: '请输入邮箱地址',\n          trigger: 'blur'\n        }],\n        sex: [{\n          required: true,\n          message: '请选择性别',\n          trigger: 'blur'\n        }],\n        country: [{\n          required: true,\n          message: '请输入国家',\n          trigger: 'blur'\n        }],\n        birth: [{\n          required: true,\n          message: '请选择生日',\n          trigger: 'blur'\n        }],\n        age: [{\n          required: false\n        }],\n        status: [{\n          required: false\n        }],\n        remark: [{\n          required: false\n        }]\n      }\n    };\n  },\n  props: ['addUserVisible'],\n  methods: {\n    // 根据生日计算年龄\n    calculateAge() {\n      if (this.form.birth) {\n        const birthDate = new Date(this.form.birth);\n        const today = new Date();\n        let age = today.getFullYear() - birthDate.getFullYear();\n        const monthDiff = today.getMonth() - birthDate.getMonth();\n        if (monthDiff < 0 || monthDiff === 0 && today.getDate() < birthDate.getDate()) {\n          age--;\n        }\n        this.form.age = age;\n      } else {\n        this.form.age = '';\n      }\n    },\n    submit() {\n      this.$refs[\"ruleForm\"].validate(valid => {\n        if (valid) {\n          saveUser(this.form).then(res => {\n            if (res.code == 1000) {\n              this.$notify.success({\n                title: '成功',\n                message: \"保存成功\"\n              });\n              this.handleClose();\n            } else {\n              this.$notify.error({\n                title: '错误',\n                message: res.message\n              });\n            }\n          });\n        } else {\n          return false;\n        }\n      });\n    },\n    handleClose() {\n      this.form = {\n        userName: \"\",\n        loginAccount: \"\",\n        email: \"\",\n        tel: \"\",\n        sex: \"\",\n        password: \"\",\n        status: \"0\",\n        userType: 2,\n        country: \"\",\n        age: \"\",\n        birth: \"\",\n        remark: \"\"\n      };\n      this.$emit(\"addUserFalse\");\n    }\n  },\n  created() {},\n  mounted() {}\n};","map":{"version":3,"names":["mixin","saveUser","mixins","data","formLabelWidth","school","major","form","userName","loginAccount","email","tel","sex","password","status","userType","country","age","birth","remark","rules","required","message","trigger","props","methods","calculateAge","birthDate","Date","today","getFullYear","monthDiff","getMonth","getDate","submit","$refs","validate","valid","then","res","code","$notify","success","title","handleClose","error","$emit","created","mounted"],"sources":["src/components/system/student/addStudent.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-dialog title=\"新增学生\" width=\"40%\" :destroy-on-close=\"true\" :visible.sync=\"addUserVisible\" :before-close=\"handleClose\">\r\n      <el-form :model=\"form\" :rules=\"rules\" ref=\"ruleForm\">\r\n        <el-row :gutter=\"10\">\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">学生昵称:</span>\r\n            <el-form-item prop=\"userName\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.userName\" size=\"mini\" placeholder=\"请输入学生昵称\" autocomplete=\"off\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">手机号码:</span>\r\n            <el-form-item prop=\"tel\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.tel\" size=\"mini\" placeholder=\"请输入手机号码\" autocomplete=\"off\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">邮箱:</span>\r\n            <el-form-item prop=\"email\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.email\" size=\"mini\" placeholder=\"请输入邮箱\" autocomplete=\"off\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">登陆账号:</span>\r\n            <el-form-item prop=\"loginAccount\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.loginAccount\" size=\"mini\" placeholder=\"请输入登陆账号\" autocomplete=\"off\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">学生密码:</span>\r\n            <el-form-item prop=\"password\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.password\" show-password size=\"mini\" placeholder=\"请输入学生密码\" autocomplete=\"off\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <!-- 删除学校和专业字段 -->\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">国家:</span>\r\n            <el-form-item prop=\"country\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.country\" size=\"mini\" placeholder=\"请输入国家\" autocomplete=\"off\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <!-- 生日在前 -->\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">生日:</span>\r\n            <el-form-item prop=\"birth\" style=\"margin-bottom:0\">\r\n              <el-date-picker size=\"mini\"\r\n                              v-model=\"form.birth\"\r\n                              type=\"date\"\r\n                              value-format=\"yyyy-MM-dd\"\r\n                              placeholder=\"请选择生日\"\r\n                              @change=\"calculateAge\">\r\n              </el-date-picker>\r\n            </el-form-item>\r\n          </el-col>\r\n          <!-- 年龄在后，根据生日自动计算 -->\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">年龄:</span>\r\n            <el-form-item prop=\"age\" style=\"margin-bottom:0\">\r\n              <el-input v-model=\"form.age\" size=\"mini\" placeholder=\"自动计算\" disabled></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <!-- 删除地址字段 -->\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">性别:</span>\r\n            <el-form-item prop=\"sex\" style=\"margin-bottom:0\">\r\n              <el-select size=\"mini\" v-model=\"form.sex\" placeholder=\"请选择性别\">\r\n                <el-option label=\"男\" value=\"0\"></el-option>\r\n                <el-option label=\"女\" value=\"1\"></el-option>\r\n              </el-select>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\" :xl=\"12\">\r\n            <span class=\"search-title\">状态:</span>\r\n            <el-form-item prop=\"status\" style=\"margin-bottom:0\">\r\n              <el-radio-group style=\"margin-top:1px;height:40px;display:flex;align-items: center\" v-model=\"form.status\">\r\n                <el-radio label=\"0\">正常</el-radio>\r\n                <el-radio label=\"1\">停用</el-radio>\r\n              </el-radio-group>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">个人介绍:</span>\r\n            <el-form-item prop=\"remark\" style=\"margin-bottom:0\">\r\n              <el-input type=\"textarea\" v-model=\"form.remark\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n        </el-row>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button size=\"mini\" type=\"primary\" @click=\"submit\">确 定</el-button>\r\n        <el-button size=\"mini\" @click=\"handleClose\">取 消</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {mixin} from \"../../../minix\";\r\nimport {saveUser} from '../../../api/api'\r\nexport default {\r\n  mixins: [mixin],\r\n  data() {\r\n    return{\r\n      formLabelWidth: '80px',\r\n      school: [],\r\n      major: [],\r\n      form: {\r\n        userName: \"\",\r\n        loginAccount: \"\",\r\n        email: \"\",\r\n        tel: \"\",\r\n        sex: \"\",\r\n        password: \"\",\r\n        status: \"0\",\r\n        userType: 2,\r\n        country: \"\",\r\n        age: \"\",\r\n        birth: \"\",\r\n        remark: \"\",\r\n      },\r\n      rules: {\r\n        userName: [\r\n          { required: true, message: '请输入学生昵称', trigger: 'blur' },\r\n        ],\r\n        loginAccount: [\r\n          { required: true, message: '请输入登陆账号', trigger: 'blur' },\r\n        ],\r\n        password: [\r\n          { required: true, message: '请输入登陆密码', trigger: 'blur' },\r\n        ],\r\n        tel: [\r\n          { required: true, message: '请输入联系电话', trigger: 'blur' },\r\n        ],\r\n        email: [\r\n          { required: true, message: '请输入邮箱地址', trigger: 'blur' },\r\n        ],\r\n        sex: [\r\n          { required: true, message: '请选择性别', trigger: 'blur' },\r\n        ],\r\n        country: [\r\n          { required: true, message: '请输入国家', trigger: 'blur' },\r\n        ],\r\n        birth: [\r\n          { required: true, message: '请选择生日', trigger: 'blur' },\r\n        ],\r\n        age: [\r\n          { required: false },\r\n        ],\r\n        status: [\r\n          { required: false },\r\n        ],\r\n        remark: [\r\n          { required: false },\r\n        ],\r\n      }\r\n    }\r\n  },\r\n  props: ['addUserVisible'],\r\n  methods: {\r\n    // 根据生日计算年龄\r\n    calculateAge() {\r\n      if (this.form.birth) {\r\n        const birthDate = new Date(this.form.birth);\r\n        const today = new Date();\r\n        let age = today.getFullYear() - birthDate.getFullYear();\r\n        const monthDiff = today.getMonth() - birthDate.getMonth();\r\n        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {\r\n          age--;\r\n        }\r\n        this.form.age = age;\r\n      } else {\r\n        this.form.age = '';\r\n      }\r\n    },\r\n    submit() {\r\n      this.$refs[\"ruleForm\"].validate((valid) => {\r\n        if (valid) {\r\n          saveUser(this.form).then(res => {\r\n            if(res.code == 1000) {\r\n              this.$notify.success({\r\n                title: '成功',\r\n                message: \"保存成功\"\r\n              });\r\n              this.handleClose();\r\n            } else {\r\n              this.$notify.error({\r\n                title: '错误',\r\n                message: res.message\r\n              });\r\n            }\r\n          })\r\n        } else {\r\n          return false;\r\n        }\r\n      });\r\n    },\r\n    handleClose() {\r\n      this.form = {\r\n        userName: \"\",\r\n        loginAccount: \"\",\r\n        email: \"\",\r\n        tel: \"\",\r\n        sex: \"\",\r\n        password: \"\",\r\n        status: \"0\",\r\n        userType: 2,\r\n        country: \"\",\r\n        age: \"\",\r\n        birth: \"\",\r\n        remark: \"\",\r\n      }\r\n      this.$emit(\"addUserFalse\")\r\n    },\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.el-col {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  margin-top: 12px\r\n}\r\n.search-title {\r\n  font-family: '黑体';\r\n  float: right;\r\n  white-space: nowrap;\r\n  font-size: 14px;\r\n  width: 80px;\r\n  text-align: right;\r\n}\r\n</style>"],"mappings":"AAkGA,SAAAA,KAAA;AACA,SAAAC,QAAA;AACA;EACAC,MAAA,GAAAF,KAAA;EACAG,KAAA;IACA;MACAC,cAAA;MACAC,MAAA;MACAC,KAAA;MACAC,IAAA;QACAC,QAAA;QACAC,YAAA;QACAC,KAAA;QACAC,GAAA;QACAC,GAAA;QACAC,QAAA;QACAC,MAAA;QACAC,QAAA;QACAC,OAAA;QACAC,GAAA;QACAC,KAAA;QACAC,MAAA;MACA;MACAC,KAAA;QACAZ,QAAA,GACA;UAAAa,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAd,YAAA,GACA;UAAAY,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAV,QAAA,GACA;UAAAQ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAZ,GAAA,GACA;UAAAU,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAb,KAAA,GACA;UAAAW,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAX,GAAA,GACA;UAAAS,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAP,OAAA,GACA;UAAAK,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAL,KAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAN,GAAA,GACA;UAAAI,QAAA;QAAA,EACA;QACAP,MAAA,GACA;UAAAO,QAAA;QAAA,EACA;QACAF,MAAA,GACA;UAAAE,QAAA;QAAA;MAEA;IACA;EACA;EACAG,KAAA;EACAC,OAAA;IACA;IACAC,aAAA;MACA,SAAAnB,IAAA,CAAAW,KAAA;QACA,MAAAS,SAAA,OAAAC,IAAA,MAAArB,IAAA,CAAAW,KAAA;QACA,MAAAW,KAAA,OAAAD,IAAA;QACA,IAAAX,GAAA,GAAAY,KAAA,CAAAC,WAAA,KAAAH,SAAA,CAAAG,WAAA;QACA,MAAAC,SAAA,GAAAF,KAAA,CAAAG,QAAA,KAAAL,SAAA,CAAAK,QAAA;QACA,IAAAD,SAAA,QAAAA,SA