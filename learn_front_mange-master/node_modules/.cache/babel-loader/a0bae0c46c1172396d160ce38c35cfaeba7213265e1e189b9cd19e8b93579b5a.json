{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mixin } from \"../../../minix\";\nimport { editApeTask, getApeTaskById, getUserListByType, getApeClassificationList } from '../../../api/api';\nexport default {\n  mixins: [mixin],\n  data() {\n    return {\n      formLabelWidth: '80px',\n      form: {\n        name: \"\",\n        taskDescribe: \"\",\n        teacherId: \"\",\n        teacherName: \"\",\n        image: \"\",\n        state: \"\",\n        classification: \"\",\n        num: \"\",\n        remark: \"\",\n        proportion: \"\",\n        gradeLevel: \"\",\n        // 学段\n        grade: \"\",\n        // 年级\n        textbook: \"\" // 教材\n      },\n      fileList: [],\n      dialogImageUrl: '',\n      dialogVisible: false,\n      showGrade: false,\n      // 是否显示年级\n      showTextbook: false,\n      // 是否显示教材\n      showClassification: false,\n      // 是否显示所属分类\n      gradeOptions: [],\n      // 年级选项\n      rules: {\n        proportion: [{\n          required: true,\n          message: '请输入视频和作业分数占比',\n          trigger: 'blur'\n        }],\n        name: [{\n          required: true,\n          message: '请输入课程名称',\n          trigger: 'blur'\n        }],\n        taskDescribe: [{\n          required: true,\n          message: '请输入课程描述',\n          trigger: 'blur'\n        }],\n        teacherId: [{\n          required: true,\n          message: '请选择教师',\n          trigger: 'blur'\n        }],\n        gradeLevel: [{\n          required: true,\n          message: '请选择学段',\n          trigger: 'change'\n        }],\n        classification: [{\n          required: false,\n          message: '请选择所属分类',\n          trigger: 'blur'\n        }],\n        image: [{\n          required: true,\n          message: '请上传封面图片',\n          trigger: 'blur'\n        }]\n      },\n      teacher: [],\n      classification: []\n    };\n  },\n  props: ['updateVisible', 'updateId', 'flag'],\n  methods: {\n    // 学段变化\n    onGradeLevelChange(val) {\n      // 重置年级、教材、分类\n      this.form.grade = '';\n      this.form.textbook = '';\n      this.form.classification = '';\n      if (val === '其他') {\n        this.showGrade = false;\n        this.showTextbook = false;\n        this.showClassification = true;\n        this.rules.classification[0].required = true;\n      } else if (val) {\n        this.showGrade = true;\n        this.showTextbook = true;\n        this.showClassification = false;\n        this.rules.classification[0].required = false;\n        this.setGradeOptions(val);\n      } else {\n        this.showGrade = false;\n        this.showTextbook = false;\n        this.showClassification = false;\n      }\n    },\n    // 根据学段设置年级选项\n    setGradeOptions(gradeLevel) {\n      const gradeMap = {\n        '小学': [{\n          value: '一年级',\n          label: '一年级'\n        }, {\n          value: '二年级',\n          label: '二年级'\n        }, {\n          value: '三年级',\n          label: '三年级'\n        }, {\n          value: '四年级',\n          label: '四年级'\n        }, {\n          value: '五年级',\n          label: '五年级'\n        }, {\n          value: '六年级',\n          label: '六年级'\n        }],\n        '初中': [{\n          value: '七年级',\n          label: '七年级'\n        }, {\n          value: '八年级',\n          label: '八年级'\n        }, {\n          value: '九年级',\n          label: '九年级'\n        }],\n        '高中': [{\n          value: '高一',\n          label: '高一'\n        }, {\n          value: '高二',\n          label: '高二'\n        }, {\n          value: '高三',\n          label: '高三'\n        }]\n      };\n      this.gradeOptions = gradeMap[gradeLevel] || [];\n    },\n    // 根据学段设置页面显示状态（用于编辑时回显）\n    setFormDisplayByGradeLevel(gradeLevel) {\n      if (gradeLevel === '其他') {\n        this.showGrade = false;\n        this.showTextbook = false;\n        this.showClassification = true;\n        this.rules.classification[0].required = true;\n      } else if (gradeLevel) {\n        this.showGrade = true;\n        this.showTextbook = true;\n        this.showClassification = false;\n        this.rules.classification[0].required = false;\n        this.setGradeOptions(gradeLevel);\n      } else {\n        this.showGrade = false;\n        this.showTextbook = false;\n        this.showClassification = false;\n      }\n    },\n    handleAvatorSuccess(res) {\n      let _this = this;\n      if (res.code == 1000) {\n        _this.$message({\n          type: 'success',\n          message: '上传成功!'\n        });\n        this.fileList.push({\n          url: this.$store.state.configure.HOST + res.message\n        });\n        this.form.image = res.message;\n      } else {\n        _this.$notify.error({\n          title: '错误',\n          message: res.message\n        });\n      }\n    },\n    handleRemove(file, fileList) {\n      this.form.image = \"\";\n      this.fileList = [];\n    },\n    handlePictureCardPreview(file) {\n      this.dialogImageUrl = file.url;\n      this.dialogVisible = true;\n    },\n    getUserListByType() {\n      getUserListByType({\n        type: 1\n      }).then(res => {\n        if (res.code == 1000) {\n          this.teacher = res.data;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    getApeClassificationList() {\n      getApeClassificationList().then(res => {\n        if (res.code == 1000) {\n          this.classification = res.data;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    submit() {\n      this.$refs[\"ruleForm\"].validate(valid => {\n        if (valid) {\n          // 根据学段处理数据\n          if (this.form.gradeLevel === '其他') {\n            this.form.grade = '';\n            this.form.textbook = '';\n          } else {\n            this.form.classification = '';\n          }\n          if (this.flag == 2) {\n            this.form.type = 1;\n          }\n          editApeTask(this.form).then(res => {\n            if (res.code == 1000) {\n              this.$notify.success({\n                title: '成功',\n                message: \"保存成功\"\n              });\n              this.handleClose();\n            } else {\n              this.$notify.error({\n                title: '错误',\n                message: res.message\n              });\n            }\n          });\n        } else {\n          return false;\n        }\n      });\n    },\n    handleClose() {\n      this.fileList = [];\n      this.showGrade = false;\n      this.showTextbook = false;\n      this.showClassification = false;\n      this.gradeOptions = [];\n      this.rules.classification[0].required = true;\n      this.$emit(\"updateFalse\");\n    }\n  },\n  created() {},\n  mounted() {\n    this.getUserListByType();\n    this.getApeClassificationList();\n  },\n  watch: {\n    updateId(newVal) {\n      if (newVal) {\n        getApeTaskById({\n          id: newVal\n        }).then(res => {\n          if (res.code == 1000) {\n            this.form = res.data;\n            this.form.state = 2;\n            this.form.num = res.data.num + \"\";\n            this.fileList.push({\n              url: this.$store.state.configure.HOST + this.form.image\n            });\n\n            // 根据学段设置显示状态\n            this.$nextTick(() => {\n              this.setFormDisplayByGradeLevel(this.form.gradeLevel);\n            });\n            if (this.flag == 1) {\n              this.form.type = 0;\n            } else {\n              this.form.type = 1;\n            }\n          } else {\n            this.$notify.error({\n              title: '错误',\n              message: res.message\n            });\n          }\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["mixin","editApeTask","getApeTaskById","getUserListByType","getApeClassificationList","mixins","data","formLabelWidth","form","name","taskDescribe","teacherId","teacherName","image","state","classification","num","remark","proportion","gradeLevel","grade","textbook","fileList","dialogImageUrl","dialogVisible","showGrade","showTextbook","showClassification","gradeOptions","rules","required","message","trigger","teacher","props","methods","onGradeLevelChange","val","setGradeOptions","gradeMap","value","label","setFormDisplayByGradeLevel","handleAvatorSuccess","res","_this","code","$message","type","push","url","$store","configure","HOST","$notify","error","title","handleRemove","file","handlePictureCardPreview","then","submit","$refs","validate","valid","flag","success","handleClose","$emit","created","mounted","watch","updateId","newVal","id","$nextTick"],"sources":["src/components/system/task/updateTask.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-dialog title=\"编辑课程\" width=\"40%\" :destroy-on-close=\"true\" :visible.sync=\"updateVisible\" :before-close=\"handleClose\">\r\n      <el-form :model=\"form\" :rules=\"rules\" ref=\"ruleForm\">\r\n        <el-row :gutter=\"10\">\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                课程名称:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"name\" style=\"margin-bottom:0\">\r\n                <el-input v-model=\"form.name\" size=\"mini\" placeholder=\"请输入课程名称\" autocomplete=\"off\"></el-input>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                课程占比:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"proportion\" style=\"margin-bottom:0\">\r\n                <el-input type=\"number\" min=\"0\" max=\"100\" v-model=\"form.proportion\" size=\"mini\" placeholder=\"请输入视频和作业分数所占比例\" autocomplete=\"off\"></el-input>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n          <el-col v-if=\"flag == 1\" :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                教师名称:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"teacherId\" style=\"margin-bottom:0\">\r\n                <el-select clearable style=\"margin-top:10px\" size=\"mini\" v-model=\"form.teacherId\" placeholder=\"请选择\">\r\n                  <el-option v-for=\"(item,index) in teacher\" :key=\"index\"\r\n                             :label=\"item.userName\"\r\n                             :value=\"item.id\">\r\n                  </el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n\r\n          <!-- 所属学段 -->\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                所属学段:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"gradeLevel\" style=\"margin-bottom:0\">\r\n                <el-select clearable style=\"margin-top:10px\" size=\"mini\" v-model=\"form.gradeLevel\" placeholder=\"请选择学段\" @change=\"onGradeLevelChange\">\r\n                  <el-option label=\"小学\" value=\"小学\"></el-option>\r\n                  <el-option label=\"初中\" value=\"初中\"></el-option>\r\n                  <el-option label=\"高中\" value=\"高中\"></el-option>\r\n                  <el-option label=\"其他\" value=\"其他\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n\r\n          <!-- 所属年级（学段不为其他时显示） -->\r\n          <el-col v-if=\"showGrade\" :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                所属年级:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"grade\" style=\"margin-bottom:0\">\r\n                <el-select clearable style=\"margin-top:10px\" size=\"mini\" v-model=\"form.grade\" placeholder=\"请选择年级\">\r\n                  <el-option v-for=\"item in gradeOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n\r\n          <!-- 所属教材（学段不为其他时显示） -->\r\n          <el-col v-if=\"showTextbook\" :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                所属教材:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"textbook\" style=\"margin-bottom:0\">\r\n                <el-input v-model=\"form.textbook\" size=\"mini\" placeholder=\"请输入教材\" autocomplete=\"off\"></el-input>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n\r\n          <!-- 所属分类（仅当学段为\"其他\"时显示） -->\r\n          <el-col v-if=\"showClassification\" :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                所属分类:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"classification\" style=\"margin-bottom:0\">\r\n                <el-select clearable style=\"margin-top:10px\" size=\"mini\" v-model=\"form.classification\" placeholder=\"请选择\">\r\n                  <el-option v-for=\"(item,index) in classification\" :key=\"index\"\r\n                             :label=\"item.name\"\r\n                             :value=\"item.name\">\r\n                  </el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                封面:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"image\" style=\"margin-bottom:0\">\r\n                <el-upload\r\n                    :file-list=\"fileList\"\r\n                    ref=\"upload\"\r\n                    :action=\"uploadImageUrl()\"\r\n                    accept=\"image/*\"\r\n                    :multiple=\"false\"\r\n                    :limit=\"1\"\r\n                    :before-upload=\"beforeAvatorUpload\"\r\n                    list-type=\"picture-card\"\r\n                    :on-preview=\"handlePictureCardPreview\"\r\n                    :on-exceed=\"handleExceed\"\r\n                    :on-success=\"handleAvatorSuccess\"\r\n                    :on-remove=\"handleRemove\">\r\n                  <i class=\"el-icon-plus\"></i>\r\n                </el-upload>\r\n                <el-dialog :visible.sync=\"dialogVisible\">\r\n                  <img width=\"100%\" :src=\"dialogImageUrl\" alt=\"\">\r\n                </el-dialog>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n          <el-col style=\"margin-top:35px\" :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                课程描述:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"taskDescribe\" style=\"margin-bottom:0\">\r\n                <el-input type=\"textarea\" v-model=\"form.taskDescribe\" size=\"mini\" placeholder=\"请输入课程描述\" autocomplete=\"off\"></el-input>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n          <el-col style=\"margin-top:25px\" :xs=\"24\" :sm=\"24\" :md=\"24\" :lg=\"24\" :xl=\"24\">\r\n            <span class=\"search-title\">\r\n                备注:\r\n                </span>\r\n            <div style=\"width:100%\">\r\n              <el-form-item prop=\"remark\" style=\"margin-bottom:0\">\r\n                <el-input type=\"textarea\" v-model=\"form.remark\" size=\"mini\" placeholder=\"请输入备注\" autocomplete=\"off\"></el-input>\r\n              </el-form-item>\r\n            </div>\r\n          </el-col>\r\n        </el-row>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button size=\"mini\" type=\"primary\" @click=\"submit\">确 定</el-button>\r\n        <el-button size=\"mini\" @click=\"handleClose\">取 消</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {mixin} from \"../../../minix\";\r\nimport {editApeTask,getApeTaskById,getUserListByType,getApeClassificationList} from '../../../api/api'\r\nexport default {\r\n  mixins: [mixin],\r\n  data() {\r\n    return{\r\n      formLabelWidth: '80px',\r\n      form: {\r\n        name: \"\",\r\n        taskDescribe: \"\",\r\n        teacherId: \"\",\r\n        teacherName: \"\",\r\n        image: \"\",\r\n        state: \"\",\r\n        classification: \"\",\r\n        num: \"\",\r\n        remark: \"\",\r\n        proportion: \"\",\r\n        gradeLevel: \"\",   // 学段\r\n        grade: \"\",         // 年级\r\n        textbook: \"\",      // 教材\r\n      },\r\n      fileList: [],\r\n      dialogImageUrl: '',\r\n      dialogVisible: false,\r\n      showGrade: false,         // 是否显示年级\r\n      showTextbook: false,      // 是否显示教材\r\n      showClassification: false, // 是否显示所属分类\r\n      gradeOptions: [],         // 年级选项\r\n      rules: {\r\n        proportion: [\r\n          { required: true, message: '请输入视频和作业分数占比', trigger: 'blur' },\r\n        ],\r\n        name: [\r\n          { required: true, message: '请输入课程名称', trigger: 'blur' },\r\n        ],\r\n        taskDescribe: [\r\n          { required: true, message: '请输入课程描述', trigger: 'blur' },\r\n        ],\r\n        teacherId: [\r\n          { required: true, message: '请选择教师', trigger: 'blur' },\r\n        ],\r\n        gradeLevel: [\r\n          { required: true, message: '请选择学段', trigger: 'change' },\r\n        ],\r\n        classification: [\r\n          { required: false, message: '请选择所属分类', trigger: 'blur' },\r\n        ],\r\n        image: [\r\n          { required: true, message: '请上传封面图片', trigger: 'blur' },\r\n        ],\r\n      },\r\n      teacher: [],\r\n      classification: []\r\n    }\r\n  },\r\n  props: ['updateVisible','updateId','flag'],\r\n  methods: {\r\n    // 学段变化\r\n    onGradeLevelChange(val) {\r\n      // 重置年级、教材、分类\r\n      this.form.grade = ''\r\n      this.form.textbook = ''\r\n      this.form.classification = ''\r\n\r\n      if (val === '其他') {\r\n        this.showGrade = false\r\n        this.showTextbook = false\r\n        this.showClassification = true\r\n        this.rules.classification[0].required = true\r\n      } else if (val) {\r\n        this.showGrade = true\r\n        this.showTextbook = true\r\n        this.showClassification = false\r\n        this.rules.classification[0].required = false\r\n        this.setGradeOptions(val)\r\n      } else {\r\n        this.showGrade = false\r\n        this.showTextbook = false\r\n        this.showClassification = false\r\n      }\r\n    },\r\n\r\n    // 根据学段设置年级选项\r\n    setGradeOptions(gradeLevel) {\r\n      const gradeMap = {\r\n        '小学': [\r\n          { value: '一年级', label: '一年级' },\r\n          { value: '二年级', label: '二年级' },\r\n          { value: '三年级', label: '三年级' },\r\n          { value: '四年级', label: '四年级' },\r\n          { value: '五年级', label: '五年级' },\r\n          { value: '六年级', label: '六年级' }\r\n        ],\r\n        '初中': [\r\n          { value: '七年级', label: '七年级' },\r\n          { value: '八年级', label: '八年级' },\r\n          { value: '九年级', label: '九年级' }\r\n        ],\r\n        '高中': [\r\n          { value: '高一', label: '高一' },\r\n          { value: '高二', label: '高二' },\r\n          { value: '高三', label: '高三' }\r\n        ]\r\n      }\r\n      this.gradeOptions = gradeMap[gradeLevel] || []\r\n    },\r\n\r\n    // 根据学段设置页面显示状态（用于编辑时回显）\r\n    setFormDisplayByGradeLevel(gradeLevel) {\r\n      if (gradeLevel === '其他') {\r\n        this.showGrade = false\r\n        this.showTextbook = false\r\n        this.showClassification = true\r\n        this.rules.classification[0].required = true\r\n      } else if (gradeLevel) {\r\n        this.showGrade = true\r\n        this.showTextbook = true\r\n        this.showClassification = false\r\n        this.rules.classification[0].required = false\r\n        this.setGradeOptions(gradeLevel)\r\n      } else {\r\n        this.showGrade = false\r\n        this.showTextbook = false\r\n        this.showClassification = false\r\n      }\r\n    },\r\n\r\n    handleAvatorSuccess(res) {\r\n      let _this = this;\r\n      if(res.code == 1000){\r\n        _this.$message({\r\n          type: 'success',\r\n          message: '上传成功!'\r\n        });\r\n        this.fileList.push({url:this.$store.state.configure.HOST + res.message})\r\n        this.form.image = res.message\r\n      }else{\r\n        _this.$notify.error({\r\n          title: '错误',\r\n          message: res.message\r\n        });\r\n      }\r\n    },\r\n    handleRemove(file, fileList) {\r\n      this.form.image = \"\"\r\n      this.fileList = []\r\n    },\r\n    handlePictureCardPreview(file) {\r\n      this.dialogImageUrl = file.url;\r\n      this.dialogVisible = true;\r\n    },\r\n    getUserListByType() {\r\n      getUserListByType({type:1}).then(res => {\r\n        if(res.code == 1000) {\r\n          this.teacher = res.data\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    getApeClassificationList() {\r\n      getApeClassificationList().then(res => {\r\n        if(res.code == 1000) {\r\n          this.classification = res.data\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    submit() {\r\n      this.$refs[\"ruleForm\"].validate((