{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeArticleById, removeApeArticle } from '../../../api/api';\nexport default {\n  data() {\n    return {\n      user: {},\n      articleId: \"\",\n      article: {}\n    };\n  },\n  methods: {\n    // 删除笔记\n    deleteArticle() {\n      this.$confirm('确定要删除这篇笔记吗？删除后无法恢复！', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        removeApeArticle({\n          ids: this.articleId\n        }).then(res => {\n          if (res.code == 1000) {\n            this.$message({\n              type: 'success',\n              message: '删除成功!'\n            });\n            // 延迟后返回笔记列表页\n            setTimeout(() => {\n              this.$router.push(\"/article\");\n            }, 1000);\n          } else {\n            this.$message.error(res.message || '删除失败');\n          }\n        }).catch(() => {\n          this.$message.error('删除失败，请稍后重试');\n        });\n      }).catch(() => {\n        this.$message.info('已取消删除');\n      });\n    },\n    editArticle(id) {\n      this.$router.push(\"/editArticle?id=\" + id);\n    },\n    getApeArticleById() {\n      getApeArticleById({\n        id: this.articleId\n      }).then(res => {\n        if (res.code == 1000) {\n          this.article = res.data;\n        }\n      });\n    }\n  },\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    var articleId = this.$route.query.id;\n    if (articleId) {\n      this.articleId = articleId;\n    }\n    this.getApeArticleById();\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\"));\n  }\n};","map":{"version":3,"names":["getApeArticleById","removeApeArticle","data","user","articleId","article","methods","deleteArticle","$confirm","confirmButtonText","cancelButtonText","type","then","ids","res","code","$message","message","setTimeout","$router","push","error","catch","info","editArticle","id","mounted","window","scrollTo","top","behavior","$route","query","JSON","parse","localStorage","getItem"],"sources":["src/views/system/article/articleInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"articleInfo-title\">\r\n        <div>\r\n          <div class=\"articleInfo-title1\">{{article.title}}</div>\r\n          <div class=\"articleInfo-title2\">{{article.createBy}} - {{article.createTime}}</div>\r\n        </div>\r\n      </div>\r\n      <div class=\"articleInfo-desc\">\r\n        <div class=\"articleInfo-desc1\">\r\n          <span style=\"font-weight:bold\">摘要：</span>{{article.articleDesc}}\r\n        </div>\r\n        <div class=\"articleInfo-desc2\">\r\n          <span style=\"font-weight:bold\">正文：</span>\r\n          <div v-html=\"article.content\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getApeArticleById, removeApeArticle } from '../../../api/api'\r\n\r\nexport default {\r\n  data() {\r\n    return{\r\n      user: {},\r\n      articleId: \"\",\r\n      article: {}\r\n    }\r\n  },\r\n  methods: {\r\n    // 删除笔记\r\n    deleteArticle() {\r\n      this.$confirm('确定要删除这篇笔记吗？删除后无法恢复！', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        removeApeArticle({ids: this.articleId}).then(res => {\r\n          if (res.code == 1000) {\r\n            this.$message({\r\n              type: 'success',\r\n              message: '删除成功!'\r\n            });\r\n            // 延迟后返回笔记列表页\r\n            setTimeout(() => {\r\n              this.$router.push(\"/article\")\r\n            }, 1000)\r\n          } else {\r\n            this.$message.error(res.message || '删除失败')\r\n          }\r\n        }).catch(() => {\r\n          this.$message.error('删除失败，请稍后重试')\r\n        })\r\n      }).catch(() => {\r\n        this.$message.info('已取消删除')\r\n      })\r\n    },\r\n    editArticle(id) {\r\n      this.$router.push(\"/editArticle?id=\" + id)\r\n    },\r\n    getApeArticleById() {\r\n      getApeArticleById({id: this.articleId}).then(res => {\r\n        if(res.code == 1000) {\r\n          this.article = res.data\r\n        }\r\n      })\r\n    }\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    var articleId = this.$route.query.id\r\n    if (articleId) {\r\n      this.articleId = articleId\r\n    }\r\n    this.getApeArticleById()\r\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\"))\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../../assets/css/articleInfo.css\");\r\n::v-deep img {\r\n  max-width: 100% !important;\r\n}\r\n</style>"],"mappings":";AAwBA,SAAAA,iBAAA,EAAAC,gBAAA;AAEA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,SAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,cAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACAX,gBAAA;UAAAY,GAAA,OAAAT;QAAA,GAAAQ,IAAA,CAAAE,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAC,QAAA;cACAL,IAAA;cACAM,OAAA;YACA;YACA;YACAC,UAAA;cACA,KAAAC,OAAA,CAAAC,IAAA;YACA;UACA;YACA,KAAAJ,QAAA,CAAAK,KAAA,CAAAP,GAAA,CAAAG,OAAA;UACA;QACA,GAAAK,KAAA;UACA,KAAAN,QAAA,CAAAK,KAAA;QACA;MACA,GAAAC,KAAA;QACA,KAAAN,QAAA,CAAAO,IAAA;MACA;IACA;IACAC,YAAAC,EAAA;MACA,KAAAN,OAAA,CAAAC,IAAA,sBAAAK,EAAA;IACA;IACAzB,kBAAA;MACAA,iBAAA;QAAAyB,EAAA,OAAArB;MAAA,GAAAQ,IAAA,CAAAE,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAV,OAAA,GAAAS,GAAA,CAAAZ,IAAA;QACA;MACA;IACA;EACA;EACAwB,QAAA;IACAC,MAAA,CAAAC,QAAA;MACAC,GAAA;MACAC,QAAA;IACA;IACA,IAAA1B,SAAA,QAAA2B,MAAA,CAAAC,KAAA,CAAAP,EAAA;IACA,IAAArB,SAAA;MACA,KAAAA,SAAA,GAAAA,SAAA;IACA;IACA,KAAAJ,iBAAA;IACA,KAAAG,IAAA,GAAA8B,IAAA,CAAAC,KAAA,CAAAP,MAAA,CAAAQ,YAAA,CAAAC,OAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}