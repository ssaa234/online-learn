{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeHomeworkPage, removeApeHomework } from '../../../api/api';\nimport add from '../../../components/system/homework/addHomework';\nimport update from '../../../components/system/homework/updateHomework';\nexport default {\n  data() {\n    return {\n      loading: true,\n      update: [],\n      remove: [],\n      updateId: \"\",\n      addVisible: false,\n      updateVisible: false,\n      chapterId: \"\",\n      // 章节ID（从路由传递）\n      search: {\n        chapterId: \"\",\n        taskName: \"\",\n        title: \"\",\n        type: \"\",\n        pageNumber: 1,\n        pageSize: 10\n      },\n      total: 0,\n      tableData: []\n    };\n  },\n  components: {\n    add,\n    update\n  },\n  methods: {\n    searchPage() {\n      this.search.pageNumber = 1;\n      this.query();\n    },\n    query() {\n      // 构建查询参数\n      const params = {\n        title: this.search.title,\n        type: this.search.type,\n        pageNumber: this.search.pageNumber,\n        pageSize: this.search.pageSize\n      };\n\n      // 如果有章节ID，则按章节ID筛选\n      if (this.chapterId) {\n        params.chapterId = this.chapterId;\n      }\n\n      // 如果有课程名称，则按课程名称筛选（仅在非章节页面显示）\n      if (this.search.taskName) {\n        params.taskName = this.search.taskName;\n      }\n      getApeHomeworkPage(params).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records;\n          this.total = res.data.total;\n          this.loading = false;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    refresh() {\n      this.search.title = \"\";\n      this.search.type = \"\";\n      if (!this.chapterId) {\n        this.search.taskName = \"\";\n      }\n      this.query();\n    },\n    handleCurrentChange(val) {\n      this.search.pageNumber = val;\n      this.query();\n    },\n    handleSizeChange(val) {\n      this.search.pageSize = val;\n      this.query();\n    },\n    handleSelectionChange(val) {\n      this.update = [];\n      this.remove = [];\n      for (let i = 0; i < val.length; i++) {\n        var item = val[i];\n        this.update.push(item.id);\n        this.remove.push(item.id);\n      }\n    },\n    add() {\n      this.addVisible = true;\n    },\n    addFalse() {\n      this.addVisible = false;\n      this.query();\n    },\n    updateFalse() {\n      this.updateId = '';\n      this.updateVisible = false;\n      this.query();\n    },\n    updateData(id) {\n      this.updateId = id;\n      this.updateVisible = true;\n    },\n    updateDataBtn() {\n      this.updateData(this.update[0]);\n    },\n    deleteDataBtn() {\n      this.$confirm('确定删除选中的' + this.remove.length + '条数据?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.deleteDate(this.remove.join(\",\"));\n      }).catch(() => {});\n    },\n    deleteDate(ids) {\n      removeApeHomework({\n        ids: ids\n      }).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '删除成功!'\n          });\n          this.pageNumber = 1;\n          this.query();\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    }\n  },\n  mounted() {\n    // 获取路由参数（支持两种方式：?id= 或 ?chapterId=）\n    const chapterId = this.$route.query.chapterId || this.$route.query.id;\n    const taskId = this.$route.query.taskId;\n    if (chapterId) {\n      this.chapterId = chapterId;\n      this.search.chapterId = chapterId;\n    }\n    console.log('章节ID:', this.chapterId);\n    console.log('课程ID:', taskId);\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeHomeworkPage","removeApeHomework","add","update","data","loading","remove","updateId","addVisible","updateVisible","chapterId","search","taskName","title","type","pageNumber","pageSize","total","tableData","components","methods","searchPage","query","params","then","res","code","records","$notify","error","message","refresh","handleCurrentChange","val","handleSizeChange","handleSelectionChange","i","length","item","push","id","addFalse","updateFalse","updateData","updateDataBtn","deleteDataBtn","$confirm","confirmButtonText","cancelButtonText","deleteDate","join","catch","ids","$message","mounted","$route","taskId","console","log"],"sources":["src/views/system/homework/homework.vue"],"sourcesContent":["<template>\r\n  <div class=\"_homework\">\r\n    <div class=\"search-table\">\r\n      <div class=\"search\">\r\n        <el-row :gutter=\"10\" style=\"padding:10px\">\r\n          <!-- 课程名称搜索（当从课程管理进入时显示，用于筛选） -->\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\" v-if=\"!chapterId\">\r\n            <span class=\"search-title\">课程名称:</span>\r\n            <el-input\r\n                style=\"margin-top:10px\"\r\n                size=\"mini\"\r\n                placeholder=\"请输入课程名称\"\r\n                v-model=\"search.taskName\">\r\n            </el-input>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\">\r\n            <span class=\"search-title\">题目:</span>\r\n            <el-input\r\n                style=\"margin-top:10px\"\r\n                size=\"mini\"\r\n                placeholder=\"请输入题目\"\r\n                v-model=\"search.title\">\r\n            </el-input>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\">\r\n            <span class=\"search-title\">类型:</span>\r\n            <el-select clearable style=\"margin-top:10px\" size=\"mini\" v-model=\"search.type\" placeholder=\"请选择\">\r\n              <el-option\r\n                  label=\"单选\"\r\n                  value=\"0\">\r\n              </el-option>\r\n              <el-option\r\n                  label=\"多选\"\r\n                  value=\"1\">\r\n              </el-option>\r\n              <el-option\r\n                  label=\"填空\"\r\n                  value=\"2\">\r\n              </el-option>\r\n              <el-option\r\n                  label=\"判断\"\r\n                  value=\"3\">\r\n              </el-option>\r\n            </el-select>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\">\r\n            <el-button style=\"margin-top:10px\" size=\"mini\" icon=\"el-icon-search\" type=\"primary\" @click=\"searchPage\">查询</el-button>\r\n            <el-button style=\"margin-top:10px\" size=\"mini\" icon=\"el-icon-refresh\" @click=\"refresh\">重置</el-button>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n      <div class=\"table\">\r\n        <el-row style=\"padding-top:10px;margin-left:10px\">\r\n          <el-button type=\"primary\" size=\"mini\" icon=\"el-icon-plus\" plain @click=\"add\">新增</el-button>\r\n          <el-button type=\"success\" :disabled=\"update.length != 1 ?true:false\" size=\"mini\" icon=\"el-icon-edit\" plain @click=\"updateDataBtn\">修改</el-button>\r\n          <el-button type=\"danger\" :disabled=\"update.length <= 0 ?true:false\" size=\"mini\" icon=\"el-icon-delete\" plain @click=\"deleteDataBtn\">删除</el-button>\r\n        </el-row>\r\n        <el-table\r\n            v-loading=\"loading\"\r\n            :data=\"tableData\"\r\n            :header-cell-style=\"{\r\n              'color': '#4A2B90',\r\n              'background-color': '#ECE9F4',\r\n            }\"\r\n            :row-style=\"{\r\n              'color': '#888897',\r\n              'font-size': '15px',\r\n              'font-family':'黑体',\r\n              'white-space': 'nowrap'\r\n            }\"\r\n            @selection-change=\"handleSelectionChange\"\r\n            stripe\r\n            style=\"width: 100%\">\r\n          <el-table-column\r\n              type=\"selection\"\r\n              width=\"55\">\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"chapterName\"\r\n              label=\"章节名称\"\r\n              width=\"180\"\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"title\"\r\n              label=\"题目\"\r\n              min-width=\"200\"\r\n              show-overflow-tooltip\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"sort\"\r\n              label=\"序号\"\r\n              width=\"80\"\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"answer\"\r\n              label=\"答案\"\r\n              width=\"150\"\r\n              show-overflow-tooltip\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"type\"\r\n              label=\"类型\"\r\n              width=\"80\"\r\n          >\r\n            <template slot-scope=\"scope\">\r\n              <el-tag v-if=\"scope.row.type == 0\">单选</el-tag>\r\n              <el-tag v-if=\"scope.row.type == 1\" type=\"warning\">多选</el-tag>\r\n              <el-tag v-if=\"scope.row.type == 2\" type=\"primary\">填空</el-tag>\r\n              <el-tag v-if=\"scope.row.type == 3\" type=\"success\">判断</el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"createTime\"\r\n              label=\"创建时间\"\r\n              width=\"160\"\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              label=\"操作\"\r\n              width=\"180\"\r\n              fixed=\"right\"\r\n          >\r\n            <template slot-scope=\"scope\">\r\n              <el-button size=\"mini\" type=\"success\" @click=\"updateData(scope.row.id)\">修改</el-button>\r\n              <el-popconfirm\r\n                  style=\"margin-left:5px\"\r\n                  confirm-button-text='确认'\r\n                  cancel-button-text='取消'\r\n                  icon=\"el-icon-info\"\r\n                  icon-color=\"red\"\r\n                  title=\"确认删除选中的数据？\"\r\n                  @confirm=\"deleteDate(scope.row.id)\"\r\n              >\r\n                <el-button size=\"mini\" slot=\"reference\" type=\"danger\">删除</el-button>\r\n              </el-popconfirm>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n        <el-pagination\r\n            background\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :page-sizes=\"[10, 20, 50, 100]\"\r\n            :page-size=\"search.pageSize\"\r\n            :current-page=\"search.pageNumber\"\r\n            @size-change=\"handleSizeChange\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <add @addFalse=\"addFalse\" :chapterId=\"search.chapterId\" :addVisible=\"addVisible\"></add>\r\n    <update @updateFalse=\"updateFalse\" :chapterId=\"search.chapterId\" :updateId=\"updateId\" :updateVisible=\"updateVisible\"></update>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeHomeworkPage, removeApeHomework} from '../../../api/api'\r\nimport add from '../../../components/system/homework/addHomework'\r\nimport update from '../../../components/system/homework/updateHomework'\r\nexport default {\r\n  data() {\r\n    return{\r\n      loading: true,\r\n      update: [],\r\n      remove: [],\r\n      updateId: \"\",\r\n      addVisible: false,\r\n      updateVisible: false,\r\n      chapterId: \"\",  // 章节ID（从路由传递）\r\n      search: {\r\n        chapterId: \"\",\r\n        taskName: \"\",\r\n        title: \"\",\r\n        type: \"\",\r\n        pageNumber: 1,\r\n        pageSize: 10\r\n      },\r\n      total: 0,\r\n      tableData: []\r\n    }\r\n  },\r\n  components: {\r\n    add,\r\n    update\r\n  },\r\n  methods: {\r\n    searchPage() {\r\n      this.search.pageNumber = 1\r\n      this.query()\r\n    },\r\n    query() {\r\n      // 构建查询参数\r\n      const params = {\r\n        title: this.search.title,\r\n        type: this.search.type,\r\n        pageNumber: this.search.pageNumber,\r\n        pageSize: this.search.pageSize\r\n      }\r\n\r\n      // 如果有章节ID，则按章节ID筛选\r\n      if (this.chapterId) {\r\n        params.chapterId = this.chapterId\r\n      }\r\n\r\n      // 如果有课程名称，则按课程名称筛选（仅在非章节页面显示）\r\n      if (this.search.taskName) {\r\n        params.taskName = this.search.taskName\r\n      }\r\n\r\n      getApeHomeworkPage(params).then(res => {\r\n        if(res.code == 1000) {\r\n          this.tableData = res.data.records\r\n          this.total = res.data.total\r\n          this.loading = false\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    refresh() {\r\n      this.search.title = \"\"\r\n      this.search.type = \"\"\r\n      if (!this.chapterId) {\r\n        this.search.taskName = \"\"\r\n      }\r\n      this.query()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.search.pageNumber = val\r\n      this.query()\r\n    },\r\n    handleSizeChange(val) {\r\n      this.search.pageSize = val\r\n      this.query()\r\n    },\r\n    handleSelectionChange(val) {\r\n      this.update = []\r\n      this.remove = []\r\n      for (let i = 0; i < val.length; i++) {\r\n        var item = val[i]\r\n        this.update.push(item.id)\r\n        this.remove.push(item.id)\r\n      }\r\n    },\r\n    add() {\r\n      this.addVisible = true\r\n    },\r\n    addFalse() {\r\n      this.addVisible = false\r\n      this.query()\r\n    },\r\n    updateFalse() {\r\n      this.updateId = ''\r\n      this.updateVisible = false\r\n      this.query()\r\n    },\r\n    updateData(id) {\r\n      this.updateId = id\r\n      this.updateVisible = true\r\n    },\r\n    updateDataBtn() {\r\n      this.updateData(this.update[0])\r\n    },\r\n    deleteDataBtn() {\r\n      this.$confirm('确定删除选中的'+ this.remove.length +'条数据?', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        this.deleteDate(this.remove.join(\",\"))\r\n      }).catch(() => {\r\n\r\n      });\r\n    },\r\n    deleteDate(ids) {\r\n      removeApeHomework({ids:ids}).then(res => {\r\n        if(res.code == 1000) {\r\n          this.$message({\r\n            type: 'success',\r\n            message: '删除成功!'\r\n          });\r\n          this.pageNumber = 1\r\n          this.query()\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n  },\r\n  mounted() {\r\n    // 获取路由参数（支持两种方式：?id= 或 ?chapterId=）\r\n    const chapterId = this.$route.query.chapterId || this.$route.query.id\r\n    const taskId = this.$route.query.taskId\r\n\r\n    if (chapterId) {\r\n      this.chapterId = chapterId\r\n      this.search.chapterId = chapterId\r\n    }\r\n\r\n    console.log('章节ID:', this.chapterId)\r\n    console.log('课程ID:', taskId)\r\n\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.search-table {\r\n  width: 100%;\r\n}\r\n.search {\r\n  background: #ffffff;\r\n  border-radius: 7px;\r\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,.1)\r\n}\r\n.table {\r\n  background: #ffffff;\r\n  border-radius: 7px;\r\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,.1);\r\n  margin-top: 10px\r\n}\r\n.el-col {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n}\r\n.search-title {\r\n  font-family: '黑体';\r\n  float: right;\r\n  white-space: nowrap;\r\n  font-size: 14px;\r\n  margin-top:10px;\r\n  width: 63px;\r\n  text-align: right;\r\n}\r\n.el-table {\r\n  padding: 10px;\r\n}\r\n.el-dialog__header {\r\n  border-bottom: 1px solid #F4F8F9 !important;\r\n}\r\n.el-dialog {\r\n  border-radius: 10px!important;\r\n}\r\n</style>"],"mappings":";AAgKA,SA