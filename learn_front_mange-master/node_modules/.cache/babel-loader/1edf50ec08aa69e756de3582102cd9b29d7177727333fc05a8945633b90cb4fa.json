{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeChapterPage, removeApeChapter } from '../../../api/api';\nimport add from '../../../components/system/chapter/addChapter';\nimport update from '../../../components/system/chapter/updateChapter';\nexport default {\n  data() {\n    return {\n      loading: true,\n      update: [],\n      remove: [],\n      updateId: \"\",\n      addVisible: false,\n      updateVisible: false,\n      taskId: \"\",\n      type: 1,\n      search: {\n        type: 1,\n        taskName: \"\",\n        name: \"\",\n        pageNumber: 1,\n        pageSize: 10\n      },\n      total: 0,\n      tableData: []\n    };\n  },\n  components: {\n    add,\n    update\n  },\n  methods: {\n    toStudyInfo(id) {\n      var param = {\n        \"name\": \"学习情况\",\n        \"url\": \"/chapterStudy?id=\" + id\n      };\n      this.$store.commit('menu/addActiveMenu', param);\n      this.$router.push(\"/chapterStudy?id=\" + id);\n      this.$store.commit('menu/setActiveMenu', \"/chapterStudy?id=\" + id);\n    },\n    toHomework(chapterId, chapterName, taskId) {\n      var param = {\n        \"name\": \"章节作业\",\n        // 改为固定名称，不再使用章节名称\n        \"url\": \"/homework?chapterId=\" + chapterId\n      };\n      console.log('跳转到作业页面:', param);\n      this.$store.commit('menu/addActiveMenu', param);\n      this.$router.push(\"/homework?chapterId=\" + chapterId);\n      this.$store.commit('menu/setActiveMenu', \"/homework?chapterId=\" + chapterId);\n    },\n    searchPage() {\n      this.search.pageNumber = 1;\n      this.query();\n    },\n    query() {\n      getApeChapterPage(this.search).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records;\n          this.total = res.data.total;\n          this.loading = false;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    refresh() {\n      this.search.taskName = \"\";\n      this.search.name = \"\";\n      this.query();\n    },\n    handleCurrentChange(val) {\n      this.search.pageNumber = val;\n      this.query();\n    },\n    handleSizeChange(val) {\n      this.search.pageSize = val;\n      this.query();\n    },\n    handleSelectionChange(val) {\n      this.update = [];\n      this.remove = [];\n      for (let i = 0; i < val.length; i++) {\n        var item = val[i];\n        this.update.push(item.id);\n        this.remove.push(item.id);\n      }\n    },\n    add() {\n      this.addVisible = true;\n    },\n    addFalse() {\n      this.addVisible = false;\n      this.query();\n    },\n    updateFalse() {\n      this.updateId = \"\";\n      this.updateVisible = false;\n      this.query();\n    },\n    updateData(id) {\n      this.updateId = id;\n      this.updateVisible = true;\n    },\n    updateDataBtn() {\n      this.updateData(this.update[0]);\n    },\n    deleteDataBtn() {\n      this.$confirm('确定删除选中的' + this.remove.length + '条数据?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.deleteDate(this.remove.join(\",\"));\n      }).catch(() => {});\n    },\n    deleteDate(ids) {\n      removeApeChapter({\n        ids: ids\n      }).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '删除成功!'\n          });\n          this.pageNumber = 1;\n          this.query();\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    }\n  },\n  mounted() {\n    var name = this.$route.query.name;\n    var id = this.$route.query.id;\n    var type = this.$route.query.type;\n    if (name) {\n      this.search.taskName = name;\n    }\n    if (id) {\n      this.taskId = id;\n    }\n    if (type) {\n      this.type = type;\n    }\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeChapterPage","removeApeChapter","add","update","data","loading","remove","updateId","addVisible","updateVisible","taskId","type","search","taskName","name","pageNumber","pageSize","total","tableData","components","methods","toStudyInfo","id","param","$store","commit","$router","push","toHomework","chapterId","chapterName","console","log","searchPage","query","then","res","code","records","$notify","error","title","message","refresh","handleCurrentChange","val","handleSizeChange","handleSelectionChange","i","length","item","addFalse","updateFalse","updateData","updateDataBtn","deleteDataBtn","$confirm","confirmButtonText","cancelButtonText","deleteDate","join","catch","ids","$message","mounted","$route"],"sources":["src/views/system/chapter/teacherChapter.vue"],"sourcesContent":["<template>\r\n  <div class=\"_chapter\">\r\n    <div class=\"search-table\">\r\n      <div class=\"search\">\r\n        <el-row :gutter=\"10\" style=\"padding:10px\">\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\">\r\n            <span class=\"search-title\">课程名称:</span>\r\n            <el-input\r\n                :disabled=\"type == 0? true:false\"\r\n                style=\"margin-top:10px\"\r\n                size=\"mini\"\r\n                placeholder=\"请输入课程名称\"\r\n                v-model=\"search.taskName\">\r\n            </el-input>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\">\r\n            <span class=\"search-title\">章节名称:</span>\r\n            <el-input\r\n                style=\"margin-top:10px\"\r\n                size=\"mini\"\r\n                placeholder=\"请输入章节名称\"\r\n                v-model=\"search.name\">\r\n            </el-input>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" :xl=\"8\">\r\n            <el-button style=\"margin-top:10px\" size=\"mini\" icon=\"el-icon-search\" type=\"primary\" @click=\"searchPage\">查询</el-button>\r\n            <el-button style=\"margin-top:10px\" size=\"mini\" icon=\"el-icon-refresh\" @click=\"refresh\">重置</el-button>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n      <div class=\"table\">\r\n        <el-row style=\"padding-top:10px;margin-left:10px\">\r\n          <el-button type=\"primary\" size=\"mini\" icon=\"el-icon-plus\" plain @click=\"add\">新增</el-button>\r\n          <el-button type=\"success\" :disabled=\"update.length != 1 ?true:false\" size=\"mini\" icon=\"el-icon-edit\" plain @click=\"updateDataBtn\">修改</el-button>\r\n          <el-button type=\"danger\" :disabled=\"update.length <= 0 ?true:false\" size=\"mini\" icon=\"el-icon-delete\" plain @click=\"deleteDataBtn\">删除</el-button>\r\n          <!-- <el-button type=\"warning\" size=\"mini\" icon=\"el-icon-download\" plain>导出</el-button> -->\r\n        </el-row>\r\n        <el-table\r\n            v-loading=\"loading\"\r\n            :data=\"tableData\"\r\n            :header-cell-style=\"{\r\n              'color': '#4A2B90',\r\n              'background-color': '#ECE9F4',\r\n            }\"\r\n            :row-style=\"{\r\n              'color': '#888897',\r\n              'font-size': '15px',\r\n              'font-family':'黑体',\r\n              'white-space': 'nowrap'\r\n            }\"\r\n            @selection-change=\"handleSelectionChange\"\r\n            stripe\r\n            style=\"width: 100%\">\r\n          <el-table-column\r\n              type=\"selection\"\r\n              width=\"55\">\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"taskName\"\r\n              label=\"课程名称\"\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"name\"\r\n              label=\"章节名称\"\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              prop=\"createTime\"\r\n              label=\"创建时间\"\r\n          >\r\n          </el-table-column>\r\n          <el-table-column\r\n              label=\"操作\"\r\n          >\r\n            <template slot-scope=\"scope\">\r\n              <el-button size=\"mini\" type=\"warning\" @click=\"toStudyInfo(scope.row.id)\">学习情况</el-button>\r\n              <!-- 修改这里：点击作业时传递章节ID和课程ID -->\r\n              <el-button size=\"mini\" type=\"primary\" @click=\"toHomework(scope.row.id, scope.row.taskId)\">作业</el-button>\r\n              <el-button size=\"mini\" type=\"success\" @click=\"updateData(scope.row.id)\">修改</el-button>\r\n              <el-popconfirm\r\n                  style=\"margin-left:5px\"\r\n                  confirm-button-text='确认'\r\n                  cancel-button-text='取消'\r\n                  icon=\"el-icon-info\"\r\n                  icon-color=\"red\"\r\n                  title=\"确认删除选中的数据？\"\r\n                  @confirm=\"deleteDate(scope.row.id)\"\r\n              >\r\n                <el-button size=\"mini\" slot=\"reference\" type=\"danger\">删除</el-button>\r\n              </el-popconfirm>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n        <el-pagination\r\n            background\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :page-sizes=\"[10, 20, 50, 100]\"\r\n            :page-size=\"search.pageSize\"\r\n            :current-page=\"search.pageNumber\"\r\n            @size-change=\"handleSizeChange\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <add @addFalse=\"addFalse\" flag=\"2\" :taskId = \"taskId\" :type = \"type\" :addVisible = \"addVisible\"></add>\r\n    <update @updateFalse=\"updateFalse\" flag=\"2\" :taskId = \"taskId\" :type = \"type\" :updateId = \"updateId\" :updateVisible = \"updateVisible\"></update>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeChapterPage,removeApeChapter} from '../../../api/api'\r\nimport add from '../../../components/system/chapter/addChapter'\r\nimport update from '../../../components/system/chapter/updateChapter'\r\nexport default {\r\n  data() {\r\n    return{\r\n      loading: true,\r\n      update: [],\r\n      remove: [],\r\n      updateId: \"\",\r\n      addVisible: false,\r\n      updateVisible: false,\r\n      taskId: \"\",\r\n      type: 1,\r\n      search: {\r\n        type:1,\r\n        taskName: \"\",\r\n        name: \"\",\r\n        pageNumber: 1,\r\n        pageSize:10\r\n      },\r\n      total: 0,\r\n      tableData: []\r\n    }\r\n  },\r\n  components: {\r\n    add,\r\n    update\r\n  },\r\n  methods: {\r\n    toStudyInfo(id) {\r\n      var param = {\r\n        \"name\": \"学习情况\",\r\n        \"url\": \"/chapterStudy?id=\" + id\r\n      }\r\n      this.$store.commit('menu/addActiveMenu', param)\r\n      this.$router.push(\"/chapterStudy?id=\" + id)\r\n      this.$store.commit('menu/setActiveMenu', \"/chapterStudy?id=\" + id)\r\n    },\r\n    toHomework(chapterId, chapterName, taskId) {\r\n      var param = {\r\n        \"name\": \"章节作业\",  // 改为固定名称，不再使用章节名称\r\n        \"url\": \"/homework?chapterId=\" + chapterId\r\n      }\r\n      console.log('跳转到作业页面:', param)\r\n      this.$store.commit('menu/addActiveMenu', param)\r\n      this.$router.push(\"/homework?chapterId=\" + chapterId)\r\n      this.$store.commit('menu/setActiveMenu', \"/homework?chapterId=\" + chapterId)\r\n    },\r\n    searchPage() {\r\n      this.search.pageNumber = 1\r\n      this.query()\r\n    },\r\n    query() {\r\n      getApeChapterPage(this.search).then(res => {\r\n        if(res.code == 1000) {\r\n          this.tableData = res.data.records\r\n          this.total = res.data.total\r\n          this.loading = false\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    refresh() {\r\n      this.search.taskName = \"\"\r\n      this.search.name = \"\"\r\n      this.query()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.search.pageNumber = val\r\n      this.query()\r\n    },\r\n    handleSizeChange(val) {\r\n      this.search.pageSize = val\r\n      this.query()\r\n    },\r\n    handleSelectionChange(val) {\r\n      this.update = []\r\n      this.remove = []\r\n      for (let i = 0;i < val.length;i++) {\r\n        var item = val[i]\r\n        this.update.push(item.id)\r\n        this.remove.push(item.id)\r\n      }\r\n    },\r\n    add() {\r\n      this.addVisible = true\r\n    },\r\n    addFalse() {\r\n      this.addVisible = false\r\n      this.query()\r\n    },\r\n    updateFalse() {\r\n      this.updateId = \"\"\r\n      this.updateVisible = false\r\n      this.query()\r\n    },\r\n    updateData(id) {\r\n      this.updateId = id\r\n      this.updateVisible = true\r\n    },\r\n    updateDataBtn() {\r\n      this.updateData(this.update[0])\r\n    },\r\n    deleteDataBtn() {\r\n      this.$confirm('确定删除选中的'+ this.remove.length +'条数据?', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        this.deleteDate(this.remove.join(\",\"))\r\n      }).catch(() => {\r\n\r\n      });\r\n    },\r\n    deleteDate(ids) {\r\n      removeApeChapter({ids:ids}).then(res => {\r\n        if(res.code == 1000) {\r\n          this.$message({\r\n            type: 'success',\r\n            message: '删除成功!'\r\n          });\r\n          this.pageNumber = 1\r\n          this.query()\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n  },\r\n  mounted() {\r\n    var name = this.$route.query.name\r\n    var id = this.$route.query.id\r\n    var type = this.$route.query.type\r\n    if (name) {\r\n      this.search.taskName = name\r\n    }\r\n    if (id) {\r\n      this.taskId = id\r\n    }\r\n    if (type) {\r\n      this.type = type\r\n    }\r\n    this.query()\r\n\r\n  }\r\n}\r\n</script>\r\n<style scoped>\r\n.search-table {\r\n  width: 100%;\r\n}\r\n.search {\r\n  background: #ffffff;\r\n  border-radius: 7px;\r\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,.1)\r\n}\r\n.table {\r\n  background: #ffffff;\r\n  border-radius: 7px;\r\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,.1);\r\n  margin-top: 10px\r\n}\r\n.el-col {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n}\r\n.search-title {\r\n  font-family: '黑体';\r\n  float: right;\r\n  white-space: nowrap;\r\n  font-size: 14px;\r\n  margin-top:10px;\r\n  width: 63px;\r\n  text-align: right;\r\n}\r\n.el-table {\r\n  padding: 10px;\r\n}\r\n.el-dialog__header {\r\n  border-bottom: 1px solid #F4F8F9 !important;\r\n}\r\n.el-dialog {\r\n  border-radius: 10px!important;\r\n}\r\n</style>"],"mappings":";AAgHA,SAAAA,iBAAA,EAAAC,gBAAA;AACA,OAAAC,GAAA;AACA,OAAAC,MAAA;AACA;EACAC,KAAA;IACA;MACAC,OAAA;MACAF,MAAA;MACAG,MAAA;MACAC,QAAA;MACAC,UAAA;MACAC,aAAA;MACAC,MAAA;MACAC,IAAA;MACAC,MAAA;QACAD,IAAA;QACAE,QAAA;QACAC,IAAA;QACAC,UAAA;QACAC,QAAA;MACA;MACAC,KAAA;MACAC,SAAA;IACA;EACA;EACAC,UAAA;IACAjB,GAAA;IACAC;EACA;EACAiB,OAAA;IACAC,YAAAC,EAAA;MACA,IAAAC,KAAA;QACA;QACA,6BAAAD;MACA;MACA,KAAAE,MAAA,CAAAC,MAAA,uBAAAF,KAAA;MACA,KAAAG,OAAA,CAAAC,IAAA,uBAAAL,EAAA;MACA,KAAAE,MAAA,CAAAC,MAAA,6CAAAH,EAAA;IACA;IACAM,WAAAC,SAAA,EAAAC,WAAA,EAAApB,MAAA;MACA,IAAAa,KAAA;QACA;QAAA;QACA,gCAAAM;MACA;MACAE,OAAA,CAAAC,GAAA,aAAAT,KAAA;MACA,KAAAC,MAAA,CAAAC,MAAA,uBAAAF,KAAA;MACA,KAAAG,OAAA,CAAAC,IAAA,0BAAAE,SAAA;MACA,KAAAL,MAAA,CAAAC,MAAA,gDAAAI,SAAA;IACA;IACAI,WAAA;MACA,KAAArB,MAAA,CAAAG,UAAA;MACA,KAAAmB,KAAA;IACA;IACAA,MAAA;MACAlC,iBAAA,MAAAY,MAAA,EAAAuB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAnB,SAAA,GAAAkB,GAAA,CAAAhC,IAAA,CAAAkC,OAAA;UACA,KAAArB,KAAA,GAAAmB,GAAA,CAAAhC,IAAA,CAAAa,KAAA;UACA,KAAAZ,OAAA;QACA;UACA,KAAAkC,OAAA,CAAAC,KAAA;YACAC,KAAA;YACAC,OAAA,EAAAN,GAAA,CAAAM;UACA;QACA;MACA;IACA;IACAC,QAAA;MACA,KAAA/B,MAAA,CAAAC,QAAA;MACA,KAAAD,MAAA,CAAAE,IAAA;MACA,KAAAoB,KAAA;IACA;IACAU,oBAAAC,GAA