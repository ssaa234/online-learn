{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeMyTaskList, saveApeArticle } from '../../api/api';\nimport { mixin } from '../../minix/index';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  mixins: [mixin],\n  data() {\n    return {\n      task: [],\n      routeTaskId: \"\",\n      // 从路由传递过来的课程ID\n      routeTaskName: \"\",\n      // 从路由传递过来的课程名称\n      isTaskDisabled: false,\n      // 课程选择框是否禁用\n      form: {\n        articleDesc: \"\",\n        content: \"\",\n        title: \"\",\n        taskId: \"\"\n      },\n      editorOption: {\n        placeholder: \"请输入文字内容\",\n        modules: {\n          toolbar: {\n            container: [[\"bold\", \"italic\", \"underline\", \"strike\"], [\"blockquote\", \"code-block\"], [{\n              header: 1\n            }, {\n              header: 2\n            }], [{\n              list: \"ordered\"\n            }, {\n              list: \"bullet\"\n            }], [{\n              script: \"sub\"\n            }, {\n              script: \"super\"\n            }], [{\n              indent: \"-1\"\n            }, {\n              indent: \"+1\"\n            }], [{\n              direction: \"rtl\"\n            }], [{\n              size: [\"small\", false, \"large\", \"huge\"]\n            }], [{\n              header: [1, 2, 3, 4, 5, 6, false]\n            }], [{\n              color: []\n            }, {\n              background: []\n            }], [{\n              font: []\n            }], [{\n              align: []\n            }], [\"clean\"], [\"image\"]],\n            handlers: {\n              'image': function (value) {\n                if (value) {\n                  document.querySelector('.Quill-uploader .el-upload__input').click();\n                } else {\n                  this.quill.format('image', false);\n                }\n              }\n            }\n          },\n          syntax: {\n            highlight: text => {\n              return hljs.highlightAuto(text).value;\n            }\n          }\n        }\n      }\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    getApeMyTaskList() {\n      var param = {\n        state: 0\n      };\n      getApeMyTaskList(param).then(res => {\n        if (res.code == 1000) {\n          this.task = res.data;\n          // 如果有从课程详情页传递的课程ID，自动选中并禁用选择框\n          if (this.routeTaskId) {\n            // 检查传递的课程ID是否在任务列表中\n            const taskExists = this.task.some(item => item.taskId === this.routeTaskId);\n            if (taskExists) {\n              this.form.taskId = this.routeTaskId;\n              this.isTaskDisabled = true;\n            } else {\n              this.$message({\n                message: '该课程不存在或您未报名',\n                type: 'warning'\n              });\n            }\n          }\n        }\n      });\n    },\n    submit() {\n      if (!this.form.title) {\n        this.$message({\n          message: '请输入笔记标题',\n          type: 'warning'\n        });\n        return;\n      }\n      if (!this.form.content) {\n        this.$message({\n          message: '请输入笔记内容',\n          type: 'warning'\n        });\n        return;\n      }\n      if (!this.form.articleDesc) {\n        this.$message({\n          message: '请输入笔记摘要',\n          type: 'warning'\n        });\n        return;\n      }\n      if (!this.form.taskId) {\n        this.$message({\n          message: '请选择所属课程',\n          type: 'warning'\n        });\n        return;\n      }\n      saveApeArticle(this.form).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            message: '发布成功',\n            type: 'success'\n          });\n          // 成功跳转回笔记列表\n          setTimeout(() => {\n            this.$router.push(\"/myArticle\");\n          }, 1500);\n        } else {\n          this.$message({\n            message: res.message || '发布失败',\n            type: 'error'\n          });\n        }\n      });\n    },\n    handleQillSuccess(res) {\n      let _this = this;\n      if (res.code == 1000) {\n        _this.$notify({\n          title: '上传成功',\n          type: 'success'\n        });\n        let imgurl = this.$store.state.HOST + res.message;\n        let quill = this.$refs.myQuillEditor.quill;\n        let position = quill.getSelection().index;\n        quill.insertEmbed(position, 'image', imgurl);\n        quill.setSelection(position + 1);\n      } else {\n        _this.$notify({\n          title: '上传失败',\n          type: 'error'\n        });\n      }\n    }\n  },\n  created() {\n    // 获取路由传递的参数\n    this.routeTaskId = this.$route.query.taskId || \"\";\n    this.routeTaskName = this.$route.query.taskName || \"\";\n    console.log('接收到的课程ID:', this.routeTaskId);\n    console.log('接收到的课程名称:', this.routeTaskName);\n\n    // 如果有课程ID，设置为禁用状态并自动填充\n    if (this.routeTaskId) {\n      this.isTaskDisabled = true;\n      this.form.taskId = this.routeTaskId;\n    }\n  },\n  mounted() {\n    this.getApeMyTaskList();\n  }\n};","map":{"version":3,"names":["getApeMyTaskList","saveApeArticle","mixin","headerPage","bottomPage","mixins","data","task","routeTaskId","routeTaskName","isTaskDisabled","form","articleDesc","content","title","taskId","editorOption","placeholder","modules","toolbar","container","header","list","script","indent","direction","size","color","background","font","align","handlers","image","value","document","querySelector","click","quill","format","syntax","highlight","text","hljs","highlightAuto","components","methods","param","state","then","res","code","taskExists","some","item","$message","message","type","submit","setTimeout","$router","push","handleQillSuccess","_this","$notify","imgurl","$store","HOST","$refs","myQuillEditor","position","getSelection","index","insertEmbed","setSelection","created","$route","query","taskName","console","log","mounted"],"sources":["src/views/article/addArticle.vue"],"sourcesContent":["<template>\r\n  <div class=\"addArticle\">\r\n    <headerPage></headerPage>\r\n    <div class=\"addArticle-content\">\r\n      <div class=\"addArticle-form\">\r\n        <div class=\"addArticle-title\">\r\n          记笔记\r\n        </div>\r\n        <div class=\"addArticle-list\">\r\n          <div class=\"addArticle-item\">\r\n            <div style=\"margin-top:10px;margin-left:10px\">标题</div>\r\n            <div style=\"margin-top:10px;margin-left:10px;margin-bottom:10px\">\r\n              <el-input size=\"mini\" v-model=\"form.title\" placeholder=\"请输入笔记标题\"></el-input>\r\n            </div>\r\n          </div>\r\n          <div class=\"addArticle-item\">\r\n            <div style=\"margin-top:10px;margin-left:10px\">所属课程</div>\r\n            <div style=\"margin-top:10px;margin-left:10px;margin-bottom:10px\">\r\n              <el-select\r\n                  size=\"mini\"\r\n                  v-model=\"form.taskId\"\r\n                  :disabled=\"isTaskDisabled\"\r\n                  placeholder=\"请选择所属课程\">\r\n                <el-option\r\n                    v-for=\"(item,index) in task\"\r\n                    :key=\"index\"\r\n                    :label=\"item.taskName\"\r\n                    :value=\"item.taskId\">\r\n                </el-option>\r\n              </el-select>\r\n              <!-- 显示从课程详情页传递的课程名称 -->\r\n              <div v-if=\"routeTaskName\" class=\"task-tip\">\r\n                当前课程：{{ routeTaskName }}\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"addArticle-item\">\r\n            <div style=\"margin-top:10px;margin-left:10px\">摘要</div>\r\n            <div style=\"margin-top:10px;margin-left:10px;margin-bottom:10px\">\r\n              <el-input type=\"textarea\" rows=5 v-model=\"form.articleDesc\" size=\"mini\" placeholder=\"请输入笔记摘要\"></el-input>\r\n            </div>\r\n          </div>\r\n          <div class=\"addArticle-item\" style=\"height:600px\">\r\n            <div style=\"margin-top:10px;margin-left:10px\">内容</div>\r\n            <div style=\"margin-top:10px;margin-left:10px;margin-bottom:10px\">\r\n              <quill-editor style=\"height:450px\" ref=\"myQuillEditor\" :options=\"editorOption\"\r\n                            v-model=\"form.content\"/>\r\n              <el-upload class=\"Quill-uploader\" :show-file-list=\"false\" accept=\"image/*\" v-show=\"0\" ref=\"updateUpload\" :multiple=\"false\" :action=\"uploadImageUrl()\"\r\n                         :on-success=\"handleQillSuccess\">\r\n              </el-upload>\r\n            </div>\r\n          </div>\r\n          <div style=\"margin-bottom:20px\">\r\n            <el-button @click=\"submit\" size=\"mini\" type=\"primary\">提交</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeMyTaskList, saveApeArticle} from '../../api/api'\r\nimport { mixin } from '../../minix/index';\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  mixins: [mixin],\r\n  data() {\r\n    return{\r\n      task: [],\r\n      routeTaskId: \"\",      // 从路由传递过来的课程ID\r\n      routeTaskName: \"\",    // 从路由传递过来的课程名称\r\n      isTaskDisabled: false, // 课程选择框是否禁用\r\n      form: {\r\n        articleDesc: \"\",\r\n        content: \"\",\r\n        title: \"\",\r\n        taskId: \"\",\r\n      },\r\n      editorOption: {\r\n        placeholder: \"请输入文字内容\",\r\n        modules: {\r\n          toolbar: {\r\n            container: [\r\n              [\"bold\", \"italic\", \"underline\", \"strike\"],\r\n              [\"blockquote\", \"code-block\"],\r\n              [{ header: 1 }, { header: 2 }],\r\n              [{ list: \"ordered\" }, { list: \"bullet\" }],\r\n              [{ script: \"sub\" }, { script: \"super\" }],\r\n              [{ indent: \"-1\" }, { indent: \"+1\" }],\r\n              [{ direction: \"rtl\" }],\r\n              [{ size: [\"small\", false, \"large\", \"huge\"] }],\r\n              [{ header: [1, 2, 3, 4, 5, 6, false] }],\r\n              [{ color: [] }, { background: [] }],\r\n              [{ font: [] }], [{ align: [] }],\r\n              [\"clean\"], [\"image\"]\r\n            ],\r\n            handlers: {\r\n              'image': function ( value ) {\r\n                if ( value ) {\r\n                  document.querySelector('.Quill-uploader .el-upload__input').click()\r\n                } else {\r\n                  this.quill.format( 'image', false );\r\n                }\r\n              }\r\n            }\r\n          },\r\n          syntax: {\r\n            highlight: text => {\r\n              return hljs.highlightAuto(text).value;\r\n            }\r\n          }\r\n        }\r\n      },\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    getApeMyTaskList() {\r\n      var param = {\r\n        state: 0\r\n      }\r\n      getApeMyTaskList(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.task = res.data\r\n          // 如果有从课程详情页传递的课程ID，自动选中并禁用选择框\r\n          if (this.routeTaskId) {\r\n            // 检查传递的课程ID是否在任务列表中\r\n            const taskExists = this.task.some(item => item.taskId === this.routeTaskId)\r\n            if (taskExists) {\r\n              this.form.taskId = this.routeTaskId\r\n              this.isTaskDisabled = true\r\n            } else {\r\n              this.$message({\r\n                message: '该课程不存在或您未报名',\r\n                type: 'warning'\r\n              })\r\n            }\r\n          }\r\n        }\r\n      })\r\n    },\r\n    submit() {\r\n      if (!this.form.title) {\r\n        this.$message({\r\n          message: '请输入笔记标题',\r\n          type: 'warning'\r\n        })\r\n        return\r\n      }\r\n      if (!this.form.content) {\r\n        this.$message({\r\n          message: '请输入笔记内容',\r\n          type: 'warning'\r\n        })\r\n        return\r\n      }\r\n      if (!this.form.articleDesc) {\r\n        this.$message({\r\n          message: '请输入笔记摘要',\r\n          type: 'warning'\r\n        })\r\n        return\r\n      }\r\n      if (!this.form.taskId) {\r\n        this.$message({\r\n          message: '请选择所属课程',\r\n          type: 'warning'\r\n        })\r\n        return\r\n      }\r\n      saveApeArticle(this.form).then(res => {\r\n        if(res.code == 1000) {\r\n          this.$message({\r\n            message: '发布成功',\r\n            type: 'success'\r\n          })\r\n          // 成功跳转回笔记列表\r\n          setTimeout(() => {\r\n            this.$router.push(\"/myArticle\")\r\n          }, 1500)\r\n        } else {\r\n          this.$message({\r\n            message: res.message || '发布失败',\r\n            type: 'error'\r\n          })\r\n        }\r\n      })\r\n    },\r\n    handleQillSuccess(res){\r\n      let _this = this;\r\n      if(res.code == 1000){\r\n        _this.$notify({\r\n          title: '上传成功',\r\n          type: 'success'\r\n        });\r\n        let imgurl = this.$store.state.HOST + res.message\r\n        let quill = this.$refs.myQuillEditor.quill\r\n        let position = quill.getSelection().index\r\n        quill.insertEmbed(position, 'image', imgurl)\r\n        quill.setSelection(position + 1)\r\n      }else{\r\n        _this.$notify({\r\n          title: '上传失败',\r\n          type: 'error'\r\n        });\r\n      }\r\n    },\r\n  },\r\n  created() {\r\n    // 获取路由传递的参数\r\n    this.routeTaskId = this.$route.query.taskId || \"\"\r\n    this.routeTaskName = this.$route.query.taskName || \"\"\r\n    console.log('接收到的课程ID:', this.routeTaskId)\r\n    console.log('接收到的课程名称:', this.routeTaskName)\r\n\r\n    // 如果有课程ID，设置为禁用状态并自动填充\r\n    if (this.routeTaskId) {\r\n      this.isTaskDisabled = true\r\n      this.form.taskId = this.routeTaskId\r\n    }\r\n  },\r\n  mounted() {\r\n    this.getApeMyTaskList()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/addArticle.css\");\r\n\r\n/* 新增样式 */\r\n.task-tip {\r\n  font-size: 12px;\r\n  color: #20B486;\r\n  margin-top: 5px;\r\n}\r\n</style>"],"mappings":";AA+DA,SAAAA,gBAAA,EAAAC,cAAA;AACA,SAAAC,KAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,MAAA,GAAAH,KAAA;EACAI,KAAA;IACA;MACAC,IAAA;MACAC,WAAA;MAAA;MACAC,aAAA;MAAA;MACAC,cAAA;MAAA;MACAC,IAAA;QACAC,WAAA;QACAC,OAAA;QACAC,KAAA;QACAC,MAAA;MACA;MACAC,YAAA;QACAC,WAAA;QACAC,OAAA;UACAC,OAAA;YACAC,SAAA,GACA,2CACA,8BACA;cAAAC,MAAA;YAAA;cAAAA,MAAA;YAAA,IACA;cAAAC,IAAA;YAAA;cAAAA,IAAA;YAAA,IACA;cAAAC,MAAA;YAAA;cAAAA,MAAA;YAAA,IACA;cAAAC,MAAA;YAAA;cAAAA,MAAA;YAAA,IACA;cAAAC,SAAA;YAAA,IACA;cAAAC,IAAA;YAAA,IACA;cAAAL,MAAA;YAAA,IACA;cAAAM,KAAA;YAAA;cAAAC,UAAA;YAAA,IACA;cAAAC,IAAA;YAAA;cAAAC,KAAA;YAAA,IACA,qBACA;YACAC,QAAA;cACA,kBAAAC,CAAAC,KAAA;gBACA,IAAAA,KAAA;kBACAC,QAAA,CAAAC,aAAA,sCAAAC,KAAA;gBACA;kBACA,KAAAC,KAAA,CAAAC,MAAA;gBACA;cACA;YACA;UACA;UACAC,MAAA;YACAC,SAAA,EAAAC,IAAA;cACA,OAAAC,IAAA,CAAAC,aAAA,CAAAF,IAAA,EAAAR,KAAA;YACA;UACA;QACA;MACA;IACA;EACA;EACAW,UAAA;IACAzC,UAAA;IACAC;EACA;EACAyC,OAAA;IACA7C,iBAAA;MACA,IAAA8C,KAAA;QACAC,KAAA;MACA;MACA/C,gBAAA,CAAA8C,KAAA,EAAAE,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAA3C,IAAA,GAAA0C,GAAA,CAAA3C,IAAA;UACA;UACA,SAAAE,WAAA;YACA;YACA,MAAA2C,UAAA,QAAA5C,IAAA,CAAA6C,IAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAtC,MAAA,UAAAP,WAAA;YACA,IAAA2C,UAAA;cACA,KAAAxC,IAAA,CAAAI,MAAA,QAAAP,WAAA;cACA,KAAAE,cAAA;YACA;cACA,KAAA4C,QAAA;gBACAC,OAAA;gBACAC,IAAA;cACA;YACA;UACA;QACA;MACA;IACA;IACAC,OAAA;MACA,UAAA9C,IAAA,CAAAG,KAAA;QACA,KAAAwC,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,UAAA7C,IAAA,CAAAE,OAAA;QACA,KAAAyC,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,UAAA7C,IAAA,CAAAC,WAAA;QACA,KAAA0C,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,UAAA7C,IAAA,CAAAI,MAAA;QACA,KAAAuC,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACAvD,cAAA,MAAAU,IAAA,EAAAqC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAI,QAAA;YACAC,OAAA;YACAC,IAAA;UACA;UACA;UACAE,UAAA;YACA,KAAAC,OAAA,