{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeArticlePage } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      title: \"\",\n      taskName: \"\",\n      pageSize: 10,\n      pageNumber: 1,\n      tableData: [],\n      total: 0\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    searchPage() {\n      this.pageNumber = 1;\n      this.query();\n    },\n    query() {\n      var param = {\n        state: 0,\n        title: this.title,\n        taskName: this.taskName,\n        pageSize: this.pageSize,\n        pageNumber: this.pageNumber,\n        type: 0\n      };\n      getApeArticlePage(param).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records || [];\n          this.total = res.data.total || 0;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      }).catch(err => {\n        this.$notify.error({\n          title: '错误',\n          message: '请求失败，请稍后重试'\n        });\n      });\n    },\n    refresh() {\n      this.title = \"\";\n      this.taskName = \"\";\n      this.pageNumber = 1;\n      this.query();\n    },\n    handleCurrentChange(val) {\n      this.pageNumber = val;\n      this.query();\n      // 滚动到顶部\n      window.scrollTo({\n        top: 0,\n        behavior: 'smooth'\n      });\n    },\n    toArticleInfo(id) {\n      this.$router.push(\"/articleInfo?id=\" + id);\n    },\n    /**\r\n     * 获取用户显示名称\r\n     * 优先级：userName > createBy > 匿名用户\r\n     */\n    getUserName(item) {\n      if (item.userName) {\n        return item.userName;\n      }\n      if (item.createBy) {\n        return item.createBy;\n      }\n      return '匿名用户';\n    },\n    /**\r\n     * 获取头像URL\r\n     */\n    getAvatarUrl(avatar) {\n      if (!avatar) {\n        // 返回默认头像\n        return require('../../assets/image/default-avatar.png');\n      }\n      // 如果头像已经是完整URL，直接返回；否则拼接HOST\n      if (avatar.startsWith('http')) {\n        return avatar;\n      }\n      return this.$store.state.HOST + avatar;\n    },\n    /**\r\n     * 格式化日期\r\n     */\n    formatDate(dateTime) {\n      if (!dateTime) return '';\n      try {\n        const date = new Date(dateTime);\n        const year = date.getFullYear();\n        const month = String(date.getMonth() + 1).padStart(2, '0');\n        const day = String(date.getDate()).padStart(2, '0');\n        return `${year}-${month}-${day}`;\n      } catch (e) {\n        return dateTime;\n      }\n    }\n  },\n  created() {},\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    var name = this.$route.query.name;\n    if (name) {\n      this.taskName = name;\n    }\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeArticlePage","headerPage","bottomPage","data","title","taskName","pageSize","pageNumber","tableData","total","components","methods","searchPage","query","param","state","type","then","res","code","records","$notify","error","message","catch","err","refresh","handleCurrentChange","val","window","scrollTo","top","behavior","toArticleInfo","id","$router","push","getUserName","item","userName","createBy","getAvatarUrl","avatar","require","startsWith","$store","HOST","formatDate","dateTime","date","Date","year","getFullYear","month","String","getMonth","padStart","day","getDate","e","created","mounted","name","$route"],"sources":["src/views/article/article.vue"],"sourcesContent":["<template>\r\n  <div class=\"article\">\r\n    <headerPage></headerPage>\r\n    <div class=\"article-page-content\">\r\n      <div class=\"article-page-search\">\r\n        <div style=\"width:30%;font-family:'黑体';display:flex;align-items:center;margin-top:15px;margin-left:10px;margin-bottom:10px\">\r\n          <div>笔记名称：</div>\r\n          <div>\r\n            <el-input size=\"mini\" v-model=\"title\" placeholder=\"请输入笔记名称：\"></el-input>\r\n          </div>\r\n        </div>\r\n        <div style=\"width:30%;font-family:'黑体';display:flex;align-items:center;margin-top:15px;margin-left:10px;margin-bottom:10px\">\r\n          <div>课程名称：</div>\r\n          <div>\r\n            <el-input size=\"mini\" v-model=\"taskName\" placeholder=\"请输入课程名称：\"></el-input>\r\n          </div>\r\n        </div>\r\n        <div class=\"article-page-btns\">\r\n          <el-button icon=\"el-icon-search\" size=\"mini\" type=\"primary\" plain @click=\"searchPage()\">搜索</el-button>\r\n          <el-button icon=\"el-icon-refresh\" size=\"mini\" type=\"warning\" plain @click=\"refresh()\">重置</el-button>\r\n        </div>\r\n      </div>\r\n      <div class=\"article-page-title\">\r\n        笔记列表\r\n      </div>\r\n      <div class=\"article-page-list\">\r\n        <div @click=\"toArticleInfo(item.id)\" v-for=\"(item,index) in tableData\" :key=\"index\" class=\"article-page-item\">\r\n          <div class=\"article-page-image\"><img src=\"../../assets/image/index/Vector (1).png\"></div>\r\n          <div class=\"article-page-user\">\r\n            <img class=\"article-page-avatar\" :src=\"getAvatarUrl(item.avatar)\">\r\n            <div class=\"article-page-username\">\r\n              <div class=\"article-page-userinfo\">\r\n                <span class=\"article-page-username-text\">{{ getUserName(item) }}</span>\r\n                <span class=\"article-page-time\">{{ formatDate(item.createTime) }}</span>\r\n              </div>\r\n              <div class=\"article-page-title-text\">{{ item.title }}</div>\r\n            </div>\r\n          </div>\r\n          <div class=\"article-page-font\">\r\n            {{ item.articleDesc }}\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"article-page-fenye\">\r\n        <el-pagination\r\n            background\r\n            :page-size=\"pageSize\"\r\n            layout=\"prev, pager, next\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeArticlePage} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      title: \"\",\r\n      taskName: \"\",\r\n      pageSize: 10,\r\n      pageNumber: 1,\r\n      tableData: [],\r\n      total: 0,\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    searchPage() {\r\n      this.pageNumber = 1\r\n      this.query()\r\n    },\r\n    query() {\r\n      var param = {\r\n        state: 0,\r\n        title: this.title,\r\n        taskName: this.taskName,\r\n        pageSize: this.pageSize,\r\n        pageNumber: this.pageNumber,\r\n        type: 0,\r\n      }\r\n      getApeArticlePage(param).then(res => {\r\n        if(res.code == 1000) {\r\n          this.tableData = res.data.records || []\r\n          this.total = res.data.total || 0\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      }).catch(err => {\r\n        this.$notify.error({\r\n          title: '错误',\r\n          message: '请求失败，请稍后重试'\r\n        });\r\n      })\r\n    },\r\n    refresh() {\r\n      this.title = \"\"\r\n      this.taskName = \"\"\r\n      this.pageNumber = 1\r\n      this.query()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pageNumber = val\r\n      this.query()\r\n      // 滚动到顶部\r\n      window.scrollTo({\r\n        top: 0,\r\n        behavior: 'smooth'\r\n      });\r\n    },\r\n    toArticleInfo(id) {\r\n      this.$router.push(\"/articleInfo?id=\"+id)\r\n    },\r\n    /**\r\n     * 获取用户显示名称\r\n     * 优先级：userName > createBy > 匿名用户\r\n     */\r\n    getUserName(item) {\r\n      if (item.userName) {\r\n        return item.userName\r\n      }\r\n      if (item.createBy) {\r\n        return item.createBy\r\n      }\r\n      return '匿名用户'\r\n    },\r\n    /**\r\n     * 获取头像URL\r\n     */\r\n    getAvatarUrl(avatar) {\r\n      if (!avatar) {\r\n        // 返回默认头像\r\n        return require('../../assets/image/default-avatar.png')\r\n      }\r\n      // 如果头像已经是完整URL，直接返回；否则拼接HOST\r\n      if (avatar.startsWith('http')) {\r\n        return avatar\r\n      }\r\n      return this.$store.state.HOST + avatar\r\n    },\r\n    /**\r\n     * 格式化日期\r\n     */\r\n    formatDate(dateTime) {\r\n      if (!dateTime) return ''\r\n      try {\r\n        const date = new Date(dateTime)\r\n        const year = date.getFullYear()\r\n        const month = String(date.getMonth() + 1).padStart(2, '0')\r\n        const day = String(date.getDate()).padStart(2, '0')\r\n        return `${year}-${month}-${day}`\r\n      } catch (e) {\r\n        return dateTime\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    var name = this.$route.query.name\r\n    if (name) {\r\n      this.taskName = name\r\n    }\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/article.css\");\r\n\r\n/* 添加额外样式 */\r\n.article-page-userinfo {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.article-page-username-text {\r\n  font-weight: 500;\r\n  color: #333;\r\n  font-size: 14px;\r\n}\r\n\r\n.article-page-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.article-page-title-text {\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n  color: #2c3e50;\r\n  margin-top: 5px;\r\n}\r\n\r\n.article-page-avatar {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n  margin-right: 12px;\r\n  border: 1px solid #eee;\r\n}\r\n</style>"],"mappings":";AA0DA,SAAAA,iBAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,KAAA;MACAC,QAAA;MACAC,QAAA;MACAC,UAAA;MACAC,SAAA;MACAC,KAAA;IACA;EACA;EACAC,UAAA;IACAT,UAAA;IACAC;EACA;EACAS,OAAA;IACAC,WAAA;MACA,KAAAL,UAAA;MACA,KAAAM,KAAA;IACA;IACAA,MAAA;MACA,IAAAC,KAAA;QACAC,KAAA;QACAX,KAAA,OAAAA,KAAA;QACAC,QAAA,OAAAA,QAAA;QACAC,QAAA,OAAAA,QAAA;QACAC,UAAA,OAAAA,UAAA;QACAS,IAAA;MACA;MACAhB,iBAAA,CAAAc,KAAA,EAAAG,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAX,SAAA,GAAAU,GAAA,CAAAf,IAAA,CAAAiB,OAAA;UACA,KAAAX,KAAA,GAAAS,GAAA,CAAAf,IAAA,CAAAM,KAAA;QACA;UACA,KAAAY,OAAA,CAAAC,KAAA;YACAlB,KAAA;YACAmB,OAAA,EAAAL,GAAA,CAAAK;UACA;QACA;MACA,GAAAC,KAAA,CAAAC,GAAA;QACA,KAAAJ,OAAA,CAAAC,KAAA;UACAlB,KAAA;UACAmB,OAAA;QACA;MACA;IACA;IACAG,QAAA;MACA,KAAAtB,KAAA;MACA,KAAAC,QAAA;MACA,KAAAE,UAAA;MACA,KAAAM,KAAA;IACA;IACAc,oBAAAC,GAAA;MACA,KAAArB,UAAA,GAAAqB,GAAA;MACA,KAAAf,KAAA;MACA;MACAgB,MAAA,CAAAC,QAAA;QACAC,GAAA;QACAC,QAAA;MACA;IACA;IACAC,cAAAC,EAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,sBAAAF,EAAA;IACA;IACA;AACA;AACA;AACA;IACAG,YAAAC,IAAA;MACA,IAAAA,IAAA,CAAAC,QAAA;QACA,OAAAD,IAAA,CAAAC,QAAA;MACA;MACA,IAAAD,IAAA,CAAAE,QAAA;QACA,OAAAF,IAAA,CAAAE,QAAA;MACA;MACA;IACA;IACA;AACA;AACA;IACAC,aAAAC,MAAA;MACA,KAAAA,MAAA;QACA;QACA,OAAAC,OAAA;MACA;MACA;MACA,IAAAD,MAAA,CAAAE,UAAA;QACA,OAAAF,MAAA;MACA;MACA,YAAAG,MAAA,CAAA9B,KAAA,CAAA+B,IAAA,GAAAJ,MAAA;IACA;IACA;AACA;AACA;IACAK,WAAAC,QAAA;MACA,KAAAA,QAAA;MACA;QACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,QAAA;QACA,MAAAG,IAAA,GAAAF,IAAA,CAAAG,WAAA;QACA,MAAAC,KAAA,GAAAC,MAAA,CAAAL,IAAA,CAAAM,QAAA,QAAAC,QAAA;QACA,MAAAC,GAAA,GAAAH,MAAA,CAAAL,IAAA,CAAAS,OAAA,IAAAF,QAAA;QACA,UAAAL,IAAA,IAAAE,KAAA,IAAAI,GAAA;MACA,SAAAE,CAAA;QACA,OAAAX,QAAA;MACA;IACA;EACA;EACAY,QAAA,GAEA;EACAC,QAAA;IACAhC,MAAA,CAAAC,QAAA;MACAC,GAAA;MACAC,QAAA;IACA;IACA,IAAA8B,IAAA,QAAAC,MAAA,CAAAlD,KAAA,CAAAiD,IAAA;IACA,IAAAA,IAAA;MACA,KAAAzD,QAAA,GAAAyD,IAAA;IACA;IACA,KAAAjD,KAAA;EACA;AACA"},"metadata":{},"