{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\n/*import { register, sendSmsCode, verifySmsCode } from '../../api/api'*/\nimport bottomPage from \"../../components/bottom/login-bottom\";\nexport default {\n  data() {\n    // 自定义验证规则：手机号格式\n    const validatePhone = (rule, value, callback) => {\n      if (!value) {\n        callback(new Error('请输入手机号'));\n      } else if (!/^1[3-9]\\d{9}$/.test(value)) {\n        callback(new Error('请输入正确的11位手机号'));\n      } else {\n        callback();\n      }\n    };\n\n    // 自定义验证规则：验证码\n    const validateVerifyCode = (rule, value, callback) => {\n      if (!value) {\n        callback(new Error('请输入验证码'));\n      } else if (!/^\\d{6}$/.test(value)) {\n        callback(new Error('验证码为6位数字'));\n      } else {\n        callback();\n      }\n    };\n    return {\n      userInfo: {\n        userName: \"\",\n        password: \"\",\n        passwordNew: \"\",\n        loginAccount: \"\",\n        phone: \"\",\n        verifyCode: \"\",\n        userType: 2\n      },\n      countdown: 0,\n      // 倒计时秒数\n      rules: {\n        userName: [{\n          required: true,\n          message: '请输入姓名',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 20,\n          message: '姓名长度在2-20个字符之间',\n          trigger: 'blur'\n        }],\n        loginAccount: [{\n          required: true,\n          message: '请输入用户账号',\n          trigger: 'blur'\n        }, {\n          min: 4,\n          max: 20,\n          message: '账号长度在4-20个字符之间',\n          trigger: 'blur'\n        }],\n        phone: [{\n          required: true,\n          validator: validatePhone,\n          trigger: 'blur'\n        }],\n        verifyCode: [{\n          required: true,\n          validator: validateVerifyCode,\n          trigger: 'blur'\n        }],\n        password: [{\n          required: true,\n          message: '请输入用户密码',\n          trigger: 'blur'\n        }, {\n          min: 6,\n          max: 20,\n          message: '密码长度在6-20个字符之间',\n          trigger: 'blur'\n        }],\n        passwordNew: [{\n          required: true,\n          message: '请输入确认密码',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  components: {\n    bottomPage\n  },\n  methods: {\n    toLogin() {\n      this.$router.push(\"/login\");\n    },\n    toTeacherRegister() {\n      this.$router.push(\"/teacherRegister\");\n    },\n    // 发送验证码\n    async sendVerifyCode() {\n      // 先验证手机号\n      if (!this.userInfo.phone) {\n        this.$message.error('请先输入手机号');\n        return;\n      }\n      if (!/^1[3-9]\\d{9}$/.test(this.userInfo.phone)) {\n        this.$message.error('请输入正确的手机号格式');\n        return;\n      }\n      try {\n        const res = await sendSmsCode({\n          phone: this.userInfo.phone,\n          type: 'register' // 标识是注册的验证码\n        });\n\n        if (res.code === 1000) {\n          this.$message.success('验证码已发送');\n          // 开始倒计时\n          this.countdown = 60;\n          const timer = setInterval(() => {\n            if (this.countdown <= 1) {\n              clearInterval(timer);\n              this.countdown = 0;\n            } else {\n              this.countdown--;\n            }\n          }, 1000);\n        } else {\n          this.$message.error(res.message || '发送失败，请稍后重试');\n        }\n      } catch (error) {\n        this.$message.error('发送失败，请稍后重试');\n      }\n    },\n    // 注册\n    toRegister() {\n      this.$refs[\"ruleForm\"].validate(async valid => {\n        if (valid) {\n          // 验证密码一致性\n          if (this.userInfo.password != this.userInfo.passwordNew) {\n            this.$message({\n              message: '两次输入的密码不一致！',\n              type: 'warning'\n            });\n            return;\n          }\n\n          // 先验证验证码\n          try {\n            const verifyRes = await verifySmsCode({\n              phone: this.userInfo.phone,\n              code: this.userInfo.verifyCode,\n              type: 'register'\n            });\n            if (verifyRes.code !== 1000) {\n              this.$message.error(verifyRes.message || '验证码错误');\n              return;\n            }\n\n            // 验证码正确，执行注册\n            const registerRes = await register(this.userInfo);\n            if (registerRes.code == 1000) {\n              this.$message({\n                message: '注册成功',\n                type: 'success'\n              });\n              var that = this;\n              setTimeout(function () {\n                that.$router.push(\"/login\");\n              }, 500);\n            } else {\n              this.$message.error(registerRes.message);\n            }\n          } catch (error) {\n            this.$message.error('验证码验证失败，请稍后重试');\n          }\n        } else {\n          return false;\n        }\n      });\n    }\n  },\n  created() {},\n  mounted() {}\n};","map":{"version":3,"names":["bottomPage","data","validatePhone","rule","value","callback","Error","test","validateVerifyCode","userInfo","userName","password","passwordNew","loginAccount","phone","verifyCode","userType","countdown","rules","required","message","trigger","min","max","validator","components","methods","toLogin","$router","push","toTeacherRegister","sendVerifyCode","$message","error","res","sendSmsCode","type","code","success","timer","setInterval","clearInterval","toRegister","$refs","validate","valid","verifyRes","verifySmsCode","registerRes","register","that","setTimeout","created","mounted"],"sources":["src/views/register/register.vue"],"sourcesContent":["<template>\r\n  <div class=\"login\">\r\n    <div class=\"login-top\">\r\n      <div class=\"logo\"></div>\r\n      <div class=\"btns\">\r\n        <div style=\"padding-right:100px;display:flex\">\r\n          <div class=\"toReg\" @click=\"toLogin\">\r\n            <div>登陆</div>\r\n          </div>\r\n          <div class=\"toRegTeacher\" @click=\"toTeacherRegister\">\r\n            <div>教师入驻</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"login-center\">\r\n      <div class=\"login-content\">\r\n        <div style=\"padding-left: 100px;\">\r\n          <div class=\"title\">\r\n            <div>STUDY ONLINE </div>\r\n            <div>WITH EXPERT</div>\r\n          </div>\r\n          <div style=\"color:#181818;font-family:'黑体'\">K12编程新乐园，师生线上共筑编程梦</div>\r\n          <div style=\"margin-top:20px;color:#181818;font-family:'黑体';text-indent:2em;\">欢迎来到 K12 信息技术编程的精彩世界！我们的在线平台是师生互动的活力空间。老师们能在此轻松授课，分享丰富编程资源，为学生的编程学习引路导航。学生们既可以在课堂上跟随老师的讲解探索代码奥秘，也能在课后自主搜索资源，开启自学之旅。独自钻研时，如同在编程宇宙中独自探险，发现无限可能；与同学交流学习时，就像组建编程小战队，思维碰撞间激发创新火花，一起在编程的天地里快乐成长！</div>\r\n          <div style=\"margin-top:30px;display:flex;justify-content: space-between\">\r\n            <img style=\"width:20%\" src=\"../../assets/image/login_image.png\">\r\n            <img style=\"width:25%;padding-right:30px\" src=\"../../assets/image/login-jiantou.png\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"login-form\">\r\n        <div class=\"jiantou1\">\r\n          <img src=\"../../assets/image/jiantou1.png\">\r\n        </div>\r\n        <div class=\"jiantou2\">\r\n          <img src=\"../../assets/image/jiantou2.png\">\r\n        </div>\r\n        <div class=\"yuan\">\r\n          <img src=\"../../assets/image/yuan.png\">\r\n        </div>\r\n        <div class=\"form\">\r\n          <div class=\"login-title\">K12信息技术编程在线学习平台</div>\r\n          <div style=\"width:100%\">\r\n            <el-form style=\"width:100%\" :model=\"userInfo\" :rules=\"rules\" ref=\"ruleForm\" class=\"demo-ruleForm\">\r\n              <el-form-item prop=\"userName\">\r\n                <el-input v-model=\"userInfo.userName\" placeholder=\"请输入姓名\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item prop=\"loginAccount\">\r\n                <el-input v-model=\"userInfo.loginAccount\" placeholder=\"请输入用户账号\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item prop=\"phone\">\r\n                <el-input v-model=\"userInfo.phone\" placeholder=\"请输入手机号\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item prop=\"verifyCode\">\r\n                <div class=\"verify-code-input\">\r\n                  <el-input v-model=\"userInfo.verifyCode\" placeholder=\"请输入验证码\"></el-input>\r\n                  <el-button\r\n                      :disabled=\"countdown > 0\"\r\n                      @click=\"sendVerifyCode\"\r\n                      class=\"send-code-btn\">\r\n                    {{ countdown > 0 ? `${countdown}秒后重试` : '发送验证码' }}\r\n                  </el-button>\r\n                </div>\r\n              </el-form-item>\r\n              <el-form-item prop=\"password\">\r\n                <el-input type=\"password\" v-model=\"userInfo.password\" placeholder=\"请输入用户密码\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item prop=\"passwordNew\">\r\n                <el-input type=\"password\" v-model=\"userInfo.passwordNew\" placeholder=\"请输入确认密码\"></el-input>\r\n              </el-form-item>\r\n            </el-form>\r\n          </div>\r\n          <div class=\"login-btn\" @click=\"toRegister()\">\r\n            <div>注 册</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n/*import { register, sendSmsCode, verifySmsCode } from '../../api/api'*/\r\nimport bottomPage from \"../../components/bottom/login-bottom\"\r\nexport default {\r\n  data() {\r\n    // 自定义验证规则：手机号格式\r\n    const validatePhone = (rule, value, callback) => {\r\n      if (!value) {\r\n        callback(new Error('请输入手机号'))\r\n      } else if (!/^1[3-9]\\d{9}$/.test(value)) {\r\n        callback(new Error('请输入正确的11位手机号'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    // 自定义验证规则：验证码\r\n    const validateVerifyCode = (rule, value, callback) => {\r\n      if (!value) {\r\n        callback(new Error('请输入验证码'))\r\n      } else if (!/^\\d{6}$/.test(value)) {\r\n        callback(new Error('验证码为6位数字'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    return{\r\n      userInfo: {\r\n        userName: \"\",\r\n        password: \"\",\r\n        passwordNew: \"\",\r\n        loginAccount: \"\",\r\n        phone: \"\",\r\n        verifyCode: \"\",\r\n        userType: 2\r\n      },\r\n      countdown: 0,  // 倒计时秒数\r\n      rules: {\r\n        userName: [\r\n          { required: true, message: '请输入姓名', trigger: 'blur' },\r\n          { min: 2, max: 20, message: '姓名长度在2-20个字符之间', trigger: 'blur' }\r\n        ],\r\n        loginAccount: [\r\n          { required: true, message: '请输入用户账号', trigger: 'blur' },\r\n          { min: 4, max: 20, message: '账号长度在4-20个字符之间', trigger: 'blur' }\r\n        ],\r\n        phone: [\r\n          { required: true, validator: validatePhone, trigger: 'blur' }\r\n        ],\r\n        verifyCode: [\r\n          { required: true, validator: validateVerifyCode, trigger: 'blur' }\r\n        ],\r\n        password: [\r\n          { required: true, message: '请输入用户密码', trigger: 'blur' },\r\n          { min: 6, max: 20, message: '密码长度在6-20个字符之间', trigger: 'blur' }\r\n        ],\r\n        passwordNew: [\r\n          { required: true, message: '请输入确认密码', trigger: 'blur' }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  components: {\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    toLogin() {\r\n      this.$router.push(\"/login\")\r\n    },\r\n    toTeacherRegister() {\r\n      this.$router.push(\"/teacherRegister\")\r\n    },\r\n\r\n    // 发送验证码\r\n    async sendVerifyCode() {\r\n      // 先验证手机号\r\n      if (!this.userInfo.phone) {\r\n        this.$message.error('请先输入手机号')\r\n        return\r\n      }\r\n      if (!/^1[3-9]\\d{9}$/.test(this.userInfo.phone)) {\r\n        this.$message.error('请输入正确的手机号格式')\r\n        return\r\n      }\r\n\r\n      try {\r\n        const res = await sendSmsCode({\r\n          phone: this.userInfo.phone,\r\n          type: 'register'  // 标识是注册的验证码\r\n        })\r\n\r\n        if (res.code === 1000) {\r\n          this.$message.success('验证码已发送')\r\n          // 开始倒计时\r\n          this.countdown = 60\r\n          const timer = setInterval(() => {\r\n            if (this.countdown <= 1) {\r\n              clearInterval(timer)\r\n              this.countdown = 0\r\n            } else {\r\n              this.countdown--\r\n            }\r\n          }, 1000)\r\n        } else {\r\n          this.$message.error(res.message || '发送失败，请稍后重试')\r\n        }\r\n      } catch (error) {\r\n        this.$message.error('发送失败，请稍后重试')\r\n      }\r\n    },\r\n\r\n    // 注册\r\n    toRegister() {\r\n      this.$refs[\"ruleForm\"].validate(async (valid) => {\r\n        if (valid) {\r\n          // 验证密码一致性\r\n          if (this.userInfo.password != this.userInfo.passwordNew) {\r\n            this.$message({\r\n              message: '两次输入的密码不一致！',\r\n              type: 'warning'\r\n            });\r\n            return;\r\n          }\r\n\r\n          // 先验证验证码\r\n          try {\r\n            const verifyRes = await verifySmsCode({\r\n              phone: this.userInfo.phone,\r\n              code: this.userInfo.verifyCode,\r\n              type: 'register'\r\n            })\r\n\r\n            if (verifyRes.code !== 1000) {\r\n              this.$message.error(verifyRes.message || '验证码错误')\r\n              return\r\n            }\r\n\r\n            // 验证码正确，执行注册\r\n            const registerRes = await register(this.userInfo)\r\n            if (registerRes.code == 1000) {\r\n              this.$message({\r\n                message: '注册成功',\r\n                type: 'success'\r\n              });\r\n              var that = this\r\n              setTimeout(function() {\r\n                that.$router.push(\"/login\")\r\n              }, 500)\r\n            } else {\r\n              this.$message.error(registerRes.message);\r\n            }\r\n          } catch (error) {\r\n            this.$message.error('验证码验证失败，请稍后重试')\