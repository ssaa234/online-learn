{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { saveApeArticleFavor, removeApeArticleFavor, getApeArticleById, saveApeArticleComment, getApeArticleCommentByArticleId, removeApeArticle } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      user: {},\n      articleId: \"\",\n      article: {},\n      content: \"\",\n      commentList: []\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    // 删除笔记\n    deleteArticle() {\n      this.$confirm('确定要删除这篇笔记吗？删除后无法恢复！', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        removeApeArticle({\n          ids: this.articleId\n        }).then(res => {\n          if (res.code == 1000) {\n            this.$message({\n              type: 'success',\n              message: '删除成功!'\n            });\n            // 延迟后返回上一页\n            setTimeout(() => {\n              this.$router.go(-1);\n            }, 1000);\n          } else {\n            this.$message.error(res.message || '删除失败');\n          }\n        });\n      }).catch(() => {\n        this.$message.info('已取消删除');\n      });\n    },\n    getApeArticleCommentByArticleId() {\n      getApeArticleCommentByArticleId({\n        id: this.articleId\n      }).then(res => {\n        if (res.code == 1000) {\n          this.commentList = res.data;\n        }\n      });\n    },\n    getApeArticleById() {\n      getApeArticleById({\n        id: this.articleId\n      }).then(res => {\n        if (res.code == 1000) {\n          this.article = res.data;\n        }\n      });\n    },\n    saveApeArticleComment() {\n      if (!this.content.trim()) {\n        this.$message.warning('请输入评论内容');\n        return;\n      }\n      var param = {\n        taskId: this.articleId,\n        content: this.content\n      };\n      saveApeArticleComment(param).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '评论成功!'\n          });\n          this.content = \"\";\n          this.getApeArticleCommentByArticleId();\n        }\n      });\n    },\n    editArticle() {\n      this.$router.push(\"/editArticle?id=\" + this.articleId);\n    }\n  },\n  created() {},\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    var articleId = this.$route.query.id;\n    if (articleId) {\n      this.articleId = articleId;\n    }\n    this.getApeArticleById();\n    this.getApeArticleCommentByArticleId();\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\"));\n  }\n};","map":{"version":3,"names":["saveApeArticleFavor","removeApeArticleFavor","getApeArticleById","saveApeArticleComment","getApeArticleCommentByArticleId","removeApeArticle","headerPage","bottomPage","data","user","articleId","article","content","commentList","components","methods","deleteArticle","$confirm","confirmButtonText","cancelButtonText","type","then","ids","res","code","$message","message","setTimeout","$router","go","error","catch","info","id","trim","warning","param","taskId","editArticle","push","created","mounted","window","scrollTo","top","behavior","$route","query","JSON","parse","localStorage","getItem"],"sources":["src/views/article/articleInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <headerPage></headerPage>\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"articleInfo-title\">\r\n        <div>\r\n          <div class=\"articleInfo-title1\">{{article.title}}</div>\r\n          <div class=\"articleInfo-title2\">{{article.createBy}} - {{article.createTime}}</div>\r\n        </div>\r\n        <div>\r\n          <!-- 将收藏按钮改为删除按钮，只有自己的笔记才能删除 -->\r\n          <el-button v-if=\"article.createBy == user.userName\" type=\"danger\" @click=\"deleteArticle\" icon=\"el-icon-delete\" circle></el-button>\r\n        </div>\r\n      </div>\r\n      <div class=\"articleInfo-desc\">\r\n        <div class=\"articleInfo-desc1\">\r\n          <span style=\"font-weight:bold\">摘要：</span>{{article.articleDesc}}\r\n        </div>\r\n        <div class=\"articleInfo-desc2\">\r\n          <span style=\"font-weight:bold\">正文：</span>\r\n          <div v-html=\"article.content\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"articleInfo-comment\">\r\n        <div class=\"articleInfo-comment-font\">评论：</div>\r\n        <div class=\"articleInfo-comment-content\">\r\n          <el-input type=\"textarea\" resize=\"none\" rows=\"7\" v-model=\"content\" placeholder=\"请输入评论内容\"></el-input>\r\n          <div class=\"articleInfo-comment-btn\">\r\n            <el-button @click=\"saveApeArticleComment\" style=\"margin-top:10px\" size=\"mini\" type=\"success\" plain>提交评论</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"articleInfo-comment\">\r\n        <div class=\"articleInfo-comment-font\">评论列表：</div>\r\n        <div v-if=\"commentList.length <= 0\" style=\"border: 2px solid #EFF1F2;border-radius: 7px;\">\r\n          <el-empty description=\"还没有评论，快去发表评论吧！\"></el-empty>\r\n        </div>\r\n        <div v-if=\"commentList.length > 0\" class=\"taskInfo-comment-list\">\r\n          <div v-for=\"(item,index) in commentList\" :key=\"index\">\r\n            <div v-if=\"(index+1)%2 == 1\" class=\"taskInfo-comment-item\">\r\n              <div>\r\n                <img style=\"width:40px;height:40px;border-radius:50%\" :src=\"$store.state.HOST + item.avatar\">\r\n              </div>\r\n              <div style=\"width:80%\">\r\n                <div class=\"taskInfo-comment-item1\">{{item.createBy}}</div>\r\n                <div class=\"taskInfo-comment-item2\"><div style=\"padding-top:10px;padding-bottom:10px;margin-left:10px\">{{item.content}}</div></div>\r\n              </div>\r\n            </div>\r\n            <div v-if=\"(index+1)%2 == 0\" class=\"taskInfo-comment-item-right\">\r\n              <div style=\"width:60%;display:flex;flex-direction: column;align-items: flex-end;margin-right:15px\">\r\n                <div class=\"taskInfo-comment-item1\">{{item.createBy}}</div>\r\n                <div class=\"taskInfo-comment-item3\"><div style=\"padding-top:10px;padding-bottom:10px;margin-left:10px\">{{item.content}}</div></div>\r\n              </div>\r\n              <div>\r\n                <img style=\"width:40px;height:40px;border-radius:50%\" :src=\"$store.state.HOST + item.avatar\">\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {saveApeArticleFavor,removeApeArticleFavor,getApeArticleById,saveApeArticleComment,getApeArticleCommentByArticleId,removeApeArticle} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      user: {},\r\n      articleId: \"\",\r\n      article: {},\r\n      content: \"\",\r\n      commentList: []\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    // 删除笔记\r\n    deleteArticle() {\r\n      this.$confirm('确定要删除这篇笔记吗？删除后无法恢复！', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        removeApeArticle({ ids: this.articleId }).then(res => {\r\n          if (res.code == 1000) {\r\n            this.$message({\r\n              type: 'success',\r\n              message: '删除成功!'\r\n            });\r\n            // 延迟后返回上一页\r\n            setTimeout(() => {\r\n              this.$router.go(-1)\r\n            }, 1000)\r\n          } else {\r\n            this.$message.error(res.message || '删除失败')\r\n          }\r\n        })\r\n      }).catch(() => {\r\n        this.$message.info('已取消删除')\r\n      })\r\n    },\r\n    getApeArticleCommentByArticleId() {\r\n      getApeArticleCommentByArticleId({id:this.articleId}).then(res => {\r\n        if (res.code == 1000) {\r\n          this.commentList = res.data\r\n        }\r\n      })\r\n    },\r\n    getApeArticleById() {\r\n      getApeArticleById({id: this.articleId}).then(res => {\r\n        if(res.code == 1000) {\r\n          this.article = res.data\r\n        }\r\n      })\r\n    },\r\n    saveApeArticleComment() {\r\n      if (!this.content.trim()) {\r\n        this.$message.warning('请输入评论内容')\r\n        return\r\n      }\r\n      var param = {\r\n        taskId: this.articleId,\r\n        content: this.content\r\n      }\r\n      saveApeArticleComment(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.$message({\r\n            type: 'success',\r\n            message: '评论成功!'\r\n          });\r\n          this.content = \"\"\r\n          this.getApeArticleCommentByArticleId()\r\n        }\r\n      })\r\n    },\r\n    editArticle() {\r\n      this.$router.push(\"/editArticle?id=\" + this.articleId)\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    var articleId = this.$route.query.id\r\n    if (articleId) {\r\n      this.articleId = articleId\r\n    }\r\n    this.getApeArticleById()\r\n    this.getApeArticleCommentByArticleId()\r\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\"))\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/articleInfo.css\");\r\n::v-deep img {\r\n  max-width: 100% !important;\r\n}\r\n</style>"],"mappings":";AAuEA,SAAAA,mBAAA,EAAAC,qBAAA,EAAAC,iBAAA,EAAAC,qBAAA,EAAAC,+BAAA,EAAAC,gBAAA;AACA,OAAAC,UAAA;AACA,O