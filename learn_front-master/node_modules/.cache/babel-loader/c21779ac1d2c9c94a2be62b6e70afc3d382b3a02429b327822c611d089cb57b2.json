{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  components: {\n    headerPage,\n    bottomPage\n  },\n  data() {\n    return {\n      id: \"\",\n      user: {},\n      forum: {},\n      content: \"\",\n      forumList: [],\n      likeCount: 0,\n      isLiked: false,\n      parentId: '0',\n      replyUserName: ''\n    };\n  },\n  computed: {\n    totalComments() {\n      let count = 0;\n      this.forumList.forEach(item => {\n        count += 1; // 顶级评论\n        if (item.allReplies && item.allReplies.length > 0) {\n          count += item.allReplies.length; // 所有回复\n        }\n      });\n\n      return count;\n    }\n  },\n  methods: {\n    formatTime(timeStr) {\n      if (!timeStr) return '';\n      if (timeStr.length > 16) {\n        return timeStr.substring(0, 16);\n      }\n      return timeStr;\n    },\n    handleAvatarError(e) {\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    likePost() {\n      const params = {\n        targetId: this.id,\n        type: 1\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          this.isLiked = !this.isLiked;\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1);\n          this.$message({\n            message: this.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    likeComment(item) {\n      const params = {\n        targetId: item.id,\n        type: 2\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          item.isLiked = !item.isLiked;\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1);\n          this.$forceUpdate();\n          this.$message({\n            message: item.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    replyToUser(item) {\n      this.replyUserName = item.userName || item.createBy;\n      this.parentId = item.id;\n      this.content = '';\n      this.$nextTick(() => {\n        if (this.$refs.commentInput) {\n          this.$refs.commentInput.focus();\n        }\n      });\n      this.$message.info(`正在回复 ${this.replyUserName}`);\n    },\n    cancelReply() {\n      this.parentId = '0';\n      this.replyUserName = '';\n      this.content = '';\n    },\n    saveApeForumItem() {\n      if (!this.content.trim()) {\n        this.$message({\n          type: 'warning',\n          message: '请输入回复内容'\n        });\n        return;\n      }\n      var param = {\n        forumId: this.id,\n        content: this.content,\n        parentId: this.parentId || '0',\n        replyUserName: this.replyUserName\n      };\n      console.log('提交参数:', param);\n      saveApeForumItem(param).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '发布成功!'\n          });\n          this.content = \"\";\n          this.cancelReply();\n          this.getApeForumItemList();\n        } else {\n          this.$message.error(res.message);\n        }\n      }).catch(() => {\n        this.$message.error('发布失败，请稍后重试');\n      });\n    },\n    getApeForumById() {\n      getApeForumById({\n        id: this.id\n      }).then(res => {\n        if (res.code == 1000) {\n          this.forum = res.data;\n          this.likeCount = res.data.likeCount || 0;\n          this.isLiked = res.data.isLiked || false;\n        }\n      });\n    },\n    getApeForumItemList() {\n      var param = {\n        forumId: this.id\n      };\n      getApeForumItemList(param).then(res => {\n        if (res.code == 1000) {\n          console.log('原始数据:', res.data);\n          this.forumList = this.flattenReplies(res.data || []);\n          console.log('处理后数据:', this.forumList);\n        }\n      });\n    },\n    // 将所有回复平铺到第二层\n    flattenReplies(comments) {\n      if (!comments || comments.length === 0) return [];\n      console.log('原始评论数据:', comments.map(c => ({\n        id: c.id,\n        userName: c.userName,\n        parentId: c.parentId\n      })));\n\n      // 建立 id 映射\n      const commentMap = new Map();\n      comments.forEach(comment => {\n        comment.allReplies = [];\n        commentMap.set(comment.id, comment);\n      });\n      const topComments = [];\n\n      // 第一遍：找出顶级评论（parentId 为 null、undefined 或空字符串，不包括 '0'）\n      comments.forEach(comment => {\n        const parentId = comment.parentId;\n        // 注意：'0' 被视为有父级，不是顶级评论\n        const isTopLevel = !parentId || parentId === null || parentId === undefined || parentId === '';\n        if (isTopLevel) {\n          topComments.push(comment);\n        }\n      });\n\n      // 第二遍：将所有非顶级评论（parentId 不为空且不为 '0'）收集到对应的顶级评论的 allReplies 中\n      comments.forEach(comment => {\n        const parentId = comment.parentId;\n        const isTopLevel = !parentId || parentId === null || parentId === undefined || parentId === '';\n\n        // 如果有 parentId 且 parentId 不是空（包括 '0' 也算有父级）\n        if (!isTopLevel && parentId) {\n          // 直接找父级评论\n          const parent = commentMap.get(parentId);\n          if (parent) {\n            // 找到父评论所属的顶级评论\n            let topParent = parent;\n            // 向上查找直到顶级评论\n            while (topParent && topParent.parentId && topParent.parentId !== null && topParent.parentId !== undefined && topParent.parentId !== '') {\n              const nextParent = commentMap.get(topParent.parentId);\n              if (!nextParent) break;\n              topParent = nextParent;\n            }\n\n            // 如果找到了顶级评论，添加到它的 allReplies 中\n            if (topParent && topComments.includes(topParent)) {\n              if (!topParent.allReplies) {\n                topParent.allReplies = [];\n              }\n              topParent.allReplies.push(comment);\n            }\n          }\n        }\n      });\n\n      // 顶级评论按时间倒序排序\n      topComments.sort((a, b) => new Date(b.createTime) - new Date(a.createTime));\n\n      // 回复按时间正序排序\n      topComments.forEach(comment => {\n        if (comment.allReplies && comment.allReplies.length > 0) {\n          // 去重\n          const uniqueReplies = [];\n          const ids = new Set();\n          comment.allReplies.forEach(reply => {\n            if (!ids.has(reply.id)) {\n              ids.add(reply.id);\n              uniqueReplies.push(reply);\n            }\n          });\n          comment.allReplies = uniqueReplies;\n          comment.allReplies.sort((a, b) => new Date(a.createTime) - new Date(b.createTime));\n        }\n      });\n      console.log('处理后: 顶级评论数', topComments.length, '各评论回复数:', topComments.map(c => ({\n        name: c.userName,\n        replyCount: c.allReplies?.length || 0\n      })));\n      return topComments;\n    }\n  },\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.id = this.$route.query.id;\n    this.getApeForumById();\n    this.getApeForumItemList();\n  }\n};","map":{"version":3,"names":["getApeForumById","getApeForumItemList","saveApeForumItem","likeApeForum","headerPage","bottomPage","components","data","id","user","forum","content","forumList","likeCount","isLiked","parentId","replyUserName","computed","totalComments","count","forEach","item","allReplies","length","methods","formatTime","timeStr","substring","handleAvatarError","e","target","src","likePost","params","targetId","type","then","res","code","$message","message","duration","error","likeComment","$forceUpdate","replyToUser","userName","createBy","$nextTick","$refs","commentInput","focus","info","cancelReply","trim","param","forumId","console","log","catch","flattenReplies","comments","map","c","commentMap","Map","comment","set","topComments","isTopLevel","undefined","push","parent","get","topParent","nextParent","includes","sort","a","b","Date","createTime","uniqueReplies","ids","Set","reply","has","add","name","replyCount","mounted","window","scrollTo","top","behavior","$route","query"],"sources":["src/views/forum/forumInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <headerPage></headerPage>\r\n\r\n    <!-- 帖子详情 -->\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"post-container\">\r\n        <div class=\"post-header\">\r\n          <div class=\"post-author\">\r\n            <img class=\"author-avatar\" :src=\"$store.state.HOST + forum.avatar\" @error=\"handleAvatarError\">\r\n            <div class=\"author-info\">\r\n              <span class=\"author-name\">{{forum.createBy}}</span>\r\n              <span class=\"post-time\">\r\n                <i class=\"el-icon-time\"></i> {{formatTime(forum.createTime)}}\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div class=\"post-title\">{{forum.name}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-content\">\r\n          <div class=\"content-text\">{{forum.content}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-actions\">\r\n          <div class=\"action-item\" @click=\"likePost\">\r\n            <i class=\"el-icon-thumb\" :class=\"{ 'liked': isLiked }\"></i>\r\n            <span>{{likeCount}}</span>\r\n          </div>\r\n          <div class=\"action-item\">\r\n            <i class=\"el-icon-chat-dot-round\"></i>\r\n            <span>{{totalComments}} 回复</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布评论区域 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-edit\"></i> 发表回复\r\n        </div>\r\n        <div class=\"comment-input\">\r\n          <div v-if=\"replyUserName\" class=\"reply-tip\">\r\n            正在回复 @{{replyUserName}}\r\n            <span @click=\"cancelReply\" class=\"cancel-reply\">取消</span>\r\n          </div>\r\n          <el-input\r\n              type=\"textarea\"\r\n              resize=\"none\"\r\n              rows=\"4\"\r\n              v-model=\"content\"\r\n              placeholder=\"写下你的回复...\"\r\n              ref=\"commentInput\">\r\n          </el-input>\r\n          <div class=\"comment-submit\">\r\n            <el-button @click=\"saveApeForumItem\" size=\"small\" type=\"primary\" plain>发布回复</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-chat-dot-round\"></i> 全部回复 ({{totalComments}})\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length <= 0\" class=\"empty-comment\">\r\n          <el-empty description=\"还没有回复，快来抢沙发吧！\"></el-empty>\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length > 0\" class=\"comment-list\">\r\n          <!-- 第一层：顶级评论 -->\r\n          <div v-for=\"item in forumList\" :key=\"item.id\" class=\"comment-tree\">\r\n            <!-- 一级评论 -->\r\n            <div class=\"comment-item\">\r\n              <div class=\"comment-avatar\">\r\n                <img :src=\"$store.state.HOST + item.userAvatar\" @error=\"handleAvatarError\">\r\n              </div>\r\n              <div class=\"comment-main\">\r\n                <div class=\"comment-header\">\r\n                  <span class=\"comment-author\">{{ item.userName || item.createBy }}</span>\r\n                  <span class=\"comment-time\">{{ formatTime(item.createTime) }}</span>\r\n                </div>\r\n                <div class=\"comment-text\">{{ item.content }}</div>\r\n                <div class=\"comment-footer\">\r\n                  <span class=\"comment-like\" @click=\"likeComment(item)\">\r\n                    <i class=\"el-icon-thumb\" :class=\"{ 'liked': item.isLiked }\"></i>\r\n                    {{ item.likeCount || 0 }}\r\n                  </span>\r\n                  <span class=\"comment-reply\" @click=\"replyToUser(item)\">回复</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 第二层：所有回复（平铺显示，包括第三层及更深） -->\r\n            <div v-if=\"item.allReplies && item.allReplies.length > 0\" class=\"replies-container\">\r\n              <div v-for=\"reply in item.allReplies\" :key=\"reply.id\" class=\"reply-item\">\r\n                <div class=\"reply-line\"></div>\r\n                <div class=\"reply-avatar\">\r\n                  <img :src=\"$store.state.HOST + reply.userAvatar\" @error=\"handleAvatarError\">\r\n                </div>\r\n                <div class=\"reply-main\">\r\n                  <div class=\"reply-header\">\r\n                    <span class=\"reply-author\">{{ reply.userName || reply.createBy }}</span>\r\n                    <span class=\"reply-time\">{{ formatTime(reply.createTime) }}</span>\r\n                  </div>\r\n                  <div class=\"reply-text\">\r\n                    <span class=\"reply-to\">@{{ reply.replyUserName || reply.parentUser }} </span>\r\n                    {{ reply.content }}\r\n                  </div>\r\n                  <div class=\"reply-footer\">\r\n                    <span class=\"reply-like\" @click=\"likeComment(reply)\">\r\n                      <i class=\"el-icon-thumb\" :class=\"{ 'liked': reply.isLiked }\"></i>\r\n                      {{ reply.likeCount || 0 }}\r\n                    </span>\r\n                    <span class=\"reply-reply\" @click=\"replyToUser(reply)\">回复</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\n\r\nexport default {\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  data() {\r\n    return{\r\n      id: \"\",\r\n      user: {},\r\n      forum: {},\r\n      content: \"\",\r\n      forumList: [],\r\n      likeCount: 0,\r\n      isLiked: false,\r\n      parentId: '0',\r\n      replyUserName: ''\r\n    }\r\n  },\r\n  computed: {\r\n    totalComments() {\r\n      let count = 0\r\n      this.forumList.forEach(item => {\r\n        count += 1  // 顶级评论\r\n        if (item.allReplies && item.allReplies.length > 0) {\r\n          count += item.allReplies.length  // 所有回复\r\n        }\r\n      })\r\n      return count\r\n    }\r\n  },\r\n  methods: {\r\n    formatTime(timeStr) {\r\n      if (!timeStr) return ''\r\n      if (timeStr.length > 16) {\r\n        return timeStr.substring(0, 16)\r\n      }\r\n      return timeStr\r\n    },\r\n    handleAvatarError(e) {\r\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n\r\n    likePost() {\r\n      const params = { targetId: this.id, type: 1 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          this.isLiked = !this.isLiked\r\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1)\r\n          this.$message({\r\n            message: this.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    likeComment(item) {\r\n      const params = { targetId: item.id, type: 2 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          item.isLiked = !item.isLiked\r\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1)\r\n          this.$forceUpdate()\r\n          this.$message({\r\n            message: item.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    replyToUser(item) {\r\n      this.replyUserName = item.userName || item.createBy\r\n      this.parentId = item.id\r\n      this.content = ''\r\n      this.$nextTick(() => {\r\n        if (this.$refs.commentInput) {\r\n          this.$refs.commentInput.focus()\r\n        }\r\n      })\r\n      this.$message.info(`正在回复 ${this.replyUserName}`)\r\n    },\r\n\r\n    cancelReply() {\r\n      this.parentId = '0'\r\n      this.replyUserName = ''\r\n      this.content = ''\r\n    },\r\n\r\n    saveApeForumItem() {\r\n      if (!this.content.trim()) {\r\n        this.$message({ type: 'warning', message: '请输入回复内容' })\r\n        return\r\n      }\r\n      var param = {\r\n        forumId: this.id,\r\n        content: this.content,\r\n        parentId: this.parentId || '0',\r\n        replyUserName: this.replyUserName\r\n      }\r\n      console.log('提交参数:', param)\r\n      saveApeForumItem(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.$message({ type: 'success', message: '发布成功!' })\r\n          this.content = \"\"\r\n          this.cancelReply()\r\n          this.getApeForumItemList()\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      }).catch(() => {\r\n        this.$message.error('发布失败，请稍后重试')\r\n      })\r\n    },\r\n\r\n    getApeForumById() {\r\n      getApeForumById({id: this.id}).then(res => {\r\n        if (res.code == 1000) {\r\n          this.forum = res.data\r\n          this.likeCount = res.data.likeCount || 0\r\n          this.isLiked = res.data.isLiked || false\r\n        }\r\n      })\r\n    },\r\n\r\n    getApeForumItemList() {\r\n      var param = { forumId: this.id }\r\n      getApeForumItemList(param).then(res => {\r\n        if (res.code == 1000) {\r\n          console.log('原始数据:', res.data)\r\n          this.forumList = this.flattenReplies(res.data || [])\r\n          console.log('处理后数据:', this.forumList)\r\n        }\r\n      })\r\n    },\r\n\r\n    // 将所有回复平铺到第二层\r\n    flattenReplies(comments) {\r\n      if (!comments || comments.length === 0) return []\r\n\r\n      console.log('原始评论数据:', comments.map(c => ({ id: c.id, userName: c.userName, parentId: c.parentId })))\r\n\r\n      // 建立 id 映射\r\n      const commentMap = new Map()\r\n      comments.forEach(comment => {\r\n        comment.allReplies = []\r\n        commentMap.set(comment.id, comment)\r\n      })\r\n\r\n      const topComments = []\r\n\r\n      // 第一遍：找出顶级评论（parentId 为 null、undefined 或空字符串，不包括 '0'）\r\n      comments.forEach(comment => {\r\n        const parentId = comment.parentId\r\n        // 注意：'0' 被视为有父级，不是顶级评论\r\n        const isTopLevel = !parentId || parentId === null || parentId === undefined || parentId === ''\r\n\r\n        if (isTopLevel) {\r\n          topComments.push(comment)\r\n        }\r\n      })\r\n\r\n      // 第二遍：将所有非顶级评论（parentId 不为空且不为 '0'）收集到对应的顶级评论的 allReplies 中\r\n      comments.forEach(comment => {\r\n        const parentId = comment.parentId\r\n        const isTopLevel = !parentId || parentId === null || parentId === undefined || parentId === ''\r\n\r\n        // 如果有 parentId 且 parentId 不是空（包括 '0' 也算有父级）\r\n        if (!isTopLevel && parentId) {\r\n          // 直接找父级评论\r\n          const parent = commentMap.get(parentId)\r\n          if (parent) {\r\n            // 找到父评论所属的顶级评论\r\n            let topParent = parent\r\n            // 向上查找直到顶级评论\r\n            while (topParent && topParent.parentId && topParent.parentId !== null && topParent.parentId !== undefined && topParent.parentId !== '') {\r\n              const nextParent = commentMap.get(topParent.parentId)\r\n              if (!nextParent) break\r\n              topParent = nextParent\r\n            }\r\n\r\n            // 如果找到了顶级评论，添加到它的 allReplies 中\r\n            if (topParent && topComments.includes(topParent)) {\r\n              if (!topParent.allReplies) {\r\n                topParent.allReplies = []\r\n              }\r\n              topParent.allReplies.push(comment)\r\n            }\r\n          }\r\n        }\r\n      })\r\n\r\n      // 顶级评论按时间倒序排序\r\n      topComments.sort((a, b) => new Date(b.createTime) - new Date(a.createTime))\r\n\r\n      // 回复按时间正序排序\r\n      topComments.forEach(comment => {\r\n        if (comment.allReplies && comment.allReplies.length > 0) {\r\n          // 去重\r\n          const uniqueReplies = []\r\n          const ids = new Set()\r\n          comment.allReplies.forEach(reply => {\r\n            if (!ids.has(reply.id)) {\r\n              ids.add(reply.id)\r\n              uniqueReplies.push(reply)\r\n            }\r\n          })\r\n          comment.allReplies = uniqueReplies\r\n          comment.allReplies.sort((a, b) => new Date(a.createTime) - new Date(b.createTime))\r\n        }\r\n      })\r\n\r\n      console.log('处理后: 顶级评论数', topComments.length, '各评论回复数:', topComments.map(c => ({ name: c.userName, replyCount: c.allReplies?.length || 0 })))\r\n\r\n      return topComments\r\n    }\r\n  },\r\n  mounted() {\r\n    window.scrollTo({ top: 0, behavior: 'smooth' })\r\n    this.id = this.$route.query.id\r\n    this.getApeForumById()\r\n    this.getApeForumItemList()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/articleInfo.css\");\r\n\r\n/* 帖子容器样式 */\r\n.post-container {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  margin: 30px auto;\r\n  width: 70%;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n