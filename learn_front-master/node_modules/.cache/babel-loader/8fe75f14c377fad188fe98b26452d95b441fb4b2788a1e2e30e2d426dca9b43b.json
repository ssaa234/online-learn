{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { sendSmsCode, verifySmsCode, resetPassword } from '../../api/api';\nexport default {\n  data() {\n    // 确认密码验证规则\n    const validateConfirmPassword = (rule, value, callback) => {\n      if (value !== this.formData.newPassword) {\n        callback(new Error('两次输入的密码不一致'));\n      } else {\n        callback();\n      }\n    };\n\n    // 手机号格式验证\n    const validatePhone = (rule, value, callback) => {\n      if (!value) {\n        callback(new Error('请输入手机号'));\n      } else if (!/^1[3-9]\\d{9}$/.test(value)) {\n        callback(new Error('请输入正确的手机号格式'));\n      } else {\n        callback();\n      }\n    };\n    return {\n      step: 1,\n      // 1:验证手机号, 2:重置密码, 3:完成\n      formData: {\n        username: '',\n        phone: '',\n        verifyCode: '',\n        newPassword: '',\n        confirmPassword: ''\n      },\n      countdown: 0,\n      step1Rules: {\n        username: [{\n          required: true,\n          message: '请输入用户账号',\n          trigger: 'blur'\n        }],\n        phone: [{\n          required: true,\n          validator: validatePhone,\n          trigger: 'blur'\n        }],\n        verifyCode: [{\n          required: true,\n          message: '请输入验证码',\n          trigger: 'blur'\n        }, {\n          len: 6,\n          message: '验证码为6位数字',\n          trigger: 'blur'\n        }]\n      },\n      step2Rules: {\n        newPassword: [{\n          required: true,\n          message: '请输入新密码',\n          trigger: 'blur'\n        }, {\n          min: 6,\n          max: 20,\n          message: '密码长度在6-20个字符之间',\n          trigger: 'blur'\n        }],\n        confirmPassword: [{\n          required: true,\n          message: '请再次输入新密码',\n          trigger: 'blur'\n        }, {\n          validator: validateConfirmPassword,\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  methods: {\n    goBack() {\n      this.$router.go(-1);\n    },\n    goToLogin() {\n      this.$router.push('/login');\n    },\n    // 发送验证码\n    async sendVerifyCode() {\n      if (!this.formData.phone) {\n        this.$message.error('请先输入手机号');\n        return;\n      }\n      if (!/^1[3-9]\\d{9}$/.test(this.formData.phone)) {\n        this.$message.error('请输入正确的手机号格式');\n        return;\n      }\n      try {\n        const res = await sendSmsCode({\n          phone: this.formData.phone,\n          type: 'reset_password' // 标识是找回密码的验证码\n        });\n\n        if (res.code === 1000) {\n          this.$message.success('验证码已发送');\n          // 开始倒计时\n          this.countdown = 60;\n          const timer = setInterval(() => {\n            if (this.countdown <= 1) {\n              clearInterval(timer);\n              this.countdown = 0;\n            } else {\n              this.countdown--;\n            }\n          }, 1000);\n        } else {\n          this.$message.error(res.message || '发送失败');\n        }\n      } catch (error) {\n        this.$message.error('发送失败，请稍后重试');\n      }\n    },\n    // 验证手机号\n    async verifyPhone() {\n      this.$refs.step1Form.validate(async valid => {\n        if (!valid) return;\n        try {\n          // 验证验证码\n          const verifyRes = await verifySmsCode({\n            phone: this.formData.phone,\n            code: this.formData.verifyCode,\n            type: 'reset_password'\n          });\n          if (verifyRes.code !== 1000) {\n            this.$message.error(verifyRes.message || '验证码错误');\n            return;\n          }\n\n          // 验证用户账号和手机号是否匹配\n          const checkRes = await this.checkUserPhone({\n            username: this.formData.username,\n            phone: this.formData.phone\n          });\n          if (checkRes.code === 1000) {\n            this.step = 2;\n          } else {\n            this.$message.error(checkRes.message || '用户账号与手机号不匹配');\n          }\n        } catch (error) {\n          this.$message.error('验证失败，请稍后重试');\n        }\n      });\n    },\n    // 检查用户账号和手机号是否匹配\n    async checkUserPhone(params) {\n      // 调用后端接口，检查用户名和手机号是否匹配\n      // 这里需要根据你的实际API来实现\n      try {\n        const res = await this.$http.post('/api/user/checkPhone', params);\n        return res.data;\n      } catch (error) {\n        return {\n          code: 2000,\n          message: '请求失败'\n        };\n      }\n    },\n    // 重置密码\n    async resetPassword() {\n      this.$refs.step2Form.validate(async valid => {\n        if (!valid) return;\n        try {\n          const res = await resetPassword({\n            username: this.formData.username,\n            phone: this.formData.phone,\n            newPassword: this.formData.newPassword,\n            verifyCode: this.formData.verifyCode\n          });\n          if (res.code === 1000) {\n            this.step = 3;\n          } else {\n            this.$message.error(res.message || '重置密码失败');\n          }\n        } catch (error) {\n          this.$message.error('重置失败，请稍后重试');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["sendSmsCode","verifySmsCode","resetPassword","data","validateConfirmPassword","rule","value","callback","formData","newPassword","Error","validatePhone","test","step","username","phone","verifyCode","confirmPassword","countdown","step1Rules","required","message","trigger","validator","len","step2Rules","min","max","methods","goBack","$router","go","goToLogin","push","sendVerifyCode","$message","error","res","type","code","success","timer","setInterval","clearInterval","verifyPhone","$refs","step1Form","validate","valid","verifyRes","checkRes","checkUserPhone","params","$http","post","step2Form"],"sources":["src/views/forgePassword/forgetPassword.vue"],"sourcesContent":["<template>\r\n  <div class=\"forget-password-container\">\r\n    <div class=\"forget-password-card\">\r\n      <div class=\"card-header\">\r\n        <div class=\"back-btn\" @click=\"goBack\">\r\n          <img src=\"../../assets/image/back.png\" alt=\"返回\">\r\n        </div>\r\n        <div class=\"title\">找回密码</div>\r\n      </div>\r\n\r\n      <!-- 步骤1：验证手机号 -->\r\n      <div v-if=\"step === 1\" class=\"step-content\">\r\n        <div class=\"step-title\">验证手机号</div>\r\n        <el-form :model=\"formData\" :rules=\"step1Rules\" ref=\"step1Form\">\r\n          <el-form-item label=\"用户账号\" prop=\"username\">\r\n            <el-input v-model=\"formData.username\" placeholder=\"请输入用户账号\"></el-input>\r\n          </el-form-item>\r\n          <el-form-item label=\"手机号\" prop=\"phone\">\r\n            <el-input v-model=\"formData.phone\" placeholder=\"请输入绑定的手机号\"></el-input>\r\n          </el-form-item>\r\n          <el-form-item label=\"验证码\" prop=\"verifyCode\">\r\n            <div class=\"verify-code-input\">\r\n              <el-input v-model=\"formData.verifyCode\" placeholder=\"请输入验证码\"></el-input>\r\n              <el-button\r\n                  :disabled=\"countdown > 0\"\r\n                  @click=\"sendVerifyCode\"\r\n                  class=\"send-code-btn\">\r\n                {{ countdown > 0 ? `${countdown}秒后重试` : '发送验证码' }}\r\n              </el-button>\r\n            </div>\r\n          </el-form-item>\r\n        </el-form>\r\n        <div class=\"step-buttons\">\r\n          <el-button type=\"primary\" @click=\"verifyPhone\" class=\"next-btn\">下一步</el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 步骤2：重置密码 -->\r\n      <div v-if=\"step === 2\" class=\"step-content\">\r\n        <div class=\"step-title\">重置密码</div>\r\n        <el-form :model=\"formData\" :rules=\"step2Rules\" ref=\"step2Form\">\r\n          <el-form-item label=\"新密码\" prop=\"newPassword\">\r\n            <el-input type=\"password\" v-model=\"formData.newPassword\" placeholder=\"请输入新密码\"></el-input>\r\n          </el-form-item>\r\n          <el-form-item label=\"确认密码\" prop=\"confirmPassword\">\r\n            <el-input type=\"password\" v-model=\"formData.confirmPassword\" placeholder=\"请再次输入新密码\"></el-input>\r\n          </el-form-item>\r\n        </el-form>\r\n        <div class=\"step-buttons\">\r\n          <el-button @click=\"step = 1\" class=\"prev-btn\">上一步</el-button>\r\n          <el-button type=\"primary\" @click=\"resetPassword\" class=\"next-btn\">确认修改</el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 步骤3：完成 -->\r\n      <div v-if=\"step === 3\" class=\"step-content success-content\">\r\n        <div class=\"success-icon\">✓</div>\r\n        <div class=\"success-title\">密码重置成功</div>\r\n        <div class=\"success-desc\">请使用新密码重新登录</div>\r\n        <el-button type=\"primary\" @click=\"goToLogin\" class=\"login-now-btn\">立即登录</el-button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { sendSmsCode, verifySmsCode, resetPassword } from '../../api/api'\r\n\r\nexport default {\r\n  data() {\r\n    // 确认密码验证规则\r\n    const validateConfirmPassword = (rule, value, callback) => {\r\n      if (value !== this.formData.newPassword) {\r\n        callback(new Error('两次输入的密码不一致'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    // 手机号格式验证\r\n    const validatePhone = (rule, value, callback) => {\r\n      if (!value) {\r\n        callback(new Error('请输入手机号'))\r\n      } else if (!/^1[3-9]\\d{9}$/.test(value)) {\r\n        callback(new Error('请输入正确的手机号格式'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n\r\n    return {\r\n      step: 1, // 1:验证手机号, 2:重置密码, 3:完成\r\n      formData: {\r\n        username: '',\r\n        phone: '',\r\n        verifyCode: '',\r\n        newPassword: '',\r\n        confirmPassword: ''\r\n      },\r\n      countdown: 0,\r\n      step1Rules: {\r\n        username: [\r\n          { required: true, message: '请输入用户账号', trigger: 'blur' }\r\n        ],\r\n        phone: [\r\n          { required: true, validator: validatePhone, trigger: 'blur' }\r\n        ],\r\n        verifyCode: [\r\n          { required: true, message: '请输入验证码', trigger: 'blur' },\r\n          { len: 6, message: '验证码为6位数字', trigger: 'blur' }\r\n        ]\r\n      },\r\n      step2Rules: {\r\n        newPassword: [\r\n          { required: true, message: '请输入新密码', trigger: 'blur' },\r\n          { min: 6, max: 20, message: '密码长度在6-20个字符之间', trigger: 'blur' }\r\n        ],\r\n        confirmPassword: [\r\n          { required: true, message: '请再次输入新密码', trigger: 'blur' },\r\n          { validator: validateConfirmPassword, trigger: 'blur' }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    goBack() {\r\n      this.$router.go(-1)\r\n    },\r\n\r\n    goToLogin() {\r\n      this.$router.push('/login')\r\n    },\r\n\r\n    // 发送验证码\r\n    async sendVerifyCode() {\r\n      if (!this.formData.phone) {\r\n        this.$message.error('请先输入手机号')\r\n        return\r\n      }\r\n      if (!/^1[3-9]\\d{9}$/.test(this.formData.phone)) {\r\n        this.$message.error('请输入正确的手机号格式')\r\n        return\r\n      }\r\n\r\n      try {\r\n        const res = await sendSmsCode({\r\n          phone: this.formData.phone,\r\n          type: 'reset_password' // 标识是找回密码的验证码\r\n        })\r\n\r\n        if (res.code === 1000) {\r\n          this.$message.success('验证码已发送')\r\n          // 开始倒计时\r\n          this.countdown = 60\r\n          const timer = setInterval(() => {\r\n            if (this.countdown <= 1) {\r\n              clearInterval(timer)\r\n              this.countdown = 0\r\n            } else {\r\n              this.countdown--\r\n            }\r\n          }, 1000)\r\n        } else {\r\n          this.$message.error(res.message || '发送失败')\r\n        }\r\n      } catch (error) {\r\n        this.$message.error('发送失败，请稍后重试')\r\n      }\r\n    },\r\n\r\n    // 验证手机号\r\n    async verifyPhone() {\r\n      this.$refs.step1Form.validate(async (valid) => {\r\n        if (!valid) return\r\n\r\n        try {\r\n          // 验证验证码\r\n          const verifyRes = await verifySmsCode({\r\n            phone: this.formData.phone,\r\n            code: this.formData.verifyCode,\r\n            type: 'reset_password'\r\n          })\r\n\r\n          if (verifyRes.code !== 1000) {\r\n            this.$message.error(verifyRes.message || '验证码错误')\r\n            return\r\n          }\r\n\r\n          // 验证用户账号和手机号是否匹配\r\n          const checkRes = await this.checkUserPhone({\r\n            username: this.formData.username,\r\n            phone: this.formData.phone\r\n          })\r\n\r\n          if (checkRes.code === 1000) {\r\n            this.step = 2\r\n          } else {\r\n            this.$message.error(checkRes.message || '用户账号与手机号不匹配')\r\n          }\r\n        } catch (error) {\r\n          this.$message.error('验证失败，请稍后重试')\r\n        }\r\n      })\r\n    },\r\n\r\n    // 检查用户账号和手机号是否匹配\r\n    async checkUserPhone(params) {\r\n      // 调用后端接口，检查用户名和手机号是否匹配\r\n      // 这里需要根据你的实际API来实现\r\n      try {\r\n        const res = await this.$http.post('/api/user/checkPhone', params)\r\n        return res.data\r\n      } catch (error) {\r\n        return { code: 2000, message: '请求失败' }\r\n      }\r\n    },\r\n\r\n    // 重置密码\r\n    async resetPassword() {\r\n      this.$refs.step2Form.validate(async (valid) => {\r\n        if (!valid) return\r\n\r\n        try {\r\n          const res = await resetPassword({\r\n            username: this.formData.username,\r\n            phone: this.formData.phone,\r\n            newPassword: this.formData.newPassword,\r\n            verifyCode: this.formData.verifyCode\r\n          })\r\n\r\n          if (res.code === 1000) {\r\n            this.step = 3\r\n          } else {\r\n            this.$message.error(res.message || '重置密码失败')\r\n          }\r\n        } catch (error) {\r\n          this.$message.error('重置失败，请稍后重试')\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.forget-password-container {\r\n  width: 100%;\r\n  height: 100vh;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.forget-password-card {\r\n  width: 500px;\r\n  background: white;\r\n  border-radius: 20px;\r\n  padding: 40px;\r\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.card-header {\r\n  position: relative;\r\n  margin-bottom: 30px;\r\n  text-align: center;\r\n}\r\n\r\n.back-btn {\r\n  position: absolute;\r\n  left: 0;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  cursor: pointer;\r\n  width: 30px;\r\n  height: 30px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.back-btn img {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n\r\n.title {\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.step-content {\r\n  min-height: 350px;\r\n}\r\n\r\n.step-title {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  color: #666;\r\n  margin-bottom: 30px;\r\n  text-align: center;\r\n}\r\n\r\n.verify-code-input {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.verify-code-input .el-input {\r\n  flex: 1;\r\n}\r\n\r\n.send-code-btn {\r\n  width: 120px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.step-buttons {\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 20px;\r\n  margin-top: 40px;\r\n}\r\n\r\n.next-btn, .prev-btn {\r\n  width: 120px;\r\n}\r\n\r\n.next-btn {\r\n  background-color: #FF5202;\r\n  border-color: #FF5202;\r\n}\r\n\r\n.next-btn:hover {\r\n  background-color: #ff6b2c;\r\n  border-color: #ff6b2c;\r\n}\r\n\r\n.success-content {\r\n  text-align: center;\r\n}\r\n\r\n.success-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  background-color: #52c41a;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin: 0 auto 30px;\r\n  font-size: 50px;\r\n  color: white;\r\n}\r\n\r\n.success-title {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.success-desc {\r\n  font-size: 14px;\r\n  color: #999;\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.login-now-btn {\r\n  background-color: #FF5202;\r\n  border-color: #FF5202;\r\n  width: 150px;\r\n}\r\n\r\n.login-now-btn:hover {\r\n  background-color: #ff6b2c;\r\n  border-color: #ff6b2c;\r\n}\r\n</style>"],"mappings":";AAkEA,SAAAA,WAAA,EAAAC,aAAA,EAAAC,aAAA;AAEA;EACAC,KAAA;IACA;IACA,MAAAC,uBAAA,GAAAA,CAAAC,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,IAAAD,KAAA,UAAAE,QAAA,CAAAC,WAAA;QACAF,QAAA,KAAAG,KAAA;MACA;QACAH,QAAA;MACA;IACA;;IAEA;IACA,MAAAI,aAAA,GAAAA,CAAAN,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA,KAAAG,KAAA;MACA,4BAAAE,IAAA,CAAAN,KAAA;QACAC,QAAA,KAAAG,KAAA;MACA;QACAH,QAAA;MACA;IACA;IAEA;MACAM,IAAA;MAAA;MACAL,QAAA;QACAM,QAAA;QACAC,KAAA;QACAC,UAAA;QACAP,WAAA;QACAQ,eAAA;MACA;MACAC,SAAA;MACAC,UAAA;QACAL,QAAA,GACA;UAAAM,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAP,KAAA,GACA;UAAAK,QAAA;UAAAG,SAAA,EAAAZ,aAAA;UAAAW,OAAA;QAAA,EACA;QACAN,UAAA,GACA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAE,GAAA;UAAAH,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAG,UAAA;QACAhB,WAAA,GACA;UAAAW,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAI,GAAA;UAAAC,GAAA;UAAAN,OAAA;UAAAC,OAAA;QAAA,EACA;QACAL,eAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAC,SAAA,EAAAnB,uBAAA;UAAAkB,OAAA;QAAA;MAEA;IACA;EACA;EACAM,OAAA;IACAC,OAAA;MACA,KAAAC,OAAA,CAAAC,EAAA;IACA;IAEAC,UAAA;MACA,KAAAF,OAAA,CAAAG,IAAA;IACA;IAEA;IACA,MAAAC,eAAA;MACA,UAAA1B,QAAA,CAAAO,KAAA;QACA,KAAAoB,QAAA,CAAAC,KAAA;QACA;MACA;MACA,qBAAAxB,IAAA,MAAAJ,QAAA,CAAAO,KAAA;QACA,KAAAoB,QAAA,CAAAC,KAAA;QACA;MACA;MAEA;QACA,MAAAC,GAAA,SAAArC,WAAA;UACAe,KAAA,OAAAP,QAAA,CAAAO,KAAA;UACAuB,IAAA;QACA;;QAEA,IAAAD,GAAA,CAAAE,IAAA;UACA,KAAAJ,QAAA,CAAAK,OAAA;UACA;UACA,KAAAtB,SAAA;UACA,MAAAuB,KAAA,GAAAC,WAAA;YACA,SAAAxB,SAAA;cACAyB,aAAA,CAAAF,KAAA;cACA,KAAAvB,SAAA;YACA;cACA,KAAAA,SAAA;YACA;UACA;QACA;UACA,KAAAiB,QAAA,CAAAC,KAAA,CAAAC,GAAA,CAAAhB,OAAA;QACA;MACA,SAAAe,KAAA;QACA,KAAAD,QAAA,CAAAC,KAAA;MACA;IACA;IAEA;IACA,MAAAQ,YAAA;MACA,KAAAC,KAAA,CAAAC,SAAA,CAAAC,QAAA,OAAAC,KAAA;QACA,KAAAA,KAAA;QAEA;UACA;UACA,MAAAC,SAAA,SAAAhD,aAAA;YACAc,KAAA,OAAAP,QAAA,CAAAO,KAAA;YACAwB,IAAA,OAAA/B,QAAA,CAAAQ,UAAA;YACAsB,IAAA;UACA;UAEA,IAAAW,SAAA,CAAAV,IAAA;YACA,KAAAJ,QAAA,CAAAC,KAAA,CAAAa,