{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getMyForumPage } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  components: {\n    headerPage,\n    bottomPage\n  },\n  filters: {\n    truncate(value, length) {\n      if (!value) return '';\n      if (value.length <= length) return value;\n      return value.substring(0, length) + '...';\n    }\n  },\n  data() {\n    return {\n      pageSize: 10,\n      pageNumber: 1,\n      tableData: [],\n      total: 0\n    };\n  },\n  methods: {\n    toForum() {\n      this.$router.push(\"/forum\");\n    },\n    toForumInfo(id) {\n      this.$router.push(\"/forumInfo?id=\" + id);\n    },\n    query() {\n      var param = {\n        pageSize: this.pageSize,\n        pageNumber: this.pageNumber\n      };\n      getMyForumPage(param).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records;\n          this.total = res.data.total;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    handleCurrentChange(val) {\n      this.pageNumber = val;\n      this.query();\n    }\n  },\n  mounted() {\n    this.query();\n  }\n};","map":{"version":3,"names":["getMyForumPage","headerPage","bottomPage","components","filters","truncate","value","length","substring","data","pageSize","pageNumber","tableData","total","methods","toForum","$router","push","toForumInfo","id","query","param","then","res","code","records","$notify","error","title","message","handleCurrentChange","val","mounted"],"sources":["src/views/forum/myForum.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-forum\">\r\n    <headerPage></headerPage>\r\n    <div class=\"my-forum-content\">\r\n      <div class=\"my-forum-header\">\r\n        <div class=\"header-title\">\r\n          <i class=\"el-icon-chat-dot-round\"></i>\r\n          我的帖子\r\n        </div>\r\n        <div class=\"header-desc\">我发布的全部帖子</div>\r\n      </div>\r\n\r\n      <!-- 帖子列表 -->\r\n      <div class=\"forum-list\">\r\n        <div v-if=\"tableData.length <= 0\" class=\"empty-data\">\r\n          <el-empty description=\"还没有发布过帖子，快去发布吧！\">\r\n            <el-button type=\"primary\" @click=\"toForum\">去发布帖子</el-button>\r\n          </el-empty>\r\n        </div>\r\n        <div v-else>\r\n          <div v-for=\"(item,index) in tableData\" :key=\"index\" class=\"forum-card\" @click=\"toForumInfo(item.id)\">\r\n            <div class=\"card-header\">\r\n              <div class=\"card-title\">{{ item.name }}</div>\r\n              <div class=\"card-time\">\r\n                <i class=\"el-icon-time\"></i> {{ item.createTime }}\r\n              </div>\r\n            </div>\r\n            <div class=\"card-content\">{{ item.content | truncate(100) }}</div>\r\n            <div class=\"card-footer\">\r\n              <span class=\"card-stats\">\r\n                <i class=\"el-icon-star-off\"></i> {{ item.likeCount || 0 }}\r\n              </span>\r\n              <span class=\"card-stats\">\r\n                <i class=\"el-icon-chat-dot-round\"></i> {{ item.commentCount || 0 }}\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 分页 -->\r\n      <div class=\"my-forum-fenye\" v-if=\"tableData.length > 0\">\r\n        <el-pagination\r\n            background\r\n            :page-size=\"pageSize\"\r\n            layout=\"total, prev, pager, next\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMyForumPage } from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\n\r\nexport default {\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  filters: {\r\n    truncate(value, length) {\r\n      if (!value) return ''\r\n      if (value.length <= length) return value\r\n      return value.substring(0, length) + '...'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      pageSize: 10,\r\n      pageNumber: 1,\r\n      tableData: [],\r\n      total: 0\r\n    }\r\n  },\r\n  methods: {\r\n    toForum() {\r\n      this.$router.push(\"/forum\")\r\n    },\r\n    toForumInfo(id) {\r\n      this.$router.push(\"/forumInfo?id=\" + id)\r\n    },\r\n    query() {\r\n      var param = {\r\n        pageSize: this.pageSize,\r\n        pageNumber: this.pageNumber\r\n      }\r\n      getMyForumPage(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.tableData = res.data.records\r\n          this.total = res.data.total\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          })\r\n        }\r\n      })\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pageNumber = val\r\n      this.query()\r\n    }\r\n  },\r\n  mounted() {\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-forum {\r\n  width: 100%;\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #f5f7fa 0%, #f0f2f5 100%);\r\n}\r\n\r\n.my-forum-content {\r\n  width: 70%;\r\n  max-width: 1000px;\r\n  margin: 0 auto;\r\n  padding: 30px 0;\r\n}\r\n\r\n.my-forum-header {\r\n  text-align: center;\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.header-title {\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n  color: #20B486;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.header-title i {\r\n  margin-right: 10px;\r\n}\r\n\r\n.header-desc {\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.forum-list {\r\n  min-height: 400px;\r\n}\r\n\r\n.empty-data {\r\n  text-align: center;\r\n  padding: 60px 0;\r\n}\r\n\r\n.forum-card {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 20px 24px;\r\n  margin-bottom: 16px;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);\r\n  border: 1px solid #f0f0f0;\r\n}\r\n\r\n.forum-card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);\r\n  border-color: #20B486;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 12px;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.card-title {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #333;\r\n}\r\n\r\n.card-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.card-time i {\r\n  margin-right: 4px;\r\n}\r\n\r\n.card-content {\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  color: #666;\r\n  margin-bottom: 12px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n}\r\n\r\n.card-footer {\r\n  display: flex;\r\n  gap: 24px;\r\n  padding-top: 12px;\r\n  border-top: 1px solid #f5f5f5;\r\n}\r\n\r\n.card-stats {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n  color: #999;\r\n}\r\n\r\n.card-stats i {\r\n  font-size: 14px;\r\n}\r\n\r\n.my-forum-fenye {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n}\r\n\r\n.my-forum-fenye ::v-deep .el-pagination.is-background .el-pager li:not(.disabled).active {\r\n  background-color: #20B486;\r\n}\r\n\r\n/* 响应式 */\r\n@media (max-width: 768px) {\r\n  .my-forum-content {\r\n    width: 95%;\r\n    padding: 20px 0;\r\n  }\r\n\r\n  .header-title {\r\n    font-size: 22px;\r\n  }\r\n\r\n  .forum-card {\r\n    padding: 15px 18px;\r\n  }\r\n\r\n  .card-title {\r\n    font-size: 16px;\r\n  }\r\n}\r\n</style>"],"mappings":";AAwDA,SAAAA,cAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AAEA;EACAC,UAAA;IACAF,UAAA;IACAC;EACA;EACAE,OAAA;IACAC,SAAAC,KAAA,EAAAC,MAAA;MACA,KAAAD,KAAA;MACA,IAAAA,KAAA,CAAAC,MAAA,IAAAA,MAAA,SAAAD,KAAA;MACA,OAAAA,KAAA,CAAAE,SAAA,IAAAD,MAAA;IACA;EACA;EACAE,KAAA;IACA;MACAC,QAAA;MACAC,UAAA;MACAC,SAAA;MACAC,KAAA;IACA;EACA;EACAC,OAAA;IACAC,QAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,YAAAC,EAAA;MACA,KAAAH,OAAA,CAAAC,IAAA,oBAAAE,EAAA;IACA;IACAC,MAAA;MACA,IAAAC,KAAA;QACAX,QAAA,OAAAA,QAAA;QACAC,UAAA,OAAAA;MACA;MACAX,cAAA,CAAAqB,KAAA,EAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAZ,SAAA,GAAAW,GAAA,CAAAd,IAAA,CAAAgB,OAAA;UACA,KAAAZ,KAAA,GAAAU,GAAA,CAAAd,IAAA,CAAAI,KAAA;QACA;UACA,KAAAa,OAAA,CAAAC,KAAA;YACAC,KAAA;YACAC,OAAA,EAAAN,GAAA,CAAAM;UACA;QACA;MACA;IACA;IACAC,oBAAAC,GAAA;MACA,KAAApB,UAAA,GAAAoB,GAAA;MACA,KAAAX,KAAA;IACA;EACA;EACAY,QAAA;IACA,KAAAZ,KAAA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}