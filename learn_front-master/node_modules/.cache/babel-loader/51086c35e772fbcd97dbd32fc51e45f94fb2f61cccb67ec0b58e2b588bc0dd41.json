{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeMyTaskPage } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      search: {\n        state: 0,\n        pageSize: 12,\n        pageNumber: 1\n      },\n      tableData: [],\n      total: 0\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    toTask() {\n      this.$router.push(\"/task\");\n    },\n    query() {\n      getApeMyTaskPage(this.search).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records || [];\n          this.total = res.data.total || 0;\n        } else {\n          this.$message.error(res.message || '加载失败');\n        }\n      }).catch(err => {\n        console.error('加载我的课程失败:', err);\n        this.$message.error('加载失败，请稍后重试');\n      });\n    },\n    handleCurrentChange(val) {\n      this.search.pageNumber = val;\n      this.query();\n    },\n    toTaskInfo(id) {\n      this.$router.push(\"taskInfo?id=\" + id);\n    }\n  },\n  created() {},\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeMyTaskPage","headerPage","bottomPage","data","search","state","pageSize","pageNumber","tableData","total","components","methods","toTask","$router","push","query","then","res","code","records","$message","error","message","catch","err","console","handleCurrentChange","val","toTaskInfo","id","created","mounted","window","scrollTo","top","behavior"],"sources":["src/views/task/myTask.vue"],"sourcesContent":["<template>\r\n  <div class=\"task\">\r\n    <headerPage></headerPage>\r\n    <div class=\"task-page-content\">\r\n      <div class=\"task-font\">我的课程</div>\r\n      <div class=\"task-page-list\">\r\n        <div v-if=\"tableData.length <= 0\" class=\"empty-data\">\r\n          <el-empty description=\"还没有加入任何课程，快去报名吧！\">\r\n            <el-button type=\"primary\" @click=\"toTask\">去选课</el-button>\r\n          </el-empty>\r\n        </div>\r\n        <div v-else>\r\n          <div @click=\"toTaskInfo(item.taskId)\" v-for=\"(item,index) in tableData\" :key=\"index\" class=\"task-page-item\">\r\n            <div class=\"task-page-image\">\r\n              <img style=\"width:100%;height:100%\" :src=\"$store.state.HOST + item.image\">\r\n            </div>\r\n            <div class=\"task-page-name\">\r\n              <div class=\"task-page-name-one\">{{item.taskName}}</div>\r\n              <div class=\"task-page-name-two\">{{item.taskDescribe}}</div>\r\n            </div>\r\n            <div class=\"task-page-user\">\r\n              <div>讲师：{{item.teacherName}}</div>\r\n              <div>\r\n                学习进度：\r\n                <i class=\"el-icon-data-line\"></i>\r\n                {{item.progress || 0}}%\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"task-page-fenye\" v-if=\"tableData.length > 0\">\r\n        <el-pagination\r\n            background\r\n            :page-size=\"search.pageSize\"\r\n            layout=\"prev, pager, next\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeMyTaskPage} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      search: {\r\n        state: 0,\r\n        pageSize: 12,\r\n        pageNumber: 1\r\n      },\r\n      tableData: [],\r\n      total: 0\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    toTask() {\r\n      this.$router.push(\"/task\")\r\n    },\r\n    query() {\r\n      getApeMyTaskPage(this.search).then(res => {\r\n        if (res.code == 1000) {\r\n          this.tableData = res.data.records || []\r\n          this.total = res.data.total || 0\r\n        } else {\r\n          this.$message.error(res.message || '加载失败')\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载我的课程失败:', err)\r\n        this.$message.error('加载失败，请稍后重试')\r\n      })\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.search.pageNumber = val\r\n      this.query()\r\n    },\r\n    toTaskInfo(id) {\r\n      this.$router.push(\"taskInfo?id=\" + id)\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/task/task.css\");\r\n\r\n\r\n</style>"],"mappings":";AA8CA,SAAAA,gBAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,MAAA;QACAC,KAAA;QACAC,QAAA;QACAC,UAAA;MACA;MACAC,SAAA;MACAC,KAAA;IACA;EACA;EACAC,UAAA;IACAT,UAAA;IACAC;EACA;EACAS,OAAA;IACAC,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,MAAA;MACAf,gBAAA,MAAAI,MAAA,EAAAY,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAV,SAAA,GAAAS,GAAA,CAAAd,IAAA,CAAAgB,OAAA;UACA,KAAAV,KAAA,GAAAQ,GAAA,CAAAd,IAAA,CAAAM,KAAA;QACA;UACA,KAAAW,QAAA,CAAAC,KAAA,CAAAJ,GAAA,CAAAK,OAAA;QACA;MACA,GAAAC,KAAA,CAAAC,GAAA;QACAC,OAAA,CAAAJ,KAAA,cAAAG,GAAA;QACA,KAAAJ,QAAA,CAAAC,KAAA;MACA;IACA;IACAK,oBAAAC,GAAA;MACA,KAAAvB,MAAA,CAAAG,UAAA,GAAAoB,GAAA;MACA,KAAAZ,KAAA;IACA;IACAa,WAAAC,EAAA;MACA,KAAAhB,OAAA,CAAAC,IAAA,kBAAAe,EAAA;IACA;EACA;EACAC,QAAA,GAEA;EACAC,QAAA;IACAC,MAAA,CAAAC,QAAA;MACAC,GAAA;MACAC,QAAA;IACA;IACA,KAAApB,KAAA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}