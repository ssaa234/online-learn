{"ast":null,"code":"export default {\n  name: 'CommentItem',\n  props: {\n    comment: {\n      type: Object,\n      required: true\n    }\n  },\n  data() {\n    return {\n      defaultAvatar: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n    };\n  },\n  methods: {\n    formatTime(time) {\n      if (!time) return '';\n      const date = new Date(time);\n      const now = new Date();\n      const diff = now - date;\n      const minute = 60 * 1000;\n      const hour = 60 * minute;\n      const day = 24 * hour;\n      if (diff < minute) {\n        return '刚刚';\n      } else if (diff < hour) {\n        return Math.floor(diff / minute) + '分钟前';\n      } else if (diff < day) {\n        return Math.floor(diff / hour) + '小时前';\n      } else if (diff < 7 * day) {\n        return Math.floor(diff / day) + '天前';\n      } else {\n        return `${date.getMonth() + 1}-${date.getDate()}`;\n      }\n    },\n    handleAvatarError(e) {\n      e.target.src = this.defaultAvatar;\n    }\n  }\n};","map":{"version":3,"names":["name","props","comment","type","Object","required","data","defaultAvatar","methods","formatTime","time","date","Date","now","diff","minute","hour","day","Math","floor","getMonth","getDate","handleAvatarError","e","target","src"],"sources":["src/components/CommentItem.vue"],"sourcesContent":["<template>\r\n  <div class=\"comment-item-wrapper\">\r\n    <!-- 主评论 -->\r\n    <div class=\"comment-item\" :class=\"{ 'has-child': comment.replies && comment.replies.length > 0 }\">\r\n      <div class=\"comment-avatar\">\r\n        <img :src=\"comment.avatar || defaultAvatar\" @error=\"handleAvatarError\" alt=\"头像\">\r\n      </div>\r\n      <div class=\"comment-content\">\r\n        <div class=\"comment-author\">{{ comment.createBy }}</div>\r\n        <div class=\"comment-text\">{{ comment.content }}</div>\r\n        <div class=\"comment-meta\">\r\n          <span class=\"comment-time\">{{ formatTime(comment.createTime) }}</span>\r\n          <span class=\"comment-like\" @click=\"$emit('like', comment)\">\r\n            <i :class=\"comment.isLiked ? 'el-icon-star-on liked' : 'el-icon-star-off'\"></i>\r\n            <span>{{ comment.likeCount || 0 }}</span>\r\n          </span>\r\n          <span class=\"comment-reply\" @click=\"$emit('reply', comment)\">回复</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 子评论区域（所有子评论都在第二层，平铺展示） -->\r\n    <div v-if=\"comment.replies && comment.replies.length > 0\" class=\"sub-comments\">\r\n      <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"sub-comment-item\">\r\n        <div class=\"sub-comment-avatar\">\r\n          <img :src=\"reply.avatar || defaultAvatar\" @error=\"handleAvatarError\" alt=\"头像\">\r\n        </div>\r\n        <div class=\"sub-comment-content\">\r\n          <div class=\"sub-comment-author\">\r\n            <span class=\"author-name\">{{ reply.createBy }}</span>\r\n            <span v-if=\"reply.replyTo\" class=\"reply-to\">\r\n              <i class=\"el-icon-caret-right\"></i>\r\n              {{ reply.replyTo }}\r\n            </span>\r\n          </div>\r\n          <div class=\"sub-comment-text\">{{ reply.content }}</div>\r\n          <div class=\"sub-comment-meta\">\r\n            <span class=\"sub-comment-time\">{{ formatTime(reply.createTime) }}</span>\r\n            <span class=\"sub-comment-like\" @click=\"$emit('like', reply)\">\r\n              <i :class=\"reply.isLiked ? 'el-icon-star-on liked' : 'el-icon-star-off'\"></i>\r\n              <span>{{ reply.likeCount || 0 }}</span>\r\n            </span>\r\n            <span class=\"sub-comment-reply\" @click=\"$emit('reply', reply)\">回复</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CommentItem',\r\n  props: {\r\n    comment: {\r\n      type: Object,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      defaultAvatar: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    }\r\n  },\r\n  methods: {\r\n    formatTime(time) {\r\n      if (!time) return ''\r\n      const date = new Date(time)\r\n      const now = new Date()\r\n      const diff = now - date\r\n      const minute = 60 * 1000\r\n      const hour = 60 * minute\r\n      const day = 24 * hour\r\n\r\n      if (diff < minute) {\r\n        return '刚刚'\r\n      } else if (diff < hour) {\r\n        return Math.floor(diff / minute) + '分钟前'\r\n      } else if (diff < day) {\r\n        return Math.floor(diff / hour) + '小时前'\r\n      } else if (diff < 7 * day) {\r\n        return Math.floor(diff / day) + '天前'\r\n      } else {\r\n        return `${date.getMonth() + 1}-${date.getDate()}`\r\n      }\r\n    },\r\n    handleAvatarError(e) {\r\n      e.target.src = this.defaultAvatar\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.comment-item-wrapper {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n/* 主评论样式 */\r\n.comment-item {\r\n  display: flex;\r\n  gap: 12px;\r\n  padding: 12px 0;\r\n}\r\n\r\n.comment-avatar img {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.comment-content {\r\n  flex: 1;\r\n}\r\n\r\n.comment-author {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #333;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.comment-text {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #222;\r\n  margin-bottom: 8px;\r\n  word-break: break-word;\r\n}\r\n\r\n.comment-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.comment-time {\r\n  color: #999;\r\n}\r\n\r\n.comment-like,\r\n.comment-reply {\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  transition: color 0.2s;\r\n}\r\n\r\n.comment-like:hover,\r\n.comment-reply:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.comment-like i.liked {\r\n  color: #ff4d4f;\r\n}\r\n\r\n/* 子评论区域 - 第二层平铺 */\r\n.sub-comments {\r\n  margin-left: 52px;\r\n  margin-top: 8px;\r\n  background-color: #f8f9fa;\r\n  border-radius: 12px;\r\n  padding: 8px 0;\r\n}\r\n\r\n.sub-comment-item {\r\n  display: flex;\r\n  gap: 10px;\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n.sub-comment-item:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.sub-comment-avatar img {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.sub-comment-content {\r\n  flex: 1;\r\n}\r\n\r\n.sub-comment-author {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: #333;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.sub-comment-author .author-name {\r\n  color: #20B486;\r\n  font-weight: 500;\r\n}\r\n\r\n.sub-comment-author .reply-to {\r\n  color: #666;\r\n  font-weight: normal;\r\n  margin-left: 4px;\r\n}\r\n\r\n.sub-comment-author .reply-to i {\r\n  font-size: 12px;\r\n  margin: 0 2px;\r\n}\r\n\r\n.sub-comment-text {\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  color: #444;\r\n  margin-bottom: 6px;\r\n  word-break: break-word;\r\n}\r\n\r\n.sub-comment-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  font-size: 11px;\r\n  color: #999;\r\n}\r\n\r\n.sub-comment-time {\r\n  color: #999;\r\n}\r\n\r\n.sub-comment-like,\r\n.sub-comment-reply {\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 3px;\r\n  transition: color 0.2s;\r\n}\r\n\r\n.sub-comment-like:hover,\r\n.sub-comment-reply:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.sub-comment-like i.liked {\r\n  color: #ff4d4f;\r\n}\r\n\r\n/* 分割线效果 */\r\n.has-child {\r\n  border-bottom: none;\r\n}\r\n</style>"],"mappings":"AAmDA;EACAA,IAAA;EACAC,KAAA;IACAC,OAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,QAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,aAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAAC,IAAA;MACA,KAAAA,IAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,IAAA;MACA,MAAAG,GAAA,OAAAD,IAAA;MACA,MAAAE,IAAA,GAAAD,GAAA,GAAAF,IAAA;MACA,MAAAI,MAAA;MACA,MAAAC,IAAA,QAAAD,MAAA;MACA,MAAAE,GAAA,QAAAD,IAAA;MAEA,IAAAF,IAAA,GAAAC,MAAA;QACA;MACA,WAAAD,IAAA,GAAAE,IAAA;QACA,OAAAE,IAAA,CAAAC,KAAA,CAAAL,IAAA,GAAAC,MAAA;MACA,WAAAD,IAAA,GAAAG,GAAA;QACA,OAAAC,IAAA,CAAAC,KAAA,CAAAL,IAAA,GAAAE,IAAA;MACA,WAAAF,IAAA,OAAAG,GAAA;QACA,OAAAC,IAAA,CAAAC,KAAA,CAAAL,IAAA,GAAAG,GAAA;MACA;QACA,UAAAN,IAAA,CAAAS,QAAA,UAAAT,IAAA,CAAAU,OAAA;MACA;IACA;IACAC,kBAAAC,CAAA;MACAA,CAAA,CAAAC,MAAA,CAAAC,GAAA,QAAAlB,aAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}