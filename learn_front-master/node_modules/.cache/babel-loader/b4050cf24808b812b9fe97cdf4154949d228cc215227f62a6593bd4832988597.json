{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getUserPage } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      searchData: {\n        userName: \"\",\n        userType: 1,\n        pageSize: 12,\n        pageNumber: 1\n      },\n      tableData: [],\n      total: 0,\n      loading: false\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    searchPage() {\n      this.searchData.pageNumber = 1;\n      this.query();\n    },\n    query() {\n      this.loading = true;\n      getUserPage(this.searchData).then(res => {\n        this.loading = false;\n        if (res.code == 1000) {\n          this.tableData = res.data.records || [];\n          this.total = res.data.total || 0;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      }).catch(() => {\n        this.loading = false;\n      });\n    },\n    refresh() {\n      this.searchData = {\n        userName: \"\",\n        userType: 1,\n        pageSize: 12,\n        pageNumber: 1\n      };\n      this.query();\n    },\n    handleCurrentChange(val) {\n      this.searchData.pageNumber = val;\n      this.query();\n    },\n    toTeacherInfo(id) {\n      this.$router.push(\"/teacherInfo?id=\" + id);\n    },\n    getAvatarUrl(avatar) {\n      // 如果没有头像，返回空字符串（不显示图片）\n      if (!avatar) {\n        return '';\n      }\n      // 如果是完整URL，直接返回\n      if (avatar.startsWith('http')) {\n        return avatar;\n      }\n      // 否则拼接后端地址\n      return this.$store.state.HOST + avatar;\n    }\n  },\n  mounted() {\n    this.query();\n  }\n};","map":{"version":3,"names":["getUserPage","headerPage","bottomPage","data","searchData","userName","userType","pageSize","pageNumber","tableData","total","loading","components","methods","searchPage","query","then","res","code","records","$notify","error","title","message","catch","refresh","handleCurrentChange","val","toTeacherInfo","id","$router","push","getAvatarUrl","avatar","startsWith","$store","state","HOST","mounted"],"sources":["src/views/teacher/teacher.vue"],"sourcesContent":["<template>\r\n  <div class=\"teacher\">\r\n    <headerPage></headerPage>\r\n    <div class=\"teacher-page-content\">\r\n      <!-- 搜索区域 - K12风格 -->\r\n      <div class=\"teacher-page-search\">\r\n        <div class=\"search-container\">\r\n          <div class=\"search-box\">\r\n            <i class=\"el-icon-search search-icon\"></i>\r\n            <el-input\r\n                size=\"medium\"\r\n                v-model=\"searchData.userName\"\r\n                placeholder=\"搜索老师名字...\"\r\n                clearable\r\n                @keyup.enter.native=\"searchPage()\"\r\n                class=\"search-input\">\r\n            </el-input>\r\n            <el-button type=\"primary\" size=\"medium\" @click=\"searchPage()\" class=\"search-btn\">找老师</el-button>\r\n          </div>\r\n          <div class=\"search-tip\">\r\n            <i class=\"el-icon-info\"></i> 共有 {{ total }} 位优秀老师\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 教师列表 -->\r\n      <div class=\"teacher-list\">\r\n        <div\r\n            @click=\"toTeacherInfo(item.id)\"\r\n            v-for=\"(item,index) in tableData\"\r\n            :key=\"index\"\r\n            class=\"teacher-card\">\r\n          <div class=\"card-avatar\">\r\n            <img :src=\"getAvatarUrl(item.avatar)\">\r\n            <div class=\"card-badge\" v-if=\"item.agree\">\r\n              {{ item.agree }}\r\n            </div>\r\n          </div>\r\n          <div class=\"card-info\">\r\n            <div class=\"teacher-name\">\r\n              <span>{{ item.userName }}</span>\r\n            </div>\r\n            <div class=\"teacher-remark\">\r\n              {{ item.remark || '这位老师很认真，还没有留下介绍~' }}\r\n            </div>\r\n            <div class=\"teacher-stats\">\r\n              <span><i class=\"el-icon-collection\"></i> {{ item.courseCount || 0 }}门课程</span>\r\n              <span><i class=\"el-icon-user\"></i> {{ item.studentCount || 0 }}名学生</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 空状态 -->\r\n      <div v-if=\"tableData.length === 0 && !loading\" class=\"empty-state\">\r\n        <i class=\"el-icon-notebook-2\"></i>\r\n        <p>暂无相关老师，试试其他关键词吧~</p>\r\n      </div>\r\n\r\n      <!-- 分页 -->\r\n      <div class=\"pagination-wrapper\">\r\n        <el-pagination\r\n            background\r\n            :page-size=\"searchData.pageSize\"\r\n            layout=\"prev, pager, next\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\"\r\n            v-if=\"total > 0\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getUserPage} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\n\r\nexport default {\r\n  data() {\r\n    return{\r\n      searchData: {\r\n        userName: \"\",\r\n        userType: 1,\r\n        pageSize: 12,\r\n        pageNumber: 1\r\n      },\r\n      tableData: [],\r\n      total: 0,\r\n      loading: false\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    searchPage() {\r\n      this.searchData.pageNumber = 1\r\n      this.query()\r\n    },\r\n    query() {\r\n      this.loading = true\r\n      getUserPage(this.searchData).then(res => {\r\n        this.loading = false\r\n        if(res.code == 1000) {\r\n          this.tableData = res.data.records || []\r\n          this.total = res.data.total || 0\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      }).catch(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    refresh() {\r\n      this.searchData = {\r\n        userName: \"\",\r\n        userType: 1,\r\n        pageSize: 12,\r\n        pageNumber: 1\r\n      }\r\n      this.query()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.searchData.pageNumber = val\r\n      this.query()\r\n    },\r\n    toTeacherInfo(id) {\r\n      this.$router.push(\"/teacherInfo?id=\" + id)\r\n    },\r\n    getAvatarUrl(avatar) {\r\n      // 如果没有头像，返回空字符串（不显示图片）\r\n      if (!avatar) {\r\n        return ''\r\n      }\r\n      // 如果是完整URL，直接返回\r\n      if (avatar.startsWith('http')) {\r\n        return avatar\r\n      }\r\n      // 否则拼接后端地址\r\n      return this.$store.state.HOST + avatar\r\n    }\r\n  },\r\n  mounted() {\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/teacher/teacher.css\");\r\n</style>"],"mappings":";AA4EA,SAAAA,WAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AAEA;EACAC,KAAA;IACA;MACAC,UAAA;QACAC,QAAA;QACAC,QAAA;QACAC,QAAA;QACAC,UAAA;MACA;MACAC,SAAA;MACAC,KAAA;MACAC,OAAA;IACA;EACA;EACAC,UAAA;IACAX,UAAA;IACAC;EACA;EACAW,OAAA;IACAC,WAAA;MACA,KAAAV,UAAA,CAAAI,UAAA;MACA,KAAAO,KAAA;IACA;IACAA,MAAA;MACA,KAAAJ,OAAA;MACAX,WAAA,MAAAI,UAAA,EAAAY,IAAA,CAAAC,GAAA;QACA,KAAAN,OAAA;QACA,IAAAM,GAAA,CAAAC,IAAA;UACA,KAAAT,SAAA,GAAAQ,GAAA,CAAAd,IAAA,CAAAgB,OAAA;UACA,KAAAT,KAAA,GAAAO,GAAA,CAAAd,IAAA,CAAAO,KAAA;QACA;UACA,KAAAU,OAAA,CAAAC,KAAA;YACAC,KAAA;YACAC,OAAA,EAAAN,GAAA,CAAAM;UACA;QACA;MACA,GAAAC,KAAA;QACA,KAAAb,OAAA;MACA;IACA;IACAc,QAAA;MACA,KAAArB,UAAA;QACAC,QAAA;QACAC,QAAA;QACAC,QAAA;QACAC,UAAA;MACA;MACA,KAAAO,KAAA;IACA;IACAW,oBAAAC,GAAA;MACA,KAAAvB,UAAA,CAAAI,UAAA,GAAAmB,GAAA;MACA,KAAAZ,KAAA;IACA;IACAa,cAAAC,EAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,sBAAAF,EAAA;IACA;IACAG,aAAAC,MAAA;MACA;MACA,KAAAA,MAAA;QACA;MACA;MACA;MACA,IAAAA,MAAA,CAAAC,UAAA;QACA,OAAAD,MAAA;MACA;MACA;MACA,YAAAE,MAAA,CAAAC,KAAA,CAAAC,IAAA,GAAAJ,MAAA;IACA;EACA;EACAK,QAAA;IACA,KAAAvB,KAAA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}