{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeForumPage, saveApeForum } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      pageSize: 10,\n      pageNumber: 1,\n      tableData: [],\n      total: 0,\n      notice: {},\n      // 发布帖子相关\n      postDialogVisible: false,\n      submitting: false,\n      postForm: {\n        name: '',\n        content: ''\n      },\n      postRules: {\n        name: [{\n          required: true,\n          message: '请输入帖子标题',\n          trigger: 'blur'\n        }, {\n          min: 1,\n          max: 100,\n          message: '标题长度在1-100个字符之间',\n          trigger: 'blur'\n        }],\n        content: [{\n          required: true,\n          message: '请输入帖子内容',\n          trigger: 'blur'\n        }, {\n          min: 1,\n          max: 500,\n          message: '内容长度在1-500个字符之间',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    toForumInfo(id) {\n      this.$router.push(\"forumInfo?id=\" + id);\n    },\n    query() {\n      var param = {\n        pageSize: this.pageSize,\n        pageNumber: this.pageNumber\n      };\n      getApeForumPage(param).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records;\n          this.total = res.data.total;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    handleCurrentChange(val) {\n      this.pageNumber = val;\n      this.query();\n    },\n    // 打开发布帖子对话框\n    openPostDialog() {\n      this.postForm = {\n        name: '',\n        content: ''\n      };\n      this.postDialogVisible = true;\n    },\n    // 关闭对话框\n    handleClose() {\n      this.postDialogVisible = false;\n      this.$refs.postFormRef?.resetFields();\n    },\n    // 提交帖子\n    submitPost() {\n      this.$refs.postFormRef.validate(async valid => {\n        if (valid) {\n          this.submitting = true;\n          try {\n            const params = {\n              name: this.postForm.name,\n              content: this.postForm.content\n            };\n            const res = await saveApeForum(params);\n            if (res.code == 1000) {\n              this.$message({\n                message: '发布成功',\n                type: 'success',\n                duration: 1500\n              });\n              this.postDialogVisible = false;\n              this.$refs.postFormRef.resetFields();\n              // 刷新列表，回到第一页\n              this.pageNumber = 1;\n              this.query();\n            } else {\n              this.$message.error(res.message || '发布失败');\n            }\n          } catch (error) {\n            this.$message.error('发布失败，请稍后重试');\n          } finally {\n            this.submitting = false;\n          }\n        }\n      });\n    }\n  },\n  created() {},\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeForumPage","saveApeForum","headerPage","bottomPage","data","pageSize","pageNumber","tableData","total","notice","postDialogVisible","submitting","postForm","name","content","postRules","required","message","trigger","min","max","components","methods","toForumInfo","id","$router","push","query","param","then","res","code","records","$notify","error","title","handleCurrentChange","val","openPostDialog","handleClose","$refs","postFormRef","resetFields","submitPost","validate","valid","params","$message","type","duration","created","mounted","window","scrollTo","top","behavior"],"sources":["src/views/forum/forum.vue"],"sourcesContent":["<template>\r\n  <div class=\"notice\">\r\n    <headerPage></headerPage>\r\n    <div class=\"notice-page-content\">\r\n      <div class=\"notice-page-header\">\r\n        <div class=\"notice-page-title\">\r\n          讨论列表\r\n        </div>\r\n        <div class=\"notice-page-btn\">\r\n          <el-button type=\"primary\" size=\"small\" icon=\"el-icon-edit\" @click=\"openPostDialog\">发布帖子</el-button>\r\n        </div>\r\n      </div>\r\n      <div class=\"notice-page-list\">\r\n        <div v-for=\"(item,index) in tableData\" :key=\"index\" class=\"notice-page-item\">\r\n          <div @click=\"toForumInfo(item.id)\" style=\"margin-left:20px\">\r\n            {{index + 1}}. {{item.name}} - {{item.createBy}}\r\n          </div>\r\n          <div style=\"margin-right:20px\">\r\n            <i class=\"el-icon-arrow-right\"></i>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"notice-page-fenye\">\r\n        <el-pagination\r\n            background\r\n            :page-size=\"pageSize\"\r\n            layout=\"prev, pager, next\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布帖子对话框 -->\r\n    <el-dialog\r\n        title=\"发布新帖子\"\r\n        :visible.sync=\"postDialogVisible\"\r\n        width=\"500px\"\r\n        :before-close=\"handleClose\">\r\n      <el-form :model=\"postForm\" :rules=\"postRules\" ref=\"postFormRef\" label-width=\"80px\">\r\n        <el-form-item label=\"标题\" prop=\"name\">\r\n          <el-input\r\n              v-model=\"postForm.name\"\r\n              placeholder=\"请输入帖子标题\"\r\n              maxlength=\"100\"\r\n              show-word-limit>\r\n          </el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"内容\" prop=\"content\">\r\n          <el-input\r\n              type=\"textarea\"\r\n              v-model=\"postForm.content\"\r\n              placeholder=\"请输入帖子内容\"\r\n              :rows=\"8\"\r\n              maxlength=\"500\"\r\n              show-word-limit>\r\n          </el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n            <el-button @click=\"postDialogVisible = false\">取 消</el-button>\r\n            <el-button type=\"primary\" @click=\"submitPost\" :loading=\"submitting\">发 布</el-button>\r\n        </span>\r\n    </el-dialog>\r\n\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeForumPage, saveApeForum} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      pageSize: 10,\r\n      pageNumber: 1,\r\n      tableData: [],\r\n      total: 0,\r\n      notice: {},\r\n      // 发布帖子相关\r\n      postDialogVisible: false,\r\n      submitting: false,\r\n      postForm: {\r\n        name: '',\r\n        content: ''\r\n      },\r\n      postRules: {\r\n        name: [\r\n          { required: true, message: '请输入帖子标题', trigger: 'blur' },\r\n          { min: 1, max: 100, message: '标题长度在1-100个字符之间', trigger: 'blur' }\r\n        ],\r\n        content: [\r\n          { required: true, message: '请输入帖子内容', trigger: 'blur' },\r\n          { min: 1, max: 500, message: '内容长度在1-500个字符之间', trigger: 'blur' }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    toForumInfo(id) {\r\n      this.$router.push(\"forumInfo?id=\"+id)\r\n    },\r\n    query() {\r\n      var param = {\r\n        pageSize: this.pageSize,\r\n        pageNumber: this.pageNumber,\r\n      }\r\n      getApeForumPage(param).then(res => {\r\n        if(res.code == 1000) {\r\n          this.tableData = res.data.records\r\n          this.total = res.data.total\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pageNumber = val\r\n      this.query()\r\n    },\r\n    // 打开发布帖子对话框\r\n    openPostDialog() {\r\n      this.postForm = { name: '', content: '' }\r\n      this.postDialogVisible = true\r\n    },\r\n    // 关闭对话框\r\n    handleClose() {\r\n      this.postDialogVisible = false\r\n      this.$refs.postFormRef?.resetFields()\r\n    },\r\n    // 提交帖子\r\n    submitPost() {\r\n      this.$refs.postFormRef.validate(async (valid) => {\r\n        if (valid) {\r\n          this.submitting = true\r\n          try {\r\n            const params = {\r\n              name: this.postForm.name,\r\n              content: this.postForm.content\r\n            }\r\n            const res = await saveApeForum(params)\r\n            if (res.code == 1000) {\r\n              this.$message({\r\n                message: '发布成功',\r\n                type: 'success',\r\n                duration: 1500\r\n              })\r\n              this.postDialogVisible = false\r\n              this.$refs.postFormRef.resetFields()\r\n              // 刷新列表，回到第一页\r\n              this.pageNumber = 1\r\n              this.query()\r\n            } else {\r\n              this.$message.error(res.message || '发布失败')\r\n            }\r\n          } catch (error) {\r\n            this.$message.error('发布失败，请稍后重试')\r\n          } finally {\r\n            this.submitting = false\r\n          }\r\n        }\r\n      })\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/notice/notice.css\");\r\n\r\n/* 新增头部样式 */\r\n.notice-page-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 20px;\r\n  padding: 0 20px;\r\n}\r\n\r\n.notice-page-btn {\r\n  flex-shrink: 0;\r\n}\r\n\r\n</style>"],"mappings":";AAsEA,SAAAA,eAAA,EAAAC,YAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,UAAA;MACAC,SAAA;MACAC,KAAA;M