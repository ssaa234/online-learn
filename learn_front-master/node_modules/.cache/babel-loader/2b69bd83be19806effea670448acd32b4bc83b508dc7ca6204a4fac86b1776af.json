{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeArticlePage, removeApeArticle } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      user: {},\n      title: \"\",\n      taskName: \"\",\n      taskId: \"\",\n      currentCourseName: \"\",\n      pageSize: 10,\n      pageNumber: 1,\n      tableData: [],\n      total: 0\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    formatDate(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      const year = date.getFullYear();\n      const month = String(date.getMonth() + 1).padStart(2, '0');\n      const day = String(date.getDate()).padStart(2, '0');\n      const hours = String(date.getHours()).padStart(2, '0');\n      const minutes = String(date.getMinutes()).padStart(2, '0');\n      return `${year}-${month}-${day} ${hours}:${minutes}`;\n    },\n    getAvatarUrl(item) {\n      if (item.avatar) {\n        return this.$store.state.HOST + item.avatar;\n      }\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    toAddArticle() {\n      this.$router.push(\"/addArticle\");\n    },\n    deleteArticle(id, index) {\n      this.$confirm('确定要删除这篇笔记吗？删除后无法恢复！', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        removeApeArticle({\n          ids: id\n        }).then(res => {\n          if (res.code == 1000) {\n            this.$message.success('删除成功');\n            this.tableData.splice(index, 1);\n            this.total--;\n            if (this.tableData.length === 0 && this.pageNumber > 1) {\n              this.pageNumber--;\n              this.query();\n            }\n          } else {\n            this.$message.error(res.message || '删除失败');\n          }\n        });\n      }).catch(() => {\n        this.$message.info('已取消删除');\n      });\n    },\n    query() {\n      var param = {\n        state: 0,\n        userId: this.user.id,\n        pageSize: this.pageSize,\n        pageNumber: this.pageNumber,\n        type: 0\n      };\n      // 如果有课程名称参数，添加到查询条件中\n      if (this.taskName) {\n        param.taskName = this.taskName;\n      }\n      getApeArticlePage(param).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records;\n          this.total = res.data.total;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    handleCurrentChange(val) {\n      this.pageNumber = val;\n      this.query();\n    },\n    toArticleInfo(id) {\n      this.$router.push(\"/articleInfo?id=\" + id);\n    }\n  },\n  created() {},\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\"));\n\n    // 获取路由参数\n    const routeTaskName = this.$route.query.taskName;\n    const routeTaskId = this.$route.query.taskId;\n    if (routeTaskName) {\n      this.taskName = decodeURIComponent(routeTaskName);\n      this.currentCourseName = this.taskName;\n    }\n    if (routeTaskId) {\n      this.taskId = routeTaskId;\n    }\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeArticlePage","removeApeArticle","headerPage","bottomPage","data","user","title","taskName","taskId","currentCourseName","pageSize","pageNumber","tableData","total","components","methods","formatDate","dateStr","date","Date","year","getFullYear","month","String","getMonth","padStart","day","getDate","hours","getHours","minutes","getMinutes","getAvatarUrl","item","avatar","$store","state","HOST","toAddArticle","$router","push","deleteArticle","id","index","$confirm","confirmButtonText","cancelButtonText","type","then","ids","res","code","$message","success","splice","length","query","error","message","catch","info","param","userId","records","$notify","handleCurrentChange","val","toArticleInfo","created","mounted","window","scrollTo","top","behavior","JSON","parse","localStorage","getItem","routeTaskName","$route","routeTaskId","decodeURIComponent"],"sources":["src/views/article/myArticle.vue"],"sourcesContent":["<template>\r\n  <div class=\"article\">\r\n    <headerPage></headerPage>\r\n    <div class=\"article-page-content\">\r\n      <div class=\"article-page-header-info\">\r\n        <div class=\"article-page-title\">我的笔记</div>\r\n        <div class=\"article-page-current-course\" v-if=\"currentCourseName\">\r\n          <i class=\"el-icon-reading\"></i> 当前课程：{{ currentCourseName }}\r\n        </div>\r\n      </div>\r\n      <div class=\"article-page-list\">\r\n        <div v-if=\"tableData.length <= 0\" class=\"empty-data\">\r\n          <el-empty description=\"还没有笔记，快去记笔记吧！\">\r\n            <el-button type=\"primary\" @click=\"toAddArticle\">记笔记</el-button>\r\n          </el-empty>\r\n        </div>\r\n        <div v-else>\r\n          <div @click=\"toArticleInfo(item.id)\" v-for=\"(item,index) in tableData\" :key=\"index\" class=\"article-page-item\">\r\n            <div class=\"article-page-header\">\r\n              <div class=\"article-page-image\"><img src=\"../../assets/image/index/Vector (1).png\"></div>\r\n              <div class=\"article-page-user\">\r\n                <img class=\"article-page-avatar\" :src=\"getAvatarUrl(item)\">\r\n                <div class=\"article-page-username\">\r\n                  <div>{{item.createBy}} - {{formatDate(item.createTime)}}</div>\r\n                  <div class=\"article-course-name\">\r\n                    <i class=\"el-icon-reading\"></i> 课程：{{item.taskName || '未关联课程'}}\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"article-page-title-content\">\r\n              <div class=\"article-page-title-text\">{{item.title}}</div>\r\n              <div class=\"article-page-font\">{{item.articleDesc}}</div>\r\n            </div>\r\n            <div class=\"article-page-actions\">\r\n              <el-button size=\"mini\" type=\"danger\" icon=\"el-icon-delete\" circle @click.stop=\"deleteArticle(item.id, index)\"></el-button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"article-page-fenye\" v-if=\"tableData.length > 0\">\r\n        <el-pagination\r\n            background\r\n            :page-size=\"pageSize\"\r\n            layout=\"prev, pager, next\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeArticlePage, removeApeArticle} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      user: {},\r\n      title: \"\",\r\n      taskName: \"\",\r\n      taskId: \"\",\r\n      currentCourseName: \"\",\r\n      pageSize: 10,\r\n      pageNumber: 1,\r\n      tableData: [],\r\n      total: 0\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    formatDate(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      const year = date.getFullYear()\r\n      const month = String(date.getMonth() + 1).padStart(2, '0')\r\n      const day = String(date.getDate()).padStart(2, '0')\r\n      const hours = String(date.getHours()).padStart(2, '0')\r\n      const minutes = String(date.getMinutes()).padStart(2, '0')\r\n      return `${year}-${month}-${day} ${hours}:${minutes}`\r\n    },\r\n    getAvatarUrl(item) {\r\n      if (item.avatar) {\r\n        return this.$store.state.HOST + item.avatar\r\n      }\r\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n    toAddArticle() {\r\n      this.$router.push(\"/addArticle\")\r\n    },\r\n    deleteArticle(id, index) {\r\n      this.$confirm('确定要删除这篇笔记吗？删除后无法恢复！', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        removeApeArticle({ids: id}).then(res => {\r\n          if (res.code == 1000) {\r\n            this.$message.success('删除成功')\r\n            this.tableData.splice(index, 1)\r\n            this.total--\r\n            if (this.tableData.length === 0 && this.pageNumber > 1) {\r\n              this.pageNumber--\r\n              this.query()\r\n            }\r\n          } else {\r\n            this.$message.error(res.message || '删除失败')\r\n          }\r\n        })\r\n      }).catch(() => {\r\n        this.$message.info('已取消删除')\r\n      })\r\n    },\r\n    query() {\r\n      var param = {\r\n        state: 0,\r\n        userId: this.user.id,\r\n        pageSize: this.pageSize,\r\n        pageNumber: this.pageNumber,\r\n        type: 0,\r\n      }\r\n      // 如果有课程名称参数，添加到查询条件中\r\n      if (this.taskName) {\r\n        param.taskName = this.taskName\r\n      }\r\n      getApeArticlePage(param).then(res => {\r\n        if(res.code == 1000) {\r\n          this.tableData = res.data.records\r\n          this.total = res.data.total\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pageNumber = val\r\n      this.query()\r\n    },\r\n    toArticleInfo(id) {\r\n      this.$router.push(\"/articleInfo?id=\"+id)\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    this.user = JSON.parse(window.localStorage.getItem(\"user_info\"))\r\n\r\n    // 获取路由参数\r\n    const routeTaskName = this.$route.query.taskName\r\n    const routeTaskId = this.$route.query.taskId\r\n    if (routeTaskName) {\r\n      this.taskName = decodeURIComponent(routeTaskName)\r\n      this.currentCourseName = this.taskName\r\n    }\r\n    if (routeTaskId) {\r\n      this.taskId = routeTaskId\r\n    }\r\n\r\n    this.query()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/article.css\");\r\n\r\n/* 新增样式 */\r\n.article-page-header-info {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 20px;\r\n  flex-wrap: wrap;\r\n  gap: 15px;\r\n}\r\n\r\n.article-page-current-course {\r\n  font-size: 14px;\r\n  color: #20B486;\r\n  background: #e8f5e9;\r\n  padding: 6px 15px;\r\n  border-radius: 20px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n.article-page-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.article-page-user {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex: 1;\r\n}\r\n\r\n.article-page-avatar {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.article-page-username {\r\n  flex: 1;\r\n}\r\n\r\n.article-page-username div:first-child {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #20B486;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.article-course-name {\r\n  font-size: 12px;\r\n  color: #999;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.article-course-name i {\r\n  font-size: 12px;\r\n}\r\n\r\n.article-page-title-content {\r\n  margin-top: 12px;\r\n  padding-left: 56px;\r\n  position: relative;\r\n}\r\n\r\n.article-page-title-text {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 8px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.article-page-font {\r\n  font-size: 13px;\r\n  color: #666;\r\n  line-height: 1.5;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n}\r\n\r\n.article-page-actions {\r\n  position: absolute;\r\n  right: 10px;\r\n  top: 10px;\r\n}\r\n\r\n.empty-data {\r\n  text-align: center;\r\n  padding: 60px 0;\r\n}\r\n</style>"],"mappings":";AAuDA,SAAAA,iBAAA,EAAAC,gBAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,KAAA;MACAC,QAAA;MACAC,MAAA;MACAC,iBAAA;MACAC,QAAA;MACAC,UAAA;MACAC,SAAA;MACAC,KAAA;IACA;EACA;EACAC,UAAA;IACAZ,UAAA;IACAC;EACA;EACAY,OAAA;IACAC,WAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,MAAAG,IAAA,GAAAF,IAAA,CAAAG,WAAA;MACA,MAAAC,KAAA,GAAAC,MAAA,CAAAL,IAAA,CAAAM,QAAA,QAAAC,QAAA;MACA,MAAAC,GAAA,GAAAH,MAAA,CAAAL,IAAA,CAAAS,OAAA,IAAAF,QAAA;MACA,MAAAG,KAAA,GAAAL,MAAA,CAAAL,IAAA,CAAAW,QAAA,IAAAJ,QAAA;MACA,MAAAK,OAAA,GAAAP,MAAA,CAAAL,IAAA,CAAAa,UAAA,IAAAN,QAAA;MACA,UAAAL,IAAA,IAAAE,KAAA,IAAAI,GAAA,IAAAE,KAAA,IAAAE,OAAA;IACA;IACAE,aAAAC,IAAA;MACA,IAAAA,IAAA,CAAAC,MAAA;QACA,YAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,GAAAJ,IAAA,CAAAC,MAAA;MACA;MACA;IACA;IACAI,aAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,cAAAC,EAAA,EAAAC,KAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA/C,gBAAA;UAAAgD,GAAA,EAAAP;QAAA,GAAAM,IAAA,CAAAE,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAC,QAAA,CAAAC,OAAA;YACA,KAAAzC,SAAA,CAAA0C,MAAA,CAAAX,KAAA;YACA,KAAA9B,KAAA;YACA,SAAAD,SAAA,CAAA2C,MAAA,eAAA5C,UAAA;cACA,KAAAA,UAAA;cACA,KAAA6C,KAAA;YACA;UACA;YACA,KAAAJ,QAAA,CAAAK,KAAA,CAAAP,GAAA,CAAAQ,OAAA;UACA;QACA;MACA,GAAAC,KAAA;QACA,KAAAP,QAAA,CAAAQ,IAAA;MACA;IACA;IACAJ,MAAA;MACA,IAAAK,KAAA;QACAzB,KAAA;QACA0B,MAAA,OAAAzD,IAAA,CAAAqC,EAAA;QACAhC,QAAA,OAAAA,QAAA;QACAC,UAAA,OAAAA,UAAA;QACAoC,IAAA;MACA;MACA;MACA,SAAAxC,QAAA;QACAsD,KAAA,CAAAtD,QAAA,QAAAA,QAAA;MACA;MACAP,iBAAA,CAAA6D,KAAA,EAAAb,IAAA,CAAAE,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAvC,SAAA,GAAAsC,GAAA,CAAA9C,IAAA,CAAA2D,OAAA;UACA,KAAAlD,KAAA,GAAAqC,GAAA,CAAA