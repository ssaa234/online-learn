{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeTaskPage, getApeClassificationList } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      search: {\n        name: \"\",\n        state: 0,\n        teacherName: \"\",\n        educationStage: \"\",\n        textbook: \"\",\n        classification: \"\",\n        pageSize: 12,\n        pageNumber: 1,\n        type: 0\n      },\n      // 小学教材选项\n      primaryTextbookOptions: [{\n        value: 'dalian',\n        label: '大连版'\n      }, {\n        value: 'dianzigongye_anhui',\n        label: '电子工业版(安徽)'\n      }, {\n        value: 'huazhongshida',\n        label: '华中师大版'\n      }, {\n        value: 'jiao_2024',\n        label: '冀教版(2024)'\n      },\n      // 其他教材选项...\n      {\n        value: 'zhongda_2023',\n        label: '重大版(2023)'\n      }],\n      // 初中教材选项\n      juniorTextbookOptions: [{\n        value: 'beishida',\n        label: '北师大版'\n      }, {\n        value: 'dalian',\n        label: '大连版'\n      }, {\n        value: 'hebeidaxue_2024',\n        label: '河北大学版(2024)'\n      },\n      // 其他初中教材选项...\n      {\n        value: 'yueke',\n        label: '粤科版'\n      }],\n      // 高中教材选项\n      seniorTextbookOptions: [{\n        value: 'hujiao',\n        label: '沪教版'\n      }, {\n        value: 'hujiao-2019',\n        label: '沪教版(2019)'\n      }, {\n        value: 'kejiao_2019',\n        label: '教科版(2019)'\n      }, {\n        value: 'yueke_2019',\n        label: '粤科版(2019)'\n      }, {\n        value: 'yueke',\n        label: '粤科版'\n      }, {\n        value: 'yueke',\n        label: '粤科版'\n      }],\n      currentTextbookOptions: [],\n      // 当前显示的教材选项\n      showTextbookSelect: false,\n      // 是否显示教材选择框\n      tableData: [],\n      classification: [],\n      total: 0\n    };\n  },\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    handleEducationStageChange() {\n      // 根据选择的学段设置当前显示的教材选项\n      if (this.search.educationStage === 'primary') {\n        this.currentTextbookOptions = this.primaryTextbookOptions;\n      } else if (this.search.educationStage === 'junior') {\n        this.currentTextbookOptions = this.juniorTextbookOptions;\n      } else if (this.search.educationStage === 'senior') {\n        this.currentTextbookOptions = this.seniorTextbookOptions;\n      }\n      this.showTextbookSelect = true;\n    },\n    searchPage() {\n      this.search.pageNumber = 1;\n      this.query();\n    },\n    searchClass(name) {\n      this.search.pageNumber = 1;\n      this.search.classification = name;\n      this.query();\n    },\n    query() {\n      getApeTaskPage(this.search).then(res => {\n        if (res.code == 1000) {\n          this.tableData = res.data.records;\n          this.total = res.data.total;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    refresh() {\n      this.search = {\n        name: \"\",\n        teacherName: \"\",\n        major: \"\",\n        state: 0,\n        taskDescribe: \"\",\n        classification: \"\",\n        pageSize: 12,\n        pageNumber: 1,\n        type: 0\n      }, this.query();\n    },\n    handleCurrentChange(val) {\n      this.search.pageNumber = val;\n      this.query();\n    },\n    toTaskInfo(id) {\n      this.$router.push(\"taskInfo?id=\" + id);\n    },\n    getApeClassificationList() {\n      getApeClassificationList().then(res => {\n        if (res.code == 1000) {\n          this.classification = res.data;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    }\n  },\n  created() {},\n  mounted() {\n    this.getApeClassificationList();\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    var name = this.$route.query.name;\n    if (name) {\n      this.search.name = name;\n    }\n    var major = this.$route.query.major;\n    if (major) {\n      this.search.major = major;\n    }\n    this.query();\n  }\n};","map":{"version":3,"names":["getApeTaskPage","getApeClassificationList","headerPage","bottomPage","data","search","name","state","teacherName","educationStage","textbook","classification","pageSize","pageNumber","type","primaryTextbookOptions","value","label","juniorTextbookOptions","seniorTextbookOptions","currentTextbookOptions","showTextbookSelect","tableData","total","components","methods","handleEducationStageChange","searchPage","query","searchClass","then","res","code","records","$notify","error","title","message","refresh","major","taskDescribe","handleCurrentChange","val","toTaskInfo","id","$router","push","created","mounted","window","scrollTo","top","behavior","$route"],"sources":["src/views/task/task.vue"],"sourcesContent":["<template>\r\n  <div class=\"task\">\r\n    <headerPage></headerPage>\r\n    <div class=\"task-page-content\">\r\n      <div class=\"task-page-search\">\r\n        <div class=\"task-search-item\">\r\n          <div>课程名称：</div>\r\n          <div>\r\n            <el-input size=\"mini\" v-model=\"search.name\" placeholder=\"请输入课程名称\"></el-input>\r\n          </div>\r\n        </div>\r\n        <div class=\"task-search-item\">\r\n          <div>教师名称：</div>\r\n          <div>\r\n            <el-input size=\"mini\" v-model=\"search.teacherName\" placeholder=\"请输入教师名称\"></el-input>\r\n          </div>\r\n        </div>\r\n        <div class=\"task-search-item\">\r\n          <div>学段：</div>\r\n          <div>\r\n            <el-select size=\"mini\" v-model=\"search.educationStage\" placeholder=\"请选择学段\" @change=\"handleEducationStageChange\">\r\n              <el-option label=\"小学\" value=\"primary\"></el-option>\r\n              <el-option label=\"初中\" value=\"junior\"></el-option>\r\n              <el-option label=\"高中\" value=\"senior\"></el-option>\r\n            </el-select>\r\n          </div>\r\n        </div>\r\n        <div class=\"task-search-item\" v-if=\"showTextbookSelect\">\r\n          <div>教材：</div>\r\n          <div>\r\n            <el-select size=\"mini\" v-model=\"search.textbook\" placeholder=\"请选择教材\">\r\n              <el-option\r\n                  v-for=\"item in currentTextbookOptions\"\r\n                  :key=\"item.value\"\r\n                  :label=\"item.label\"\r\n                  :value=\"item.value\"\r\n              />\r\n            </el-select>\r\n          </div>\r\n        </div>\r\n        <div class=\"task-search-item\">\r\n          <el-button icon=\"el-icon-search\" size=\"mini\" type=\"primary\" plain @click=\"searchPage()\">搜索</el-button>\r\n          <el-button icon=\"el-icon-refresh\" size=\"mini\" type=\"warning\" plain @click=\"refresh()\">重置</el-button>\r\n        </div>\r\n        <div class=\"task-search-item\" style=\"width:100%;flex-wrap: wrap;\">\r\n          <span style=\"margin-right:10px\">分类：</span>\r\n          <span class=\"task-search-type\" @click=\"searchClass(item.name)\" v-for=\"(item,index) in classification\" :key=\"index\">{{item.name}}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"task-font\">课程列表</div>\r\n      <div class=\"task-page-list\">\r\n        <div @click=\"toTaskInfo(item.id)\" v-for=\"(item,index) in tableData\" :key=\"index\" class=\"task-page-item\">\r\n          <div class=\"task-page-image\">\r\n            <img style=\"width:100%;height:100%\" :src=\"$store.state.HOST + item.image\">\r\n          </div>\r\n          <div class=\"task-page-name\">\r\n            <div class=\"task-page-name-one\">{{item.name}}</div>\r\n            <div class=\"task-page-name-two\">{{item.taskDescribe}}</div>\r\n          </div>\r\n          <div class=\"task-page-user\">\r\n            <div>讲师：{{item.teacherName}}</div>\r\n            <div>\r\n              学生：\r\n              <i class=\"el-icon-star-off\"></i>\r\n              {{item.num}}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"task-page-fenye\">\r\n        <el-pagination\r\n          background\r\n          :page-size=\"search.pageSize\"\r\n          layout=\"prev, pager, next\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n    <div class=\"task-page-bottom\">\r\n      <img style=\"width:70%\" src=\"../../assets/image/15.png\">\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n  import {getApeTaskPage,getApeClassificationList} from '../../api/api' \r\n  import headerPage from \"../../components/header/header\"\r\n  import bottomPage from \"../../components/bottom/bottom\"\r\n  export default {\r\n    data() {\r\n      return{\r\n        search: {\r\n          name: \"\",\r\n          state: 0,\r\n          teacherName: \"\",\r\n          educationStage: \"\",\r\n          textbook: \"\",\r\n          classification: \"\",\r\n          pageSize: 12,\r\n          pageNumber: 1,\r\n          type: 0,\r\n        },\r\n        // 小学教材选项\r\n        primaryTextbookOptions: [\r\n          { value: 'dalian', label: '大连版' },\r\n          { value: 'dianzigongye_anhui', label: '电子工业版(安徽)' },\r\n          { value: 'huazhongshida', label: '华中师大版' },\r\n          { value: 'jiao_2024', label: '冀教版(2024)' },\r\n          // 其他教材选项...\r\n          { value: 'zhongda_2023', label: '重大版(2023)' }\r\n        ],\r\n        // 初中教材选项\r\n        juniorTextbookOptions: [\r\n          { value: 'beishida', label: '北师大版' },\r\n          { value: 'dalian', label: '大连版' },\r\n          { value: 'hebeidaxue_2024', label: '河北大学版(2024)' },\r\n          // 其他初中教材选项...\r\n          { value: 'yueke', label: '粤科版' }\r\n        ],\r\n        // 高中教材选项\r\n        seniorTextbookOptions: [\r\n          { value: 'hujiao', label: '沪教版' },\r\n          { value: 'hujiao-2019', label: '沪教版(2019)' },\r\n          { value: 'kejiao_2019', label: '教科版(2019)' },\r\n          { value: 'yueke_2019', label: '粤科版(2019)' },\r\n          { value: 'yueke', label: '粤科版' },\r\n          { value: 'yueke', label: '粤科版' }\r\n        ],\r\n        currentTextbookOptions: [], // 当前显示的教材选项\r\n        showTextbookSelect: false, // 是否显示教材选择框\r\n        tableData: [],\r\n        classification: [],\r\n        total: 0\r\n      }\r\n    },\r\n    components: {\r\n      headerPage,\r\n      bottomPage\r\n    },\r\n    methods: {\r\n      handleEducationStageChange() {\r\n        // 根据选择的学段设置当前显示的教材选项\r\n        if (this.search.educationStage === 'primary') {\r\n          this.currentTextbookOptions = this.primaryTextbookOptions;\r\n        } else if (this.search.educationStage === 'junior') {\r\n          this.currentTextbookOptions = this.juniorTextbookOptions;\r\n        } else if (this.search.educationStage ==='senior') {\r\n          this.currentTextbookOptions = this.seniorTextbookOptions;\r\n        }\r\n        this.showTextbookSelect = true;\r\n      },\r\n      searchPage() {\r\n        this.search.pageNumber = 1\r\n        this.query()\r\n      },\r\n      searchClass(name) {\r\n        this.search.pageNumber = 1\r\n        this.search.classification = name\r\n        this.query()\r\n      },\r\n      query() {\r\n        getApeTaskPage(this.search).then(res => {\r\n          if(res.code == 1000) {\r\n            this.tableData = res.data.records\r\n            this.total = res.data.total\r\n          } else {\r\n            this.$notify.error({\r\n              title: '错误',\r\n              message: res.message\r\n            });\r\n          }\r\n        })\r\n      },\r\n      refresh() {\r\n        this.search = {\r\n          name: \"\",\r\n          teacherName: \"\",\r\n          major: \"\",\r\n          state: 0,\r\n          taskDescribe: \"\",\r\n          classification: \"\",\r\n          pageSize: 12,\r\n          pageNumber: 1,\r\n          type: 0,\r\n        },\r\n        this.query()\r\n      },\r\n      handleCurrentChange(val) {\r\n        this.search.pageNumber = val\r\n        this.query()\r\n      }, \r\n      toTaskInfo(id) {\r\n        this.$router.push(\"taskInfo?id=\" + id)\r\n      },\r\n      getApeClassificationList() {\r\n        getApeClassificationList().then(res => {\r\n            if(res.code == 1000) {\r\n                this.classification = res.data\r\n            } else {\r\n                this.$notify.error({\r\n                title: '错误',\r\n                message: res.message\r\n                });\r\n            }\r\n        })\r\n      }\r\n    },\r\n    created() {\r\n     \r\n    },\r\n    mounted() {\r\n      this.getApeClassificationList()\r\n      window.scrollTo({\r\n        top: 0,\r\n        behavior: 'smooth'\r\n      });\r\n      var name = this.$route.query.name\r\n      if (name) {\r\n        this.search.name = name\r\n      }\r\n      var major = this.$route.query.major\r\n      if (major) {\r\n        this.search.major = major\r\n      }\r\n      this.query()\r\n    }\r\n }\r\n</script>\r\n\r\n<style scoped>\r\n  @import url(\"../../assets/css/task/task.css\");\r\n</style>"],"mappings":";AAuFA,SAAAA,cAAA,EAAAC,wBAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,MAAA;QACAC,IAAA;QACAC,KAAA;QACAC,WAAA;QACAC,cAAA;QACAC,QAAA;QACAC,cAAA;QACAC,QAAA;QACAC,UAAA;QACAC,IAAA;MACA;MACA;MACAC,sBAAA,GACA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA;MACA;MACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,EACA;MACA;MACAC,qBAAA,GACA;QAAAF,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA;MACA;MACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,EACA;MACA;MACAE,qBAAA,GACA;QAAAH,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,EACA;MACAG,sBAAA;MAAA;