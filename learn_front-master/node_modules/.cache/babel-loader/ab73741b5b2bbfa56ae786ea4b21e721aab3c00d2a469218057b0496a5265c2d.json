{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nimport CommentItem from '../../components/CommentItem.vue';\nexport default {\n  components: {\n    headerPage,\n    bottomPage,\n    CommentItem\n  },\n  data() {\n    return {\n      id: \"\",\n      user: {},\n      forum: {},\n      content: \"\",\n      forumList: [],\n      likeCount: 0,\n      isLiked: false,\n      parentId: '0',\n      replyUserName: ''\n    };\n  },\n  computed: {\n    totalComments() {\n      const countComments = list => {\n        let count = 0;\n        for (const item of list) {\n          count += 1;\n          if (item.children && item.children.length > 0) {\n            count += countComments(item.children);\n          }\n        }\n        return count;\n      };\n      return countComments(this.forumList);\n    }\n  },\n  methods: {\n    handleAvatarError(e) {\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    likePost() {\n      const params = {\n        targetId: this.id,\n        type: 1\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          this.isLiked = !this.isLiked;\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1);\n          this.$message({\n            message: this.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    likeComment(item) {\n      const params = {\n        targetId: item.id,\n        type: 2\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          item.isLiked = !item.isLiked;\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1);\n          this.$forceUpdate();\n          this.$message({\n            message: item.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    replyToUser(item) {\n      this.replyUserName = item.userName;\n      this.parentId = item.id;\n      this.content = '';\n      this.$nextTick(() => {\n        const textarea = document.querySelector('.comment-textarea textarea');\n        if (textarea) textarea.focus();\n      });\n      this.$message.info(`正在回复 ${item.userName}`);\n    },\n    cancelReply() {\n      this.parentId = '0';\n      this.replyUserName = '';\n      this.content = '';\n    },\n    saveApeForumItem() {\n      if (!this.content.trim()) {\n        this.$message({\n          type: 'warning',\n          message: '请输入回复内容'\n        });\n        return;\n      }\n      var param = {\n        forumId: this.id,\n        content: this.content,\n        parentId: this.parentId || '0'\n      };\n      saveApeForumItem(param).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '发布成功!'\n          });\n          this.content = \"\";\n          this.cancelReply();\n          this.getApeForumItemList();\n        } else {\n          this.$message.error(res.message);\n        }\n      }).catch(() => {\n        this.$message.error('发布失败，请稍后重试');\n      });\n    },\n    getApeForumById() {\n      getApeForumById({\n        id: this.id\n      }).then(res => {\n        if (res.code == 1000) {\n          this.forum = res.data;\n          this.likeCount = res.data.likeCount || 0;\n          this.isLiked = res.data.isLiked || false;\n        }\n      });\n    },\n    getApeForumItemList() {\n      var param = {\n        forumId: this.id\n      };\n      getApeForumItemList(param).then(res => {\n        if (res.code == 1000) {\n          // 构建树形结构\n          this.forumList = this.buildCommentTree(res.data || []);\n        }\n      });\n    },\n    buildCommentTree(comments) {\n      const commentMap = new Map();\n      const result = [];\n      comments.forEach(comment => {\n        comment.children = [];\n        commentMap.set(comment.id, comment);\n      });\n      comments.forEach(comment => {\n        if (comment.parentId && commentMap.has(comment.parentId)) {\n          const parent = commentMap.get(comment.parentId);\n          parent.children.push(comment);\n        } else {\n          result.push(comment);\n        }\n      });\n      result.sort((a, b) => new Date(b.createTime) - new Date(a.createTime));\n      result.forEach(comment => {\n        if (comment.children && comment.children.length > 0) {\n          comment.children.sort((a, b) => new Date(a.createTime) - new Date(b.createTime));\n        }\n      });\n      return result;\n    }\n  },\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.id = this.$route.query.id;\n    this.getApeForumById();\n    this.getApeForumItemList();\n  }\n};","map":{"version":3,"names":["getApeForumById","getApeForumItemList","saveApeForumItem","likeApeForum","headerPage","bottomPage","CommentItem","components","data","id","user","forum","content","forumList","likeCount","isLiked","parentId","replyUserName","computed","totalComments","countComments","list","count","item","children","length","methods","handleAvatarError","e","target","src","likePost","params","targetId","type","then","res","code","$message","message","duration","error","likeComment","$forceUpdate","replyToUser","userName","$nextTick","textarea","document","querySelector","focus","info","cancelReply","trim","param","forumId","catch","buildCommentTree","comments","commentMap","Map","result","forEach","comment","set","has","parent","get","push","sort","a","b","Date","createTime","mounted","window","scrollTo","top","behavior","$route","query"],"sources":["src/views/forum/forumInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <headerPage></headerPage>\r\n\r\n    <!-- 帖子详情 -->\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"post-container\">\r\n        <div class=\"post-header\">\r\n          <div class=\"post-author\">\r\n            <img class=\"author-avatar\" :src=\"$store.state.HOST + forum.avatar\" @error=\"handleAvatarError\">\r\n            <div class=\"author-info\">\r\n              <span class=\"author-name\">{{forum.createBy}}</span>\r\n              <span class=\"post-time\">\r\n                <i class=\"el-icon-time\"></i> {{forum.createTime}}\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div class=\"post-title\">{{forum.name}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-content\">\r\n          <div class=\"content-text\">{{forum.content}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-actions\">\r\n          <div class=\"action-item\" @click=\"likePost\">\r\n            <i class=\"el-icon-thumb\" :class=\"{ 'liked': isLiked }\"></i>\r\n            <span>{{likeCount}}</span>\r\n          </div>\r\n          <div class=\"action-item\">\r\n            <i class=\"el-icon-chat-dot-round\"></i>\r\n            <span>{{totalComments}} 回复</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论输入区域 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-edit\"></i> 发表回复\r\n        </div>\r\n        <div class=\"comment-input\">\r\n          <div v-if=\"replyUserName\" class=\"reply-tip\">\r\n            正在回复 @{{replyUserName}}\r\n            <span @click=\"cancelReply\" class=\"cancel-reply\">取消</span>\r\n          </div>\r\n          <el-input\r\n              type=\"textarea\"\r\n              resize=\"none\"\r\n              rows=\"6\"\r\n              v-model=\"content\"\r\n              :placeholder=\"replyUserName ? `回复 ${replyUserName}...` : '写下你的评论...'\"\r\n              class=\"comment-textarea\">\r\n          </el-input>\r\n          <div class=\"comment-submit\">\r\n            <el-button @click=\"saveApeForumItem\" size=\"small\" type=\"primary\" plain>发布回复</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-chat-dot-round\"></i> 全部回复 ({{totalComments}})\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length <= 0\" class=\"empty-comment\">\r\n          <el-empty description=\"还没有回复，快来抢沙发吧！\"></el-empty>\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length > 0\" class=\"comment-list\">\r\n          <!-- 使用递归组件渲染树状评论 -->\r\n          <CommentItem\r\n              v-for=\"item in forumList\"\r\n              :key=\"item.id\"\r\n              :comment=\"item\"\r\n              :level=\"0\"\r\n              @like=\"likeComment\"\r\n              @reply=\"replyToUser\" />\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nimport CommentItem from '../../components/CommentItem.vue'\r\n\r\nexport default {\r\n  components: {\r\n    headerPage,\r\n    bottomPage,\r\n    CommentItem\r\n  },\r\n  data() {\r\n    return{\r\n      id: \"\",\r\n      user: {},\r\n      forum: {},\r\n      content: \"\",\r\n      forumList: [],\r\n      likeCount: 0,\r\n      isLiked: false,\r\n      parentId: '0',\r\n      replyUserName: ''\r\n    }\r\n  },\r\n  computed: {\r\n    totalComments() {\r\n      const countComments = (list) => {\r\n        let count = 0\r\n        for (const item of list) {\r\n          count += 1\r\n          if (item.children && item.children.length > 0) {\r\n            count += countComments(item.children)\r\n          }\r\n        }\r\n        return count\r\n      }\r\n      return countComments(this.forumList)\r\n    }\r\n  },\r\n  methods: {\r\n    handleAvatarError(e) {\r\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n\r\n    likePost() {\r\n      const params = { targetId: this.id, type: 1 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          this.isLiked = !this.isLiked\r\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1)\r\n          this.$message({\r\n            message: this.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    likeComment(item) {\r\n      const params = { targetId: item.id, type: 2 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          item.isLiked = !item.isLiked\r\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1)\r\n          this.$forceUpdate()\r\n          this.$message({\r\n            message: item.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    replyToUser(item) {\r\n      this.replyUserName = item.userName\r\n      this.parentId = item.id\r\n      this.content = ''\r\n      this.$nextTick(() => {\r\n        const textarea = document.querySelector('.comment-textarea textarea')\r\n        if (textarea) textarea.focus()\r\n      })\r\n      this.$message.info(`正在回复 ${item.userName}`)\r\n    },\r\n\r\n    cancelReply() {\r\n      this.parentId = '0'\r\n      this.replyUserName = ''\r\n      this.content = ''\r\n    },\r\n\r\n    saveApeForumItem() {\r\n      if (!this.content.trim()) {\r\n        this.$message({ type: 'warning', message: '请输入回复内容' })\r\n        return\r\n      }\r\n      var param = {\r\n        forumId: this.id,\r\n        content: this.content,\r\n        parentId: this.parentId || '0'\r\n      }\r\n      saveApeForumItem(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.$message({ type: 'success', message: '发布成功!' })\r\n          this.content = \"\"\r\n          this.cancelReply()\r\n          this.getApeForumItemList()\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      }).catch(() => {\r\n        this.$message.error('发布失败，请稍后重试')\r\n      })\r\n    },\r\n\r\n    getApeForumById() {\r\n      getApeForumById({id: this.id}).then(res => {\r\n        if (res.code == 1000) {\r\n          this.forum = res.data\r\n          this.likeCount = res.data.likeCount || 0\r\n          this.isLiked = res.data.isLiked || false\r\n        }\r\n      })\r\n    },\r\n\r\n    getApeForumItemList() {\r\n      var param = { forumId: this.id }\r\n      getApeForumItemList(param).then(res => {\r\n        if (res.code == 1000) {\r\n          // 构建树形结构\r\n          this.forumList = this.buildCommentTree(res.data || [])\r\n        }\r\n      })\r\n    },\r\n\r\n    buildCommentTree(comments) {\r\n      const commentMap = new Map()\r\n      const result = []\r\n\r\n      comments.forEach(comment => {\r\n        comment.children = []\r\n        commentMap.set(comment.id, comment)\r\n      })\r\n\r\n      comments.forEach(comment => {\r\n        if (comment.parentId && commentMap.has(comment.parentId)) {\r\n          const parent = commentMap.get(comment.parentId)\r\n          parent.children.push(comment)\r\n        } else {\r\n          result.push(comment)\r\n        }\r\n      })\r\n\r\n      result.sort((a, b) => new Date(b.createTime) - new Date(a.createTime))\r\n      result.forEach(comment => {\r\n        if (comment.children && comment.children.length > 0) {\r\n          comment.children.sort((a, b) => new Date(a.createTime) - new Date(b.createTime))\r\n        }\r\n      })\r\n\r\n      return result\r\n    }\r\n  },\r\n  mounted() {\r\n    window.scrollTo({ top: 0, behavior: 'smooth' })\r\n    this.id = this.$route.query.id\r\n    this.getApeForumById()\r\n    this.getApeForumItemList()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/articleInfo.css\");\r\n\r\n/* 帖子容器样式 */\r\n.post-container {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  margin: 30px auto;\r\n  width: 70%;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.post-header {\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.post-author {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.author-avatar {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.author-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.author-name {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #20B486;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.post-time i {\r\n  margin-right: 4px;\r\n}\r\n\r\n.post-title {\r\n  font-size: 22px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  line-height: 1.4;\r\n  padding-left: 60px;\r\n}\r\n\r\n.post-content {\r\n  margin-bottom: 24px;\r\n  min-height: 150px;\r\n  padding-left: 60px;\r\n}\r\n\r\n.content-text {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #555;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.post-actions {\r\n  display: flex;\r\n  gap: 30px;\r\n  paddi