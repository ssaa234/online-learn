{"ast":null,"code":"import { getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  components: {\n    headerPage,\n    bottomPage\n  },\n  data() {\n    return {\n      id: \"\",\n      user: {},\n      forum: {},\n      content: \"\",\n      forumList: [],\n      likeCount: 0,\n      isLiked: false,\n      parentId: null,\n      replyUserName: ''\n    };\n  },\n  methods: {\n    getUserAvatar(item) {\n      if (item.userAvatar) {\n        return this.$store.state.HOST + item.userAvatar;\n      }\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    formatTime(timeStr) {\n      if (!timeStr) return '';\n      if (timeStr.length > 16) {\n        return timeStr.substring(0, 16);\n      }\n      return timeStr;\n    },\n    handleAvatarError(e) {\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    likePost() {\n      const params = {\n        targetId: this.id,\n        type: 1\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          this.isLiked = !this.isLiked;\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1);\n          this.$message({\n            message: this.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    likeComment(item) {\n      const params = {\n        targetId: item.id,\n        type: 2\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          item.isLiked = !item.isLiked;\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1);\n          this.$forceUpdate();\n          this.$message({\n            message: item.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    replyToUser(item) {\n      this.replyUserName = item.userName || item.createBy;\n      this.parentId = item.id;\n      this.content = '';\n      this.$nextTick(() => {\n        if (this.$refs.commentInput) {\n          this.$refs.commentInput.focus();\n        }\n      });\n      this.$message.info(`正在回复 ${this.replyUserName}`);\n    },\n    cancelReply() {\n      this.parentId = null;\n      this.replyUserName = '';\n      this.content = '';\n    },\n    saveApeForumItem() {\n      if (!this.content.trim()) {\n        this.$message({\n          type: 'warning',\n          message: '请输入回复内容'\n        });\n        return;\n      }\n      var param = {\n        forumId: this.id,\n        content: this.content\n      };\n      if (this.parentId && this.parentId !== '0' && this.parentId !== 'null') {\n        param.parentId = this.parentId;\n      }\n      console.log('提交参数:', param);\n      saveApeForumItem(param).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '发布成功!'\n          });\n          this.content = \"\";\n          this.cancelReply();\n          this.getApeForumItemList();\n        } else {\n          this.$message.error(res.message);\n        }\n      }).catch(() => {\n        this.$message.error('发布失败，请稍后重试');\n      });\n    },\n    getApeForumById() {\n      getApeForumById({\n        id: this.id\n      }).then(res => {\n        if (res.code == 1000) {\n          this.forum = res.data;\n          this.likeCount = res.data.likeCount || 0;\n          this.isLiked = res.data.isLiked || false;\n        }\n      });\n    },\n    getApeForumItemList() {\n      var param = {\n        forumId: this.id\n      };\n      console.log('查询参数 forumId:', this.id);\n      getApeForumItemList(param).then(res => {\n        if (res.code == 1000) {\n          // 直接使用平铺数据，不再构建两层结构\n          this.forumList = res.data || [];\n          console.log('===== 平铺评论数据 =====');\n          console.log('总评论数:', this.forumList.length);\n          this.forumList.forEach(item => {\n            console.log(`ID: ${item.id}, 用户: ${item.userName}, parentId: ${item.parentId}, replyTo: ${item.replyTo}`);\n          });\n        }\n      });\n    }\n  },\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.id = this.$route.query.id;\n    this.getApeForumById();\n    this.getApeForumItemList();\n  }\n};","map":{"version":3,"names":["getApeForumById","getApeForumItemList","saveApeForumItem","likeApeForum","headerPage","bottomPage","components","data","id","user","forum","content","forumList","likeCount","isLiked","parentId","replyUserName","methods","getUserAvatar","item","userAvatar","$store","state","HOST","formatTime","timeStr","length","substring","handleAvatarError","e","target","src","likePost","params","targetId","type","then","res","code","$message","message","duration","error","likeComment","$forceUpdate","replyToUser","userName","createBy","$nextTick","$refs","commentInput","focus","info","cancelReply","trim","param","forumId","console","log","catch","forEach","replyTo","mounted","window","scrollTo","top","behavior","$route","query"],"sources":["src/views/forum/forumInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <headerPage></headerPage>\r\n\r\n    <!-- 帖子详情 -->\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"post-container\">\r\n        <div class=\"post-header\">\r\n          <div class=\"post-author\">\r\n            <img class=\"author-avatar\" :src=\"$store.state.HOST + forum.avatar\" @error=\"handleAvatarError\">\r\n            <div class=\"author-info\">\r\n              <span class=\"author-name\">{{forum.createBy}}</span>\r\n              <span class=\"post-time\">\r\n                <i class=\"el-icon-time\"></i> {{formatTime(forum.createTime)}}\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div class=\"post-title\">{{forum.name}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-content\">\r\n          <div class=\"content-text\">{{forum.content}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-actions\">\r\n          <div class=\"action-item\" @click=\"likePost\">\r\n            <i class=\"el-icon-thumb\" :class=\"{ 'liked': isLiked }\"></i>\r\n            <span>{{likeCount}}</span>\r\n          </div>\r\n          <div class=\"action-item\">\r\n            <i class=\"el-icon-chat-dot-round\"></i>\r\n            <span>{{forumList.length}} 回复</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布评论区域 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-edit\"></i> 发表回复\r\n        </div>\r\n        <div class=\"comment-input\">\r\n          <div v-if=\"replyUserName\" class=\"reply-tip\">\r\n            正在回复 @{{replyUserName}}\r\n            <span @click=\"cancelReply\" class=\"cancel-reply\">取消</span>\r\n          </div>\r\n          <el-input\r\n              type=\"textarea\"\r\n              resize=\"none\"\r\n              rows=\"4\"\r\n              v-model=\"content\"\r\n              placeholder=\"写下你的回复...\"\r\n              ref=\"commentInput\">\r\n          </el-input>\r\n          <div class=\"comment-submit\">\r\n            <el-button @click=\"saveApeForumItem\" size=\"small\" type=\"primary\" plain>发布回复</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表（平铺样式） -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-chat-dot-round\"></i> 全部回复 ({{forumList.length}})\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length <= 0\" class=\"empty-comment\">\r\n          <el-empty description=\"还没有回复，快来抢沙发吧！\"></el-empty>\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length > 0\" class=\"comment-list\">\r\n          <div v-for=\"item in forumList\" :key=\"item.id\" class=\"comment-item-wrapper\">\r\n            <div class=\"comment-item\">\r\n              <div class=\"comment-avatar\">\r\n                <img :src=\"getUserAvatar(item)\" @error=\"handleAvatarError\">\r\n              </div>\r\n              <div class=\"comment-main\">\r\n                <div class=\"comment-header\">\r\n                  <span class=\"comment-author\">{{ item.userName || item.createBy }}</span>\r\n                  <span class=\"comment-time\">{{ formatTime(item.createTime) }}</span>\r\n                </div>\r\n                <!-- 显示 @ 回复对象 -->\r\n                <div class=\"comment-text\" v-if=\"item.parentId && item.parentId !== '0' && item.parentId !== 'null'\">\r\n                  <span class=\"reply-to\">@{{ item.replyTo }} </span>\r\n                  {{ item.content }}\r\n                </div>\r\n                <div class=\"comment-text\" v-else>\r\n                  {{ item.content }}\r\n                </div>\r\n                <div class=\"comment-footer\">\r\n                  <span class=\"comment-like\" @click=\"likeComment(item)\">\r\n                    <i class=\"el-icon-thumb\" :class=\"{ 'liked': item.isLiked }\"></i>\r\n                    {{ item.likeCount || 0 }}\r\n                  </span>\r\n                  <span class=\"comment-reply\" @click=\"replyToUser(item)\">回复</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\n\r\nexport default {\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  data() {\r\n    return{\r\n      id: \"\",\r\n      user: {},\r\n      forum: {},\r\n      content: \"\",\r\n      forumList: [],\r\n      likeCount: 0,\r\n      isLiked: false,\r\n      parentId: null,\r\n      replyUserName: ''\r\n    }\r\n  },\r\n  methods: {\r\n    getUserAvatar(item) {\r\n      if (item.userAvatar) {\r\n        return this.$store.state.HOST + item.userAvatar\r\n      }\r\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n    formatTime(timeStr) {\r\n      if (!timeStr) return ''\r\n      if (timeStr.length > 16) {\r\n        return timeStr.substring(0, 16)\r\n      }\r\n      return timeStr\r\n    },\r\n    handleAvatarError(e) {\r\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n\r\n    likePost() {\r\n      const params = { targetId: this.id, type: 1 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          this.isLiked = !this.isLiked\r\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1)\r\n          this.$message({\r\n            message: this.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    likeComment(item) {\r\n      const params = { targetId: item.id, type: 2 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          item.isLiked = !item.isLiked\r\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1)\r\n          this.$forceUpdate()\r\n          this.$message({\r\n            message: item.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    replyToUser(item) {\r\n      this.replyUserName = item.userName || item.createBy\r\n      this.parentId = item.id\r\n      this.content = ''\r\n      this.$nextTick(() => {\r\n        if (this.$refs.commentInput) {\r\n          this.$refs.commentInput.focus()\r\n        }\r\n      })\r\n      this.$message.info(`正在回复 ${this.replyUserName}`)\r\n    },\r\n\r\n    cancelReply() {\r\n      this.parentId = null\r\n      this.replyUserName = ''\r\n      this.content = ''\r\n    },\r\n\r\n    saveApeForumItem() {\r\n      if (!this.content.trim()) {\r\n        this.$message({ type: 'warning', message: '请输入回复内容' })\r\n        return\r\n      }\r\n      var param = {\r\n        forumId: this.id,\r\n        content: this.content\r\n      }\r\n      if (this.parentId && this.parentId !== '0' && this.parentId !== 'null') {\r\n        param.parentId = this.parentId\r\n      }\r\n      console.log('提交参数:', param)\r\n      saveApeForumItem(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.$message({ type: 'success', message: '发布成功!' })\r\n          this.content = \"\"\r\n          this.cancelReply()\r\n          this.getApeForumItemList()\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      }).catch(() => {\r\n        this.$message.error('发布失败，请稍后重试')\r\n      })\r\n    },\r\n\r\n    getApeForumById() {\r\n      getApeForumById({id: this.id}).then(res => {\r\n        if (res.code == 1000) {\r\n          this.forum = res.data\r\n          this.likeCount = res.data.likeCount || 0\r\n          this.isLiked = res.data.isLiked || false\r\n        }\r\n      })\r\n    },\r\n\r\n    getApeForumItemList() {\r\n      var param = { forumId: this.id }\r\n      console.log('查询参数 forumId:', this.id)\r\n      getApeForumItemList(param).then(res => {\r\n        if (res.code == 1000) {\r\n          // 直接使用平铺数据，不再构建两层结构\r\n          this.forumList = res.data || []\r\n          console.log('===== 平铺评论数据 =====')\r\n          console.log('总评论数:', this.forumList.length)\r\n          this.forumList.forEach(item => {\r\n            console.log(`ID: ${item.id}, 用户: ${item.userName}, parentId: ${item.parentId}, replyTo: ${item.replyTo}`)\r\n          })\r\n        }\r\n      })\r\n    }\r\n  },\r\n  mounted() {\r\n    window.scrollTo({ top: 0, behavior: 'smooth' })\r\n    this.id = this.$route.query.id\r\n    this.getApeForumById()\r\n    this.getApeForumItemList()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/articleInfo.css\");\r\n\r\n/* 帖子容器样式 */\r\n.post-container {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  margin: 30px auto;\r\n  width: 70%;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.post-header {\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.post-author {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.author-avatar {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.author-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.author-name {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #20B486;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.post-time i {\r\n  margin-right: 4px;\r\n}\r\n\r\n.post-title {\r\n  font-size: 22px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  line-height: 1.4;\r\n}\r\n\r\n.post-content {\r\n  margin-bottom: 24px;\r\n  min-height: 150px;\r\n}\r\n\r\n.content-text {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #555;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.post-actions {\r\n  display: flex;\r\n  gap: 30px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid #f0f0f0;\r\n}\r\n\r\n.action-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  color: #666;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.action-item:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.action-item i {\r\n  font-size: 18px;\r\n}\r\n\r\n.action-item i.liked {\r\n  color: #ff4d4f;\r\n}\r\n\r\n/* 评论区域 */\r\n.comment-section {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  margin-bottom: 30px;\r\n  width: 70%;\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);\r\n}\r\n\r\n.comment-title {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  padding-bottom: 12px;\r\n  border-bottom: 2px solid #f0f0f0;\r\n}\r\n\r\n.comment-title i {\r\n  margin-right: 8px;\r\n  color: #20B486;\r\n}\r\n\r\n.comment-input {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.comment-submit {\r\n  margin-top: 12px;\r\n  text-align: right;\r\n}\r\n\r\n.reply-tip {\r\n  background: #e8f5e9;\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  margin-bottom: 10px;\r\n  font-size: 13px;\r\n  color: #20B486;\r\n}\r\n\r\n.cancel-reply {\r\n  color: #999;\r\n  cursor: pointer;\r\n  margin-left: 10px;\r\n}\r\n\r\n.cancel-reply:hover {\r\n  color: #ff4444;\r\n}\r\n\r\n.empty-comment {\r\n  padding: 40px 0;\r\n}\r\n\r\n.comment-list {\r\n  max-height: 600px;\r\n  overflow-y: auto;\r\n}\r\n\r\n/* 平铺评论样式 */\r\n.comment-item-wrapper {\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.comment-item-wrapper:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.comment-item {\r\n  display: flex;\r\n  gap: 12px;\r\n  padding: 16px 0;\r\n}\r\n\r\n.comment-avatar img {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.comment-main {\r\n  flex: 1;\r\n}\r\n\r\n.comment-header {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 12px;\