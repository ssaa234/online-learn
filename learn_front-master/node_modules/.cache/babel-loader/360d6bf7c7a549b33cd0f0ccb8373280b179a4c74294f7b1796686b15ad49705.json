{"ast":null,"code":"import { getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      id: \"\",\n      user: {},\n      forum: {},\n      content: \"\",\n      forumList: [],\n      likeCount: 0,\n      isLiked: false,\n      parentId: '0',\n      // 父评论id\n      replyUserName: '' // 回复的用户名\n    };\n  },\n\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    handleAvatarError(e) {\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    // 点赞帖子\n    likePost() {\n      const params = {\n        id: this.id,\n        type: 1 // 1-帖子点赞\n      };\n\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          this.isLiked = !this.isLiked;\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1);\n          this.$message({\n            message: this.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    // 点赞评论\n    likeComment(item) {\n      const params = {\n        id: item.id,\n        type: 2 // 2-评论点赞\n      };\n\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          item.isLiked = !item.isLiked;\n          item.likeCount = item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1;\n          this.$set(this.forumList, this.forumList.indexOf(item), item);\n          this.$message({\n            message: item.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    // 回复某人\n    replyToUser(userName) {\n      this.content = `@${userName} `;\n      this.$message.info(`回复 ${userName}`);\n    },\n    saveApeForumItem() {\n      if (!this.content) {\n        this.$message({\n          type: 'warning',\n          message: '请输入回复内容'\n        });\n        return;\n      }\n      var param = {\n        forumId: this.id,\n        content: this.content\n      };\n      saveApeForumItem(param).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '发布成功!'\n          });\n          this.content = \"\";\n          this.getApeForumItemList();\n        }\n      });\n    },\n    getApeForumById() {\n      getApeForumById({\n        id: this.id\n      }).then(res => {\n        if (res.code == 1000) {\n          this.forum = res.data;\n          this.likeCount = res.data.likeCount || 0;\n          this.isLiked = res.data.isLiked || false;\n        }\n      });\n    },\n    getApeForumItemList() {\n      var param = {\n        forumId: this.id\n      };\n      getApeForumItemList(param).then(res => {\n        if (res.code == 1000) {\n          this.forumList = res.data || [];\n        }\n      });\n    }\n  },\n  created() {},\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.id = this.$route.query.id;\n    this.getApeForumById();\n    this.getApeForumItemList();\n  }\n};","map":{"version":3,"names":["getApeForumById","getApeForumItemList","saveApeForumItem","likeApeForum","headerPage","bottomPage","data","id","user","forum","content","forumList","likeCount","isLiked","parentId","replyUserName","components","methods","handleAvatarError","e","target","src","likePost","params","type","then","res","code","$message","message","duration","error","likeComment","item","$set","indexOf","replyToUser","userName","info","param","forumId","created","mounted","window","scrollTo","top","behavior","$route","query"],"sources":["src/views/forum/forumInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <headerPage></headerPage>\r\n\r\n    <!-- 帖子详情 -->\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"post-container\">\r\n        <!-- 帖子头部 -->\r\n        <div class=\"post-header\">\r\n          <div class=\"post-title\">{{forum.name}}</div>\r\n          <div class=\"post-meta\">\r\n            <div class=\"post-author\">\r\n              <img class=\"author-avatar\" :src=\"$store.state.HOST + forum.avatar\" @error=\"handleAvatarError\">\r\n              <span class=\"author-name\">{{forum.createBy}}</span>\r\n            </div>\r\n            <div class=\"post-time\">\r\n              <i class=\"el-icon-time\"></i> {{forum.createTime}}\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 帖子内容 -->\r\n        <div class=\"post-content\">\r\n          <div class=\"content-text\">{{forum.content}}</div>\r\n        </div>\r\n\r\n        <!-- 帖子互动按钮 -->\r\n        <div class=\"post-actions\">\r\n          <div class=\"action-item\" @click=\"likePost\">\r\n            <i class=\"el-icon-star-off\" :class=\"{ 'liked': isLiked }\"></i>\r\n            <span>{{likeCount}}</span>\r\n          </div>\r\n          <div class=\"action-item\">\r\n            <i class=\"el-icon-chat-dot-round\"></i>\r\n            <span>{{forumList.length}} 回复</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布评论区域 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-edit\"></i> 发表回复\r\n        </div>\r\n        <div class=\"comment-input\">\r\n          <el-input\r\n              type=\"textarea\"\r\n              resize=\"none\"\r\n              rows=\"4\"\r\n              v-model=\"content\"\r\n              placeholder=\"写下你的回复...\">\r\n          </el-input>\r\n          <div class=\"comment-submit\">\r\n            <el-button @click=\"saveApeForumItem\" size=\"small\" type=\"primary\" plain>发布回复</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-chat-dot-round\"></i> 全部回复 ({{forumList.length}})\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length <= 0\" class=\"empty-comment\">\r\n          <el-empty description=\"还没有回复，快来抢沙发吧！\"></el-empty>\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length > 0\" class=\"comment-list\">\r\n          <div v-for=\"(item,index) in forumList\" :key=\"index\" class=\"comment-item\">\r\n            <div class=\"comment-avatar\">\r\n              <img :src=\"$store.state.HOST + item.userAvatar\" @error=\"handleAvatarError\">\r\n            </div>\r\n            <div class=\"comment-body\">\r\n              <div class=\"comment-user\">\r\n                <span class=\"user-name\">{{item.userName}}</span>\r\n                <span class=\"user-time\">{{item.createTime}}</span>\r\n              </div>\r\n              <div class=\"comment-content\">{{item.content}}</div>\r\n              <div class=\"comment-actions\">\r\n                <span class=\"comment-like\" @click=\"likeComment(item)\">\r\n                  <i class=\"el-icon-star-off\" :class=\"{ 'liked': item.isLiked }\"></i>\r\n                  {{item.likeCount || 0}}\r\n                </span>\r\n                <span class=\"comment-reply\" @click=\"replyToUser(item.userName)\">回复</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      id: \"\",\r\n      user: {},\r\n      forum: {},\r\n      content: \"\",\r\n      forumList: [],\r\n      likeCount: 0,\r\n      isLiked: false,\r\n      parentId: '0',      // 父评论id\r\n      replyUserName: ''   // 回复的用户名\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    handleAvatarError(e) {\r\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n\r\n    // 点赞帖子\r\n    likePost() {\r\n      const params = {\r\n        id: this.id,\r\n        type: 1  // 1-帖子点赞\r\n      }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          this.isLiked = !this.isLiked\r\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1)\r\n          this.$message({\r\n            message: this.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    // 点赞评论\r\n    likeComment(item) {\r\n      const params = {\r\n        id: item.id,\r\n        type: 2  // 2-评论点赞\r\n      }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          item.isLiked = !item.isLiked\r\n          item.likeCount = item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1\r\n          this.$set(this.forumList, this.forumList.indexOf(item), item)\r\n          this.$message({\r\n            message: item.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    // 回复某人\r\n    replyToUser(userName) {\r\n      this.content = `@${userName} `\r\n      this.$message.info(`回复 ${userName}`)\r\n    },\r\n\r\n    saveApeForumItem() {\r\n      if (!this.content) {\r\n        this.$message({\r\n          type: 'warning',\r\n          message: '请输入回复内容'\r\n        });\r\n        return\r\n      }\r\n      var param = {\r\n        forumId: this.id,\r\n        content: this.content\r\n      }\r\n      saveApeForumItem(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.$message({\r\n            type: 'success',\r\n            message: '发布成功!'\r\n          });\r\n          this.content = \"\"\r\n          this.getApeForumItemList()\r\n        }\r\n      })\r\n    },\r\n\r\n    getApeForumById() {\r\n      getApeForumById({id: this.id}).then(res => {\r\n        if (res.code == 1000) {\r\n          this.forum = res.data\r\n          this.likeCount = res.data.likeCount || 0\r\n          this.isLiked = res.data.isLiked || false\r\n        }\r\n      })\r\n    },\r\n\r\n    getApeForumItemList() {\r\n      var param = {\r\n        forumId: this.id\r\n      }\r\n      getApeForumItemList(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.forumList = res.data || []\r\n        }\r\n      })\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    window.scrollTo({\r\n      top: 0,\r\n      behavior: 'smooth'\r\n    });\r\n    this.id = this.$route.query.id\r\n    this.getApeForumById()\r\n    this.getApeForumItemList()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/articleInfo.css\");\r\n\r\n/* 帖子容器样式 */\r\n.post-container {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  margin: 30px auto;\r\n  width: 70%;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n/* 帖子头部 */\r\n.post-header {\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.post-title {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  line-height: 1.4;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.post-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.post-author {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.author-avatar {\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.author-name {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #20B486;\r\n}\r\n\r\n.post-time {\r\n  font-size: 13px;\r\n  color: #999;\r\n}\r\n\r\n.post-time i {\r\n  margin-right: 4px;\r\n}\r\n\r\n/* 帖子内容 */\r\n.post-content {\r\n  margin-bottom: 24px;\r\n  min-height: 150px;\r\n}\r\n\r\n.content-text {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #555;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n/* 互动按钮 */\r\n.post-actions {\r\n  display: flex;\r\n  gap: 30px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid #f0f0f0;\r\n}\r\n\r\n.action-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  color: #666;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.action-item:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.action-item i {\r\n  font-size: 18px;\r\n}\r\n\r\n.action-item i.liked {\r\n  color: #ffc107;\r\n}\r\n\r\n/* 评论区域 */\r\n.comment-section {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 24px;\r\n  margin-bottom: 30px;\r\n  width: 70%;\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);\r\n}\r\n\r\n.comment-title {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  padding-bottom: 12px;\r\n  border-bottom: 2px solid #f0f0f0;\r\n}\r\n\r\n.comment-title i {\r\n  margin-right: 8px;\r\n  color: #20B486;\r\n}\r\n\r\n.comment-input {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.comment-submit {\r\n  margin-top: 12px;\r\n  text-align: right;\r\n}\r\n\r\n/* 评论列表 */\r\n.comment-list {\r\n  max-height: 600px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.comment-item {\r\n  display: flex;\r\n  gap: 15px;\r\n  padding: 20px 0;\r\n  border-bottom: 1px solid #f5f5f5;\r\n}\r\n\r\n.comment-item:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.comment-avatar img {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.comment-body {\r\n  flex: 1;\r\n}\r\n\r\n.comment-user {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 12px;\r\n  margin-bottom: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.user-name {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #20B486;\r\n}\r\n\r\n.user-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.comment-content {\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  color: #555;\r\n  margin-bottom: 10px;\r\n  background: #f8f9fa;\r\n  padding: 12px;\r\n  border-radius: 12px;\r\n}\r\n\r\n.comment-actions {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n\r\n.comment-like,\r\n.comment-reply {\r\n  font-size: 12px;\r\n  color: #999;\r\n  cursor: pointer;\r\n  transition: color 0.3s;\r\n}\r\n\r\n.comment-like:hover,\r\n.comment-reply:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.comment-like i.liked {\r\n  color: #ffc107;\r\n}\r\n\r\n.empty-comment {\r\n  padding: 40px 0;\r\n}\r\n\r\n::v-deep img {\r\n  max-width: 100% !important;\r\n}\r\n</style>"],"mappings":"AAqGA,SAAAA,eAAA,EAAAC,mBAAA,EAAAC,gBAAA,EAAAC,YAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,EAAA;MACAC,IAAA;MACAC,KAAA;MACAC,OAAA;MACAC,SAAA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MAAA;MACAC,aAAA;IACA;EACA;;EACAC,UAAA;IACAZ,UAAA;IACAC;EACA;EACAY,OAAA;IACAC,kBAAAC,CAAA;MACAA,CAAA,CAAAC,MAAA,CAAAC,GAAA;IACA;IAEA;IACAC,SAAA;MACA,MAAAC,MAAA;QACAhB,EAAA,OAAAA,EAAA;QACAiB,IAAA;MACA;;MACArB,YAAA,CAAAoB,MAAA,EAAAE,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAd,OAAA,SAAAA,OAAA;UACA,KAAAD,SAAA,GAAAc,GAAA,CAAApB,IAAA,UAAAO,OAAA,QAAAD,SAAA,YAAAA,SAAA;UACA,KAAAgB,QAAA;YACAC,OAAA,OAAAhB,OAAA;YACAW,IAAA;YACAM,QAAA;UACA;QACA;UACA,KAAAF,QAAA,CAAAG,KAAA,CAAAL,GAAA,CAAAG,OAAA;QACA;MACA;IACA;IAEA;IACAG,YAAAC,IAAA;MACA,MAAAV,MAAA;QACAhB,EAAA,EAAA0B,IAAA,CAAA1B,EAAA;