{"ast":null,"code":"export default {\n  name: 'CommentItem',\n  props: {\n    comment: {\n      type: Object,\n      required: true\n    },\n    level: {\n      type: Number,\n      default: 0\n    }\n  },\n  computed: {\n    marginLeft() {\n      return this.level * 44;\n    },\n    showLine() {\n      return this.level > 0;\n    },\n    avatarUrl() {\n      if (this.comment.avatar) {\n        return this.$store.state.HOST + this.comment.avatar;\n      }\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    }\n  },\n  methods: {\n    handleAvatarError(e) {\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    }\n  }\n};","map":{"version":3,"names":["name","props","comment","type","Object","required","level","Number","default","computed","marginLeft","showLine","avatarUrl","avatar","$store","state","HOST","methods","handleAvatarError","e","target","src"],"sources":["src/components/CommentItem.vue"],"sourcesContent":["<template>\r\n  <div class=\"comment-wrapper\" :style=\"{ marginLeft: marginLeft + 'px' }\">\r\n    <div class=\"comment-item\" :class=\"{ 'has-child': showLine }\">\r\n      <div class=\"comment-line\" v-if=\"showLine\"></div>\r\n      <div class=\"comment-avatar\">\r\n        <img :src=\"avatarUrl\" @error=\"handleAvatarError\">\r\n      </div>\r\n      <div class=\"comment-content-wrapper\">\r\n        <div class=\"comment-header\">\r\n          <span class=\"comment-author\">{{ comment.createBy }}</span>\r\n          <span class=\"comment-time\">{{ comment.createTime }}</span>\r\n        </div>\r\n        <div class=\"comment-text\">{{ comment.content }}</div>\r\n        <div class=\"comment-footer\">\r\n          <span class=\"comment-like\" @click=\"$emit('like', comment)\">\r\n            <i class=\"el-icon-thumb\" :class=\"{ 'liked': comment.isLiked }\"></i>\r\n            {{ comment.likeCount || 0 }}\r\n          </span>\r\n          <span class=\"comment-reply\" @click=\"$emit('reply', comment)\">\r\n            <i class=\"el-icon-chat-line-round\"></i> 回复\r\n          </span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div v-if=\"comment.replies && comment.replies.length > 0\" class=\"comment-children\">\r\n      <CommentItem\r\n          v-for=\"child in comment.replies\"\r\n          :key=\"child.id\"\r\n          :comment=\"child\"\r\n          :level=\"level + 1\"\r\n          @reply=\"$emit('reply', $event)\"\r\n          @like=\"$emit('like', $event)\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CommentItem',\r\n  props: {\r\n    comment: {\r\n      type: Object,\r\n      required: true\r\n    },\r\n    level: {\r\n      type: Number,\r\n      default: 0\r\n    }\r\n  },\r\n  computed: {\r\n    marginLeft() {\r\n      return this.level * 44\r\n    },\r\n    showLine() {\r\n      return this.level > 0\r\n    },\r\n    avatarUrl() {\r\n      if (this.comment.avatar) {\r\n        return this.$store.state.HOST + this.comment.avatar\r\n      }\r\n      return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    }\r\n  },\r\n  methods: {\r\n    handleAvatarError(e) {\r\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.comment-wrapper {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.comment-item {\r\n  display: flex;\r\n  gap: 15px;\r\n  padding: 16px 0;\r\n  position: relative;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.comment-line {\r\n  position: absolute;\r\n  left: -20px;\r\n  top: 0;\r\n  bottom: 0;\r\n  width: 2px;\r\n  background-color: #20B486;\r\n  opacity: 0.3;\r\n}\r\n\r\n.comment-avatar img {\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.comment-content-wrapper {\r\n  flex: 1;\r\n}\r\n\r\n.comment-header {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 12px;\r\n  margin-bottom: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.comment-author {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #20B486;\r\n}\r\n\r\n.comment-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.comment-text {\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  color: #444;\r\n  margin-bottom: 10px;\r\n  word-break: break-word;\r\n  background: #f8f9fa;\r\n  padding: 12px 15px;\r\n  border-radius: 12px;\r\n}\r\n\r\n.comment-footer {\r\n  display: flex;\r\n  gap: 20px;\r\n  margin-top: 5px;\r\n}\r\n\r\n.comment-like,\r\n.comment-reply {\r\n  font-size: 12px;\r\n  color: #999;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  transition: color 0.3s;\r\n}\r\n\r\n.comment-like:hover,\r\n.comment-reply:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.comment-like i.liked {\r\n  color: #ff4d4f;\r\n}\r\n\r\n.comment-children {\r\n  margin-top: 0;\r\n}\r\n</style>"],"mappings":"AAqCA;EACAA,IAAA;EACAC,KAAA;IACAC,OAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,QAAA;IACA;IACAC,KAAA;MACAH,IAAA,EAAAI,MAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,YAAAJ,KAAA;IACA;IACAK,SAAA;MACA,YAAAL,KAAA;IACA;IACAM,UAAA;MACA,SAAAV,OAAA,CAAAW,MAAA;QACA,YAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,QAAAd,OAAA,CAAAW,MAAA;MACA;MACA;IACA;EACA;EACAI,OAAA;IACAC,kBAAAC,CAAA;MACAA,CAAA,CAAAC,MAAA,CAAAC,GAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}