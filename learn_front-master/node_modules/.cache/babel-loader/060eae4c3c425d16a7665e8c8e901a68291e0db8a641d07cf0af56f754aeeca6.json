{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  components: {\n    headerPage,\n    bottomPage\n  },\n  data() {\n    return {\n      id: \"\",\n      user: {},\n      forum: {},\n      content: \"\",\n      forumList: [],\n      likeCount: 0,\n      isLiked: false,\n      parentId: '0',\n      replyUserName: ''\n    };\n  },\n  computed: {\n    totalComments() {\n      let count = 0;\n      this.forumList.forEach(item => {\n        count += 1;\n        if (item.replies && item.replies.length > 0) {\n          count += item.replies.length;\n        }\n      });\n      return count;\n    }\n  },\n  methods: {\n    formatTime(timeStr) {\n      if (!timeStr) return '';\n      if (timeStr.length > 16) {\n        return timeStr.substring(0, 16);\n      }\n      return timeStr;\n    },\n    handleAvatarError(e) {\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png';\n    },\n    likePost() {\n      const params = {\n        targetId: this.id,\n        type: 1\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          this.isLiked = !this.isLiked;\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1);\n          this.$message({\n            message: this.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    likeComment(item) {\n      const params = {\n        targetId: item.id,\n        type: 2\n      };\n      likeApeForum(params).then(res => {\n        if (res.code == 1000) {\n          item.isLiked = !item.isLiked;\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1);\n          this.$forceUpdate();\n          this.$message({\n            message: item.isLiked ? '点赞成功' : '取消点赞',\n            type: 'success',\n            duration: 1000\n          });\n        } else {\n          this.$message.error(res.message);\n        }\n      });\n    },\n    replyToUser(item) {\n      this.replyUserName = item.userName || item.createBy;\n      this.parentId = item.id;\n      this.content = '';\n      this.$nextTick(() => {\n        if (this.$refs.commentInput) {\n          this.$refs.commentInput.focus();\n        }\n      });\n      this.$message.info(`正在回复 ${this.replyUserName}`);\n    },\n    cancelReply() {\n      this.parentId = '0';\n      this.replyUserName = '';\n      this.content = '';\n    },\n    saveApeForumItem() {\n      if (!this.content.trim()) {\n        this.$message({\n          type: 'warning',\n          message: '请输入回复内容'\n        });\n        return;\n      }\n      var param = {\n        forumId: this.id,\n        content: this.content,\n        parentId: this.parentId || '0'\n      };\n      console.log('提交参数:', param);\n      saveApeForumItem(param).then(res => {\n        if (res.code == 1000) {\n          this.$message({\n            type: 'success',\n            message: '发布成功!'\n          });\n          this.content = \"\";\n          this.cancelReply();\n          this.getApeForumItemList();\n        } else {\n          this.$message.error(res.message);\n        }\n      }).catch(() => {\n        this.$message.error('发布失败，请稍后重试');\n      });\n    },\n    getApeForumById() {\n      getApeForumById({\n        id: this.id\n      }).then(res => {\n        if (res.code == 1000) {\n          this.forum = res.data;\n          this.likeCount = res.data.likeCount || 0;\n          this.isLiked = res.data.isLiked || false;\n        }\n      });\n    },\n    getApeForumItemList() {\n      var param = {\n        forumId: this.id\n      };\n      getApeForumItemList(param).then(res => {\n        if (res.code == 1000) {\n          console.log('原始数据:', res.data);\n          // 将评论分为一级评论和回复\n          this.forumList = this.buildTwoLayerComments(res.data || []);\n          console.log('处理后数据:', this.forumList);\n        }\n      });\n    },\n    // 构建两层结构：将 parentId != 0 的评论作为回复，挂载到对应的父评论下\n    buildTwoLayerComments(comments) {\n      if (!comments || comments.length === 0) return [];\n      const topComments = [];\n      const repliesMap = new Map();\n\n      // 先找出所有一级评论（parentId == 0）\n      comments.forEach(comment => {\n        if (comment.parentId === '0' || comment.parentId === 0 || !comment.parentId) {\n          comment.replies = [];\n          topComments.push(comment);\n        } else {\n          // 回复暂存\n          if (!repliesMap.has(comment.parentId)) {\n            repliesMap.set(comment.parentId, []);\n          }\n          repliesMap.get(comment.parentId).push(comment);\n        }\n      });\n\n      // 将回复挂载到对应的父评论下\n      topComments.forEach(topComment => {\n        const replies = repliesMap.get(topComment.id);\n        if (replies && replies.length > 0) {\n          topComment.replies = replies;\n        }\n      });\n\n      // 一级评论按时间倒序排序\n      topComments.sort((a, b) => new Date(b.createTime) - new Date(a.createTime));\n\n      // 回复按时间正序排序\n      topComments.forEach(comment => {\n        if (comment.replies && comment.replies.length > 0) {\n          comment.replies.sort((a, b) => new Date(a.createTime) - new Date(b.createTime));\n        }\n      });\n      return topComments;\n    }\n  },\n  mounted() {\n    window.scrollTo({\n      top: 0,\n      behavior: 'smooth'\n    });\n    this.id = this.$route.query.id;\n    this.getApeForumById();\n    this.getApeForumItemList();\n  }\n};","map":{"version":3,"names":["getApeForumById","getApeForumItemList","saveApeForumItem","likeApeForum","headerPage","bottomPage","components","data","id","user","forum","content","forumList","likeCount","isLiked","parentId","replyUserName","computed","totalComments","count","forEach","item","replies","length","methods","formatTime","timeStr","substring","handleAvatarError","e","target","src","likePost","params","targetId","type","then","res","code","$message","message","duration","error","likeComment","$forceUpdate","replyToUser","userName","createBy","$nextTick","$refs","commentInput","focus","info","cancelReply","trim","param","forumId","console","log","catch","buildTwoLayerComments","comments","topComments","repliesMap","Map","comment","push","has","set","get","topComment","sort","a","b","Date","createTime","mounted","window","scrollTo","top","behavior","$route","query"],"sources":["src/views/forum/forumInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"articleInfo\">\r\n    <headerPage></headerPage>\r\n\r\n    <!-- 帖子详情 -->\r\n    <div class=\"articleInfo-content\">\r\n      <div class=\"post-container\">\r\n        <div class=\"post-header\">\r\n          <div class=\"post-author\">\r\n            <img class=\"author-avatar\" :src=\"$store.state.HOST + forum.avatar\" @error=\"handleAvatarError\">\r\n            <div class=\"author-info\">\r\n              <span class=\"author-name\">{{forum.createBy}}</span>\r\n              <span class=\"post-time\">\r\n                <i class=\"el-icon-time\"></i> {{formatTime(forum.createTime)}}\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div class=\"post-title\">{{forum.name}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-content\">\r\n          <div class=\"content-text\">{{forum.content}}</div>\r\n        </div>\r\n\r\n        <div class=\"post-actions\">\r\n          <div class=\"action-item\" @click=\"likePost\">\r\n            <i class=\"el-icon-thumb\" :class=\"{ 'liked': isLiked }\"></i>\r\n            <span>{{likeCount}}</span>\r\n          </div>\r\n          <div class=\"action-item\">\r\n            <i class=\"el-icon-chat-dot-round\"></i>\r\n            <span>{{totalComments}} 回复</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布评论区域 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-edit\"></i> 发表回复\r\n        </div>\r\n        <div class=\"comment-input\">\r\n          <div v-if=\"replyUserName\" class=\"reply-tip\">\r\n            正在回复 @{{replyUserName}}\r\n            <span @click=\"cancelReply\" class=\"cancel-reply\">取消</span>\r\n          </div>\r\n          <el-input\r\n              type=\"textarea\"\r\n              resize=\"none\"\r\n              rows=\"4\"\r\n              v-model=\"content\"\r\n              placeholder=\"写下你的回复...\"\r\n              ref=\"commentInput\">\r\n          </el-input>\r\n          <div class=\"comment-submit\">\r\n            <el-button @click=\"saveApeForumItem\" size=\"small\" type=\"primary\" plain>发布回复</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表 -->\r\n    <div class=\"articleInfo-bottom\">\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-title\">\r\n          <i class=\"el-icon-chat-dot-round\"></i> 全部回复 ({{totalComments}})\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length <= 0\" class=\"empty-comment\">\r\n          <el-empty description=\"还没有回复，快来抢沙发吧！\"></el-empty>\r\n        </div>\r\n\r\n        <div v-if=\"forumList.length > 0\" class=\"comment-list\">\r\n          <div v-for=\"item in forumList\" :key=\"item.id\" class=\"comment-tree\">\r\n            <!-- 第一层：一级评论（parentId == 0） -->\r\n            <div class=\"comment-item\">\r\n              <div class=\"comment-avatar\">\r\n                <img :src=\"$store.state.HOST + item.userAvatar\" @error=\"handleAvatarError\">\r\n              </div>\r\n              <div class=\"comment-main\">\r\n                <div class=\"comment-header\">\r\n                  <span class=\"comment-author\">{{ item.userName || item.createBy }}</span>\r\n                  <span class=\"comment-time\">{{ formatTime(item.createTime) }}</span>\r\n                </div>\r\n                <div class=\"comment-text\">{{ item.content }}</div>\r\n                <div class=\"comment-footer\">\r\n                  <span class=\"comment-like\" @click=\"likeComment(item)\">\r\n                    <i class=\"el-icon-thumb\" :class=\"{ 'liked': item.isLiked }\"></i>\r\n                    {{ item.likeCount || 0 }}\r\n                  </span>\r\n                  <span class=\"comment-reply\" @click=\"replyToUser(item)\">回复</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 第二层：回复（parentId == 当前评论ID） -->\r\n            <div v-if=\"item.replies && item.replies.length > 0\" class=\"replies-container\">\r\n              <div v-for=\"reply in item.replies\" :key=\"reply.id\" class=\"reply-item\">\r\n                <div class=\"reply-line\"></div>\r\n                <div class=\"reply-avatar\">\r\n                  <img :src=\"$store.state.HOST + reply.userAvatar\" @error=\"handleAvatarError\">\r\n                </div>\r\n                <div class=\"reply-main\">\r\n                  <div class=\"reply-header\">\r\n                    <span class=\"reply-author\">{{ reply.userName || reply.createBy }}</span>\r\n                    <span class=\"reply-time\">{{ formatTime(reply.createTime) }}</span>\r\n                  </div>\r\n                  <div class=\"reply-text\">\r\n                    <span class=\"reply-to\">@{{ reply.replyUserName || item.userName }} </span>\r\n                    {{ reply.content }}\r\n                  </div>\r\n                  <div class=\"reply-footer\">\r\n                    <span class=\"reply-like\" @click=\"likeComment(reply)\">\r\n                      <i class=\"el-icon-thumb\" :class=\"{ 'liked': reply.isLiked }\"></i>\r\n                      {{ reply.likeCount || 0 }}\r\n                    </span>\r\n                    <span class=\"reply-reply\" @click=\"replyToUser(reply)\">回复</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeForumById, getApeForumItemList, saveApeForumItem, likeApeForum} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\n\r\nexport default {\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  data() {\r\n    return{\r\n      id: \"\",\r\n      user: {},\r\n      forum: {},\r\n      content: \"\",\r\n      forumList: [],\r\n      likeCount: 0,\r\n      isLiked: false,\r\n      parentId: '0',\r\n      replyUserName: ''\r\n    }\r\n  },\r\n  computed: {\r\n    totalComments() {\r\n      let count = 0\r\n      this.forumList.forEach(item => {\r\n        count += 1\r\n        if (item.replies && item.replies.length > 0) {\r\n          count += item.replies.length\r\n        }\r\n      })\r\n      return count\r\n    }\r\n  },\r\n  methods: {\r\n    formatTime(timeStr) {\r\n      if (!timeStr) return ''\r\n      if (timeStr.length > 16) {\r\n        return timeStr.substring(0, 16)\r\n      }\r\n      return timeStr\r\n    },\r\n    handleAvatarError(e) {\r\n      e.target.src = 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n    },\r\n\r\n    likePost() {\r\n      const params = { targetId: this.id, type: 1 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          this.isLiked = !this.isLiked\r\n          this.likeCount = res.data || (this.isLiked ? this.likeCount + 1 : this.likeCount - 1)\r\n          this.$message({\r\n            message: this.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    likeComment(item) {\r\n      const params = { targetId: item.id, type: 2 }\r\n      likeApeForum(params).then(res => {\r\n        if (res.code == 1000) {\r\n          item.isLiked = !item.isLiked\r\n          item.likeCount = res.data || (item.isLiked ? (item.likeCount || 0) + 1 : (item.likeCount || 0) - 1)\r\n          this.$forceUpdate()\r\n          this.$message({\r\n            message: item.isLiked ? '点赞成功' : '取消点赞',\r\n            type: 'success',\r\n            duration: 1000\r\n          })\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      })\r\n    },\r\n\r\n    replyToUser(item) {\r\n      this.replyUserName = item.userName || item.createBy\r\n      this.parentId = item.id\r\n      this.content = ''\r\n      this.$nextTick(() => {\r\n        if (this.$refs.commentInput) {\r\n          this.$refs.commentInput.focus()\r\n        }\r\n      })\r\n      this.$message.info(`正在回复 ${this.replyUserName}`)\r\n    },\r\n\r\n    cancelReply() {\r\n      this.parentId = '0'\r\n      this.replyUserName = ''\r\n      this.content = ''\r\n    },\r\n\r\n    saveApeForumItem() {\r\n      if (!this.content.trim()) {\r\n        this.$message({ type: 'warning', message: '请输入回复内容' })\r\n        return\r\n      }\r\n      var param = {\r\n        forumId: this.id,\r\n        content: this.content,\r\n        parentId: this.parentId || '0'\r\n      }\r\n      console.log('提交参数:', param)\r\n      saveApeForumItem(param).then(res => {\r\n        if (res.code == 1000) {\r\n          this.$message({ type: 'success', message: '发布成功!' })\r\n          this.content = \"\"\r\n          this.cancelReply()\r\n          this.getApeForumItemList()\r\n        } else {\r\n          this.$message.error(res.message)\r\n        }\r\n      }).catch(() => {\r\n        this.$message.error('发布失败，请稍后重试')\r\n      })\r\n    },\r\n\r\n    getApeForumById() {\r\n      getApeForumById({id: this.id}).then(res => {\r\n        if (res.code == 1000) {\r\n          this.forum = res.data\r\n          this.likeCount = res.data.likeCount || 0\r\n          this.isLiked = res.data.isLiked || false\r\n        }\r\n      })\r\n    },\r\n\r\n    getApeForumItemList() {\r\n      var param = { forumId: this.id }\r\n      getApeForumItemList(param).then(res => {\r\n        if (res.code == 1000) {\r\n          console.log('原始数据:', res.data)\r\n          // 将评论分为一级评论和回复\r\n          this.forumList = this.buildTwoLayerComments(res.data || [])\r\n          console.log('处理后数据:', this.forumList)\r\n        }\r\n      })\r\n    },\r\n\r\n    // 构建两层结构：将 parentId != 0 的评论作为回复，挂载到对应的父评论下\r\n    buildTwoLayerComments(comments) {\r\n      if (!comments || comments.length === 0) return []\r\n\r\n      const topComments = []\r\n      const repliesMap = new Map()\r\n\r\n      // 先找出所有一级评论（parentId == 0）\r\n      comments.forEach(comment => {\r\n        if (comment.parentId === '0' || comment.parentId === 0 || !comment.parentId) {\r\n          comment.replies = []\r\n          topComments.push(comment)\r\n        } else {\r\n          // 回复暂存\r\n          if (!repliesMap.has(comment.parentId)) {\r\n            repliesMap.set(comment.parentId, [])\r\n          }\r\n          repliesMap.get(comment.parentId).push(comment)\r\n        }\r\n      })\r\n\r\n      // 将回复挂载到对应的父评论下\r\n      topComments.forEach(topComment => {\r\n        const replies = repliesMap.get(topComment.id)\r\n        if (replies && replies.length > 0) {\r\n          topComment.replies = replies\r\n        }\r\n      })\r\n\r\n      // 一级评论按时间倒序排序\r\n      topComments.sort((a, b) => new Date(b.createTime) - new Date(a.createTime))\r\n\r\n      // 回复按时间正序排序\r\n      topComments.forEach(comment => {\r\n        if (comment.replies && comment.replies.length > 0) {\r\n          comment.replies.sort((a, b) => new Date(a.createTime) - new Date(b.createTime))\r\n        }\r\n      })\r\n\r\n      return topComments\r\n    }\r\n  },\r\n  mounted() {\r\n    window.scrollTo({ top: 0, behavior: 'smooth' })\r\n    this.id = this.$route.query.id\r\n    this.getApeForumById()\r\n    this.getApeForumItemList()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/article/articleInfo.css\");\r\n\r\n/* 帖子容器样式 */\r\n.post-container {\r\n  background: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  margin: 30px auto;\r\n  width: 70%;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.post-header {\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.post-author {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.author-avatar {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.author-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.author-name {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #20B486;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.post-time i {\r\n  margin-right: 4px;\r\n}\r\n\r\n.post-title {\r\n  font-size: 22px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  line-height: 1.4;\r\n}\r\n\r\n.post-content {\r\n  margin-bottom: 24px;\r\n  min-height: 150px;\r\n}\r\n\r\n.content-text {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #555;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.post-actions {\r\n  display: flex;\r\n  gap: 30px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid #f0f0f0;\r\n}\r\n\r\n.action-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  color: #666;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.action-item:hover {\r\n  color: #20B486;\r\n}\r\n\r\n.action-item i {\r\n  font-size: 18px;\r\n}\r\n\r\n.action-item i.liked {\r\n  color: #ff4d4f;\r\n}\r\n\r\n/* 评论区域 */\r\n.comment-sec