{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { getApeMajorList, getIndexAchievement, getHotCourses } from '../../api/api';\nimport headerPage from \"../../components/header/header\";\nimport bottomPage from \"../../components/bottom/bottom\";\nexport default {\n  data() {\n    return {\n      searchKey: \"\",\n      major: [],\n      data: {\n        count: 0,\n        count1: 0,\n        count2: 0,\n        total: 0\n      },\n      hotCourses: [] // 热门课程列表\n    };\n  },\n\n  components: {\n    headerPage,\n    bottomPage\n  },\n  methods: {\n    searchTask() {\n      if (this.searchKey) {\n        this.$router.push(\"/task?name=\" + this.searchKey);\n      }\n    },\n    majorTask(major) {\n      this.$router.push(\"/task?major=\" + major);\n    },\n    toTask() {\n      this.$router.push(\"/task\");\n    },\n    toMessage() {\n      this.$router.push(\"/message\");\n    },\n    toCourseDetail(courseId) {\n      this.$router.push(\"/taskInfo?id=\" + courseId);\n    },\n    getApeMajorList() {\n      getApeMajorList().then(res => {\n        if (res.code == 1000) {\n          var major = res.data;\n          this.major = major.splice(0, 16);\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    getIndexAchievement() {\n      getIndexAchievement().then(res => {\n        if (res.code == 1000) {\n          this.data = res.data;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    },\n    // 获取热门课程推荐\n    getHotCourses() {\n      getHotCourses().then(res => {\n        if (res.code == 1000) {\n          this.hotCourses = res.data;\n        } else {\n          this.$notify.error({\n            title: '错误',\n            message: res.message\n          });\n        }\n      });\n    }\n  },\n  created() {},\n  mounted() {\n    this.getApeMajorList();\n    this.getIndexAchievement();\n    this.getHotCourses(); // 调用热门课程接口\n  }\n};","map":{"version":3,"names":["getApeMajorList","getIndexAchievement","getHotCourses","headerPage","bottomPage","data","searchKey","major","count","count1","count2","total","hotCourses","components","methods","searchTask","$router","push","majorTask","toTask","toMessage","toCourseDetail","courseId","then","res","code","splice","$notify","error","title","message","created","mounted"],"sources":["src/views/index/index.vue"],"sourcesContent":["<template>\r\n  <div class=\"index\">\r\n    <headerPage></headerPage>\r\n    <div class=\"index-search\">\r\n      <div class=\"index-search-content\">\r\n        <div class=\"search-content\">\r\n          <div class=\"content1\">开启精彩学习之旅</div>\r\n          <div class=\"content2\">Start an exciting learning journey</div>\r\n          <div class=\"content3\">本平台提供海量<span style=\"color:#20B486\">中小学信息技术课程和各种编程语言</span>的教学资源！不管你是想提升学校里的信息技术能力，还是探索编程的奇妙世界，这里都能满足你哟！</div>\r\n          <div class=\"content5\">快来一起学习吧！</div>\r\n          <div class=\"content6\">Come and let's study together！</div>\r\n          <el-input class=\"searchKey\" v-model=\"searchKey\" suffix-icon=\"el-icon-search\" placeholder=\"请输入想要搜索的课程名称并按回车键搜索\" @change=\"searchTask()\"></el-input>\r\n        </div>\r\n      </div>\r\n      <div class=\"index-image\">\r\n        <img class=\"index-search-image\" src=\"../../assets/image/index/index-image.png\"></img>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 课程推荐 - 移到平台数据前面 -->\r\n    <div class=\"most-course\">\r\n      <div class=\"most-content\">\r\n        <div class=\"page-title\">\r\n          <div style=\"letter-spacing: 2px;\">热门课程推荐</div>\r\n          <div style=\"margin-top:10px;color:#92969B\">Hot <span style=\"color:#20B486\"> Courses</span></div>\r\n        </div>\r\n        <div class=\"course-list\">\r\n          <div v-for=\"(item,index) in hotCourses\" :key=\"index\" class=\"course-item\" @click=\"toCourseDetail(item.id)\">\r\n            <div class=\"course-image\">\r\n              <img :src=\"$store.state.HOST + item.image\" style=\"width:100%;height:100%;object-fit:cover\">\r\n            </div>\r\n            <div class=\"course-info\">\r\n              <div class=\"course-title\">{{item.name}}</div>\r\n              <div class=\"course-desc\">{{item.task_describer}}</div>\r\n              <div class=\"course-stats\">\r\n                <span class=\"stat-item\">\r\n                    <i class=\"el-icon-star-on\"></i> {{item.collectCount || 0}} 收藏\r\n                </span>\r\n                <span class=\"stat-item\">\r\n                    <i class=\"el-icon-user\"></i> {{item.num || 0}} 学生\r\n                </span>\r\n                <span class=\"stat-item\">\r\n                    <i class=\"el-icon-chat-dot-round\"></i> {{item.commentCount || 0}} 评论\r\n                </span>\r\n                <span class=\"stat-item hot-score\" v-if=\"item.hotScore\">\r\n                    <i class=\"el-icon-hot-water\"></i> 热度 {{item.hotScore}}\r\n                </span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"task-btns\">\r\n          <el-button @click=\"toTask\" size=\"mini\" type=\"success\" icon=\"el-icon-arrow-right\">更多课程</el-button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"shuju\">\r\n      <div class=\"most-content\">\r\n        <div class=\"page-title\">\r\n          <div style=\"letter-spacing: 2px;\">平台数据</div>\r\n          <div style=\"margin-top:10px;color:#92969B\">Our <span style=\"color:#20B486\"> Achievement</span></div>\r\n        </div>\r\n        <div class=\"shuju-total\">\r\n          <div class=\"shuju-content\">\r\n            <div class=\"shuju-item\">\r\n              <img src=\"../../assets/image/index/Frame 67 (7).png\">\r\n              <div class=\"shuju-name\">\r\n                <div>{{data.count1}}+</div>\r\n                <div>教师 Teacher</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"shuju-item\">\r\n              <img src=\"../../assets/image/index/Frame 67 (4).png\">\r\n              <div class=\"shuju-name\">\r\n                <div>{{data.count}}+</div>\r\n                <div>教程 Video</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"shuju-item\">\r\n              <img src=\"../../assets/image/index/Frame 67 (6).png\">\r\n              <div class=\"shuju-name\">\r\n                <div>{{data.count2}}+</div>\r\n                <div>学生 Student</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"shuju-item\">\r\n              <img src=\"../../assets/image/index/Frame 67 (5).png\">\r\n              <div class=\"shuju-name\">\r\n                <div>{{data.total}}+</div>\r\n                <div>用户 Users</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"shuju-image\">\r\n            <img style=\"width:50%;height:120%\" src=\"../../assets/image/index/Group 10.png\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"liuyan\">\r\n      <div class=\"most-content\">\r\n        <div class=\"liuyan-font\">\r\n          <div class=\"liuyan-image\">\r\n            <img style=\"width:80%\" src=\"../../assets/image/index/Group 12.png\">\r\n          </div>\r\n          <div class=\"liuyan-content\">\r\n            <div>\r\n              <div>你的任何疑问都可以留言咨询</div>\r\n              <div style=\"margin-top:20px\">You can leave a message for consultation if you have any questions</div>\r\n              <el-button @click=\"toMessage\" style=\"margin-top:20px\" size=\"mini\" icon=\"el-icon-question\" type=\"success\">留言咨询</el-button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <bottomPage></bottomPage>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport {getApeMajorList,getIndexAchievement,getHotCourses} from '../../api/api'\r\nimport headerPage from \"../../components/header/header\"\r\nimport bottomPage from \"../../components/bottom/bottom\"\r\nexport default {\r\n  data() {\r\n    return{\r\n      searchKey: \"\",\r\n      major: [],\r\n      data: {\r\n        count: 0,\r\n        count1: 0,\r\n        count2: 0,\r\n        total: 0\r\n      },\r\n      hotCourses: [],  // 热门课程列表\r\n    }\r\n  },\r\n  components: {\r\n    headerPage,\r\n    bottomPage\r\n  },\r\n  methods: {\r\n    searchTask() {\r\n      if (this.searchKey) {\r\n        this.$router.push(\"/task?name=\" + this.searchKey)\r\n      }\r\n    },\r\n    majorTask(major) {\r\n      this.$router.push(\"/task?major=\" + major)\r\n    },\r\n    toTask() {\r\n      this.$router.push(\"/task\")\r\n    },\r\n    toMessage() {\r\n      this.$router.push(\"/message\")\r\n    },\r\n    toCourseDetail(courseId) {\r\n      this.$router.push(\"/taskInfo?id=\" + courseId)\r\n    },\r\n    getApeMajorList() {\r\n      getApeMajorList().then(res => {\r\n        if(res.code == 1000) {\r\n          var major = res.data\r\n          this.major = major.splice(0,16)\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    getIndexAchievement() {\r\n      getIndexAchievement().then(res => {\r\n        if(res.code == 1000) {\r\n          this.data = res.data\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    },\r\n    // 获取热门课程推荐\r\n    getHotCourses() {\r\n      getHotCourses().then(res => {\r\n        if(res.code == 1000) {\r\n          this.hotCourses = res.data\r\n        } else {\r\n          this.$notify.error({\r\n            title: '错误',\r\n            message: res.message\r\n          });\r\n        }\r\n      })\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  mounted() {\r\n    this.getApeMajorList()\r\n    this.getIndexAchievement()\r\n    this.getHotCourses()  // 调用热门课程接口\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"../../assets/css/index/index.css\");\r\n\r\n/* 课程推荐样式 */\r\n.most-course {\r\n  width: 100%;\r\n  background-color: #f8f9fa;\r\n  padding: 50px 0;\r\n}\r\n\r\n.course-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  margin-top: 30px;\r\n}\r\n\r\n.course-item {\r\n  width: 23%;\r\n  background: white;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  margin-bottom: 25px;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n}\r\n\r\n.course-item:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 8px 25px rgba(0,0,0,0.15);\r\n}\r\n\r\n.course-image {\r\n  width: 100%;\r\n  height: 160px;\r\n  overflow: hidden;\r\n}\r\n\r\n.course-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.course-info {\r\n  padding: 15px;\r\n}\r\n\r\n.course-title {\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  margin-bottom: 8px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.course-desc {\r\n  font-size: 13px;\r\n  color: #666;\r\n  margin-bottom: 12px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n}\r\n\r\n.course-stats {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.stat-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.stat-item i {\r\n  font-size: 12px;\r\n}\r\n\r\n.hot-score {\r\n  color: #FF5202;\r\n}\r\n\r\n.task-btns {\r\n  text-align: center;\r\n  margin-top: 30px;\r\n}\r\n\r\n/* 响应式调整 */\r\n@media (max-width: 1200px) {\r\n  .course-item {\r\n    width: 31%;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .course-item {\r\n    width: 48%;\r\n  }\r\n}\r\n</style>"],"mappings":";AA0HA,SAAAA,eAAA,EAAAC,mBAAA,EAAAC,aAAA;AACA,OAAAC,UAAA;AACA,OAAAC,UAAA;AACA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,KAAA;MACAF,IAAA;QACAG,KAAA;QACAC,MAAA;QACAC,MAAA;QACAC,KAAA;MACA;MACAC,UAAA;IACA;EACA;;EACAC,UAAA;IACAV,UAAA;IACAC;EACA;EACAU,OAAA;IACAC,WAAA;MACA,SAAAT,SAAA;QACA,KAAAU,OAAA,CAAAC,IAAA,sBAAAX,SAAA;MACA;IACA;IACAY,UAAAX,KAAA;MACA,KAAAS,OAAA,CAAAC,IAAA,kBAAAV,KAAA;IACA;IACAY,OAAA;MACA,KAAAH,OAAA,CAAAC,IAAA;IACA;IACAG,UAAA;MACA,KAAAJ,OAAA,CAAAC,IAAA;IACA;IACAI,eAAAC,QAAA;MACA,KAAAN,OAAA,CAAAC,IAAA,mBAAAK,QAAA;IACA;IACAtB,gBAAA;MACAA,eAAA,GAAAuB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,IAAAlB,KAAA,GAAAiB,GAAA,CAAAnB,IAAA;UACA,KAAAE,KAAA,GAAAA,KAAA,CAAAmB,MAAA;QACA;UACA,KAAAC,OAAA,CAAAC,KAAA;YACAC,KAAA;YACAC,OAAA,EAAAN,GAAA,CAAAM;UACA;QACA;MACA;IACA;IACA7B,oBAAA;MACAA,mBAAA,GAAAsB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAApB,IAAA,GAAAmB,GAAA,CAAAnB,IAAA;QACA;UACA,KAAAsB,OAAA,CAAAC,KAAA;YACAC,KAAA;YACAC,OAAA,EAAAN,GAAA,CAAAM;UACA;QACA;MACA;IACA;IACA;IACA5B,cAAA;MACAA,aAAA,GAAAqB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAb,UAAA,GAAAY,GAAA,CAAAnB,IAAA;QACA;UACA,KAAAsB,OAAA,CAAAC,KAAA;YACAC,KAAA;YACAC,OAAA,EAAAN,GAAA,CAAAM;UACA;QACA;MACA;IACA;EACA;EACAC,QAAA,GAEA;EACAC,QAAA;IACA,KAAAhC,eAAA;IACA,KAAAC,mBAAA;IACA,KAAAC,aAAA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}